# Release compose environment.
# Copy to docker/.env and replace every value marked CHANGE ME before the first start.
#   cp docker/.env.example docker/.env
#   docker compose -f docker/compose.release.yaml --env-file docker/.env up -d --build
#
# Values in this file are placeholders. Do not commit docker/.env.

# --- Image -------------------------------------------------------------------
# Tag the image with the release you are deploying so a rollback target is nameable.
TUESDAY_TAG=0.9.0

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_DB=tuesday
POSTGRES_USER=tuesday
# CHANGE ME: generate with  openssl rand -base64 32
POSTGRES_PASSWORD=

# --- OpenIddict client secret ------------------------------------------------
# Matches the seeded "tuesday-cli" client. CHANGE ME in production.
IDENTITY_CLIENT_SECRET=

# --- OpenIddict signing certificate ------------------------------------------
# See docs/runbooks/signing-certificate.md for generating this PFX.
IDENTITY_SIGNING_PFX=./keys/idp.pfx
IDENTITY_SIGNING_PASSWORD=

# --- Email (optional) --------------------------------------------------------
EMAIL_ENABLED=false
EMAIL_HOST=
EMAIL_FROM=no-reply@tuesday.local

# First admin for an empty Production database. Ignored once a tenant exists.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=
