@using Tuesday.Application.Boards
@using Tuesday.Infrastructure.Boards
@using Tuesday.Infrastructure.Queries
@using Tuesday.Web.Security
@inject BoardQueries Queries
@inject ItemEditor Editor
@inject TenantContextBootstrapper Bootstrapper
@inject ToastService Toasts

@*
    Sub-items live in their own interactive island because the item page itself is static
    SSR: a button with @onclick there would render and then do nothing.
*@

<section class="ui-card mt-4 overflow-hidden" aria-labelledby="subitems-title">
    <header class="ui-card-head">
        <h2 id="subitems-title" class="ui-card-title">Sub-items</h2>
        <span class="ui-pill ui-pill-neutral">@(_parent?.SubItems.Count ?? 0)</span>
    </header>

    @if (_error is not null)
    {
        <div class="border-b border-line px-4 py-3"><Alert Kind="AlertKind.Error">@_error</Alert></div>
    }

    @if (!_loaded)
    {
        <div class="px-4 py-4"><Skeleton Lines="2" /></div>
    }
    else if (_parent is { SubItems.Count: > 0 })
    {
        <ul class="m-0 list-none divide-y divide-line p-0">
            @foreach (var sub in _parent.SubItems)
            {
                <li class="relative flex items-center gap-3 px-4 py-2.5 transition hover:bg-surface-2">
                    <Icon Name="IconName.Subitem" Class="h-4 w-4 shrink-0 text-ink-soft" />
                    <a class="min-w-0 flex-1 truncate text-sm font-medium text-ink no-underline after:absolute after:inset-0 hover:text-brand-ink hover:underline"
                       href="@($"/board/{BoardId}/item/{sub.Id}")">@sub.Name</a>
                    <Icon Name="IconName.ChevronRight" Class="h-4 w-4 shrink-0 text-ink-soft" />
                </li>
            }
        </ul>
    }
    else
    {
        <p class="m-0 px-4 py-4 text-sm text-ink-soft">No sub-items yet. Break this item into smaller steps below.</p>
    }

    @if (CanEdit && _parent is not null)
    {
        <form class="border-t border-line bg-surface-2/60 px-4 py-3" @onsubmit="AddAsync" @onsubmit:preventDefault>
            <Field Label="Add a sub-item" For="@_inputId" Hint="Sub-items inherit this item's group and can be reordered in the grid.">
                <div class="flex gap-2">
                    <input id="@_inputId" type="text" @bind="_name" @bind:event="oninput" placeholder="Sub-item name"
                           aria-describedby="@Field.DescribedBy(_inputId)" class="ui-input" maxlength="500" />
                    <Button Type="submit" IconStart="IconName.Plus" Busy="_busy" Disabled="@string.IsNullOrWhiteSpace(_name)">Add</Button>
                </div>
            </Field>
        </form>
    }
</section>

@code {
    [Parameter, EditorRequired]
    public Guid BoardId { get; set; }

    [Parameter, EditorRequired]
    public Guid ItemId { get; set; }

    [Parameter]
    public bool CanEdit { get; set; }

    private readonly string _inputId = "subitem-" + Guid.NewGuid().ToString("n")[..8];
    private ItemView? _parent;
    private bool _loaded;
    private string _name = string.Empty;
    private string? _error;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        await Bootstrapper.EnsureResolvedAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var board = await Queries.GetAsync(BoardId);
        _parent = board?.Items.FirstOrDefault(item => item.Id == ItemId);
        _loaded = true;
    }

    private async Task AddAsync()
    {
        if (_parent is null || _busy || string.IsNullOrWhiteSpace(_name))
        {
            return;
        }

        _busy = true;

        try
        {
            var name = _name.Trim();
            var result = await Editor.AddAsync(BoardId, _parent.GroupId, name, _parent.Id);

            if (!result.Succeeded)
            {
                _error = result.Error;
                return;
            }

            _error = null;
            _name = string.Empty;
            await LoadAsync();
            Toasts.Success($"Sub-item \"{name}\" added.");
        }
        finally
        {
            _busy = false;
        }
    }
}
