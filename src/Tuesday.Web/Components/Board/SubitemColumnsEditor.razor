@using Tuesday.Application.Boards
@using Tuesday.Domain.Boards
@using Tuesday.Infrastructure.Boards
@using Tuesday.Web.Security
@inject SubitemColumnService Columns
@inject ItemEditor Editor
@inject TenantContextBootstrapper Bootstrapper
@inject ToastService Toasts

@*
    Standalone editor for the sub-item surface's columns. The parent board's columns are not
    touched here: they are independent rows, which is what "the copy does not sync" means.
*@

<div class="ui-card overflow-hidden">
    <header class="ui-card-head">
        <div class="min-w-0 flex-1">
            <h2 class="ui-card-title">Existing columns</h2>
            <p class="m-0 mt-0.5 text-xs text-ink-soft">
                These belong to sub-items only. Renaming or deleting one never changes this board's own columns.
            </p>
        </div>
        <span class="ui-pill ui-pill-neutral">@_columns.Count</span>
    </header>

    @if (_error is not null)
    {
        <div class="border-b border-line px-4 py-3"><Alert Kind="AlertKind.Error">@_error</Alert></div>
    }

    @if (!_loaded)
    {
        <div class="px-4 py-4"><Skeleton Lines="3" /></div>
    }
    else if (_columns.Count == 0)
    {
        <EmptyState Title="No sub-item columns yet" IconName="IconName.Subitem" Bare="true" Compact="true">
            <ChildContent>Add one below, or start from a copy of this board's columns.</ChildContent>
            <Actions>
                @if (CanEdit)
                {
                    <Button Variant="ButtonVariant.Ghost" Busy="_busy" @onclick="CopyAsync">Copy columns from this board</Button>
                }
            </Actions>
        </EmptyState>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full border-collapse text-sm">
                <thead>
                    <tr class="border-b border-line bg-surface-2 text-xs text-ink-soft">
                        <th class="px-4 py-2 text-left font-medium" scope="col">Title</th>
                        <th class="w-40 px-2 py-2 text-left font-medium" scope="col">Type</th>
                        <th class="w-28 px-2 py-2 text-right font-medium" scope="col">Order</th>
                        <th class="w-48 px-4 py-2 text-right font-medium" scope="col"><span class="sr-only">Remove</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var (column, index) in _columns.Select((c, i) => (c, i)))
                    {
                        <tr class="border-b border-line last:border-0">
                            <td class="px-4 py-1.5">
                                <input class="ui-input ui-input-sm max-w-sm border-transparent bg-transparent hover:border-line-strong"
                                       aria-label="@($"Column title: {column.Title}")"
                                       value="@column.Title"
                                       disabled="@(!CanEdit)"
                                       @onchange="e => RenameAsync(column.Id, e.Value?.ToString())" />
                            </td>
                            <td class="px-2 py-1.5 text-xs text-ink-soft">
                                <span class="inline-flex items-center gap-1.5"><Icon Name="@ColumnIcons.For(column.Type)" Class="h-3.5 w-3.5" />@TypeLabel(column.Type)</span>
                            </td>
                            <td class="px-2 py-1.5 text-right">
                                @if (CanEdit)
                                {
                                    <span class="inline-flex">
                                        <Button Variant="ButtonVariant.Quiet" Size="ButtonSize.Sm" IconOnly="true"
                                                aria-label="@($"Move {column.Title} up")"
                                                Disabled="@(index == 0 || _busy)"
                                                @onclick="() => MoveAsync(column.Id, -1)"><Icon Name="IconName.ArrowUp" Class="h-3.5 w-3.5" /></Button>
                                        <Button Variant="ButtonVariant.Quiet" Size="ButtonSize.Sm" IconOnly="true"
                                                aria-label="@($"Move {column.Title} down")"
                                                Disabled="@(index == _columns.Count - 1 || _busy)"
                                                @onclick="() => MoveAsync(column.Id, 1)"><Icon Name="IconName.ArrowDown" Class="h-3.5 w-3.5" /></Button>
                                    </span>
                                }
                            </td>
                            <td class="px-4 py-1.5 text-right">
                                @if (CanEdit)
                                {
                                    if (_confirming == column.Id)
                                    {
                                        <span class="inline-flex items-center gap-1" role="group" aria-label="@($"Confirm removing {column.Title}")">
                                            <Button Variant="ButtonVariant.Danger" Size="ButtonSize.Sm" Busy="_busy"
                                                    @onclick="() => DeleteAsync(column.Id)">Delete values too</Button>
                                            <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                                                    @onclick="() => _confirming = null">Cancel</Button>
                                        </span>
                                    }
                                    else
                                    {
                                        <Button Variant="ButtonVariant.QuietDanger" Size="ButtonSize.Sm" IconStart="IconName.Trash"
                                                aria-label="@($"Remove column {column.Title}")"
                                                @onclick="() => _confirming = column.Id">Remove</Button>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (CanEdit)
    {
        <form class="flex flex-wrap items-end gap-3 border-t border-line bg-surface-2/60 px-4 py-3" @onsubmit="AddAsync" @onsubmit:preventDefault>
            <Field Label="New column" Class="w-full sm:w-64">
                <input type="text" class="ui-input"
                       placeholder="Column title"
                       @bind="_newTitle" @bind:event="oninput" />
            </Field>

            <Field Label="Type" Class="w-full sm:w-44">
                <select class="ui-select"
                        @onchange="e => _newType = ParseType(e.Value?.ToString())">
                    @foreach (var type in Types)
                    {
                        <option value="@type.ToString()" selected="@(_newType == type)">@TypeLabel(type)</option>
                    }
                </select>
            </Field>

            <Button Type="submit" IconStart="IconName.Plus" Busy="_adding" Disabled="@(_busy || string.IsNullOrWhiteSpace(_newTitle))">Add column</Button>

            <Button Variant="ButtonVariant.Ghost" Class="sm:ml-auto"
                    Disabled="@(_busy || _columns.Count == 0)"
                    @onclick="CopyAsync">Copy any missing columns from this board</Button>
        </form>
    }
</div>

@code {
    private static readonly ColumnType[] Types =
    [
        ColumnType.Text,
        ColumnType.LongText,
        ColumnType.Number,
        ColumnType.Status,
        ColumnType.Date,
        ColumnType.Checkbox,
        ColumnType.People,
        ColumnType.Dropdown
    ];

    [Parameter, EditorRequired]
    public Guid BoardId { get; set; }

    [Parameter]
    public bool CanEdit { get; set; }

    private readonly List<ColumnView> _columns = [];
    private string _newTitle = string.Empty;
    private ColumnType _newType = ColumnType.Text;
    private Guid? _confirming;
    private string? _error;
    private bool _busy;
    private bool _adding;
    private bool _loaded;

    protected override async Task OnInitializedAsync()
    {
        await Bootstrapper.EnsureResolvedAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var columns = await Columns.ListAsync(BoardId);

        _columns.Clear();
        _columns.AddRange(columns);
        _loaded = true;
    }

    private async Task AddAsync()
    {
        if (_busy || string.IsNullOrWhiteSpace(_newTitle))
        {
            return;
        }

        _busy = true;
        _adding = true;

        try
        {
            var title = _newTitle.Trim();
            var result = await Columns.AddAsync(BoardId, title, _newType);

            if (!result.Succeeded)
            {
                _error = result.Error;
                return;
            }

            _error = null;
            // Bound to the input, so clearing it here empties the box for the next column.
            _newTitle = string.Empty;
            await LoadAsync();
            Toasts.Success($"Column \"{title}\" added.");
        }
        finally
        {
            _busy = false;
            _adding = false;
        }
    }

    private async Task RenameAsync(Guid columnId, string? title)
    {
        if (string.IsNullOrWhiteSpace(title))
        {
            await LoadAsync();
            return;
        }

        var result = await Columns.RenameAsync(columnId, title);

        _error = result.Succeeded ? null : result.Error;
        await LoadAsync();
    }

    private async Task DeleteAsync(Guid columnId)
    {
        _busy = true;

        try
        {
            var result = await Columns.DeleteAsync(columnId);

            _error = result.Succeeded ? null : result.Error;
            _confirming = null;
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task MoveAsync(Guid columnId, int delta)
    {
        _busy = true;

        try
        {
            var result = await Columns.MoveAsync(columnId, delta);

            _error = result.Succeeded ? null : result.Error;
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CopyAsync()
    {
        _busy = true;

        try
        {
            var result = await Editor.CopyParentColumnsAsync(BoardId);

            _error = result.Succeeded ? null : result.Error;
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private static ColumnType ParseType(string? value) =>
        Enum.TryParse<ColumnType>(value, ignoreCase: true, out var parsed) ? parsed : ColumnType.Text;

    private static string TypeLabel(ColumnType type) => type switch
    {
        ColumnType.LongText => "Long text",
        ColumnType.Status => "Status",
        ColumnType.Date => "Date",
        ColumnType.Checkbox => "Checkbox",
        ColumnType.People => "People",
        ColumnType.Dropdown => "Dropdown",
        ColumnType.Number => "Number",
        _ => "Text"
    };
}
