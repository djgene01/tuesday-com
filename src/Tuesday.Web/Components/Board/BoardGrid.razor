@using Tuesday.Application.Boards
@using Tuesday.Application.Views
@using Tuesday.Domain.Boards
@using Tuesday.Infrastructure.Queries
@using Tuesday.Infrastructure.Values
@using Tuesday.Web.Security
@implements IAsyncDisposable
@inject BoardQueries Queries
@inject ColumnValueWriter Writer
@using Tuesday.Domain.Automation
@inject Tuesday.Infrastructure.Automations.AutomationService Automations
@inject TenantContextBootstrapper Bootstrapper
@inject Tuesday.Infrastructure.Boards.ItemEditor Editor
@inject IJSRuntime JS
@inject ToastService Toasts

@*
    The table view. One table for the whole board: a single scroll area, a sticky header row
    and a sticky item column, 36px rows with hairline rules, group bands tinted with the
    group's own colour, and typed editors where the column type has a strict format (a status
    picker from the column's labels, a date picker, a checkbox, a right-aligned number).
    Row virtualisation is unchanged — the flattened group/item list is what Virtualize walks.
*@

<div class="ui-card overflow-hidden">

    <div class="flex min-h-10 flex-wrap items-center gap-x-3 gap-y-1 border-b border-line px-3 py-1.5">
        <p class="m-0 text-xs text-ink-soft">
            @if (_board is null)
            {
                <span class="inline-flex items-center gap-2"><Spinner Class="h-3 w-3" />Loading board…</span>
            }
            else
            {
                <text>@_board.ItemCount items · @_board.Columns.Count columns</text>
                @if (_rows.Count < _totalRows)
                {
                    <span>· @_rows.Count of @_totalRows rows shown</span>
                }
            }
        </p>

        @if (CanEdit && _board is { ItemCount: > 0 })
        {
            <p class="m-0 hidden text-xs text-ink-soft lg:block">Enter saves · Esc undoes · Alt+↑/↓ moves a row</p>
        }

        @if (_error is not null)
        {
            <p class="m-0 ml-auto inline-flex items-center gap-1.5 text-xs font-medium text-bad" role="alert">
                <Icon Name="IconName.Alert" Class="h-3.5 w-3.5" />@_error
            </p>
        }
        else if (_savedAt is not null)
        {
            <p class="m-0 ml-auto inline-flex items-center gap-1 text-xs text-ok" role="status">
                <Icon Name="IconName.Check" Class="h-3.5 w-3.5" />Saved @_savedAt.Value.ToLocalTime().ToString("HH:mm:ss")
            </p>
        }
    </div>

    @if (_board is null)
    {
        <div class="p-4"><Skeleton Lines="6" Height="h-6" /></div>
    }
    else if (_board.ItemCount == 0)
    {
        @* An empty board should say what to do next, not show a header with no rows under it. *@
        <EmptyState Title="No items yet" IconName="IconName.List" Bare="true">
            @if (_board.Columns.Count == 0)
            {
                <text>This board has no columns. Add columns first, then items can be filled in.</text>
            }
            else if (CanEdit && _board.Groups.Count > 0)
            {
                <text>Add the first item below. It lands in “@_board.Groups[0].Title”, and you can drag it anywhere later.</text>
            }
            else
            {
                <text>This board has @_board.Columns.Count column@(_board.Columns.Count == 1 ? "" : "s") but no items.</text>
            }
        </EmptyState>

        @if (CanEdit && _board.Groups.Count > 0)
        {
            var first = _board.Groups[0];
            <div class="flex items-center gap-2 border-t border-line px-3 py-2">
                <Icon Name="IconName.Plus" Class="h-4 w-4 shrink-0 text-ink-soft" />
                <input aria-label="@($"Add item to {first.Title}")"
                       class="h-8 w-full rounded-control border border-transparent bg-transparent px-2 text-sm text-ink placeholder:text-ink-soft hover:border-line focus-visible:border-brand focus-visible:bg-surface focus-visible:outline-none"
                       placeholder="Add item"
                       @bind="Draft(first.Id).Name"
                       @bind:event="oninput"
                       @onkeydown="e => AddItemKeyAsync(e, first.Id)" />
                @if (_addingTo == first.Id)
                {
                    <Spinner Label="Adding…" Class="h-3.5 w-3.5" />
                }
            </div>
        }
    }
    else
    {
        var board = _board;
        var span = board.Columns.Count + 1;

        @* One table for the whole board: a single scroll area, one sticky header, and column
           widths that agree across groups. Group titles are rows of that same table, which is
           what makes a virtualised list possible without per-group scroll boxes. *@
        <div class="h-[min(72vh,780px)] overflow-auto overscroll-contain" @ref="_scroller">
            <table class="w-full border-separate border-spacing-0 text-sm">
                <caption class="sr-only">@board.Name items by group</caption>
                <thead>
                    <tr class="text-xs font-medium text-ink-soft">
                        <th class="sticky left-0 top-0 z-30 min-w-[240px] border-b border-r border-line bg-surface-2 py-2 pl-10 pr-2 text-left font-medium shadow-[4px_0_6px_-4px_rgb(41_37_36/0.14)] md:min-w-[280px]" scope="col">Item</th>
                        @foreach (var column in board.Columns)
                        {
                            <th class="sticky top-0 z-20 min-w-[130px] whitespace-nowrap border-b border-r border-line bg-surface-2 px-2 py-2 text-left font-medium last:border-r-0" scope="col">
                                <span class="flex items-center gap-1.5">
                                    <Icon Name="@ColumnIcons.For(column.Type)" Class="h-3.5 w-3.5 shrink-0 text-ink-soft" />
                                    <span class="truncate">@column.Title</span>
                                </span>
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    <Virtualize Items="_rows" Context="row" SpacerElement="tr" OverscanCount="8">
                        @if (row.Group is not null)
                        {
                            <tr @key="RowKey(row)" style="--group: @StatusPalette.GroupFill(row.Group.Colour)"
                                @ondragover:preventDefault
                                @ondrop="() => DropOnGroupAsync(row.Group.Id)">
                                <td colspan="@span" class="border-b border-line p-0" style="background: @StatusPalette.GroupTint(row.Group.Colour)">
                                    <div class="ui-group-head sticky left-0 w-max max-w-[100vw] py-2">
                                        <span class="h-4 w-1 shrink-0 rounded-full" style="background: var(--group)" aria-hidden="true"></span>
                                        <h2 class="m-0 font-display text-sm font-semibold tracking-normal text-ink" style="color: color-mix(in srgb, var(--group) 45%, var(--color-ink))">@row.Group.Title</h2>
                                        <span class="ui-pill bg-surface/80 text-ink-soft ring-1 ring-inset ring-line">@row.Group.Items.Count</span>
                                    </div>
                                </td>
                            </tr>
                        }
                        else if (row.Item is not null)
                        {
                            var item = row.Item;
                            var expanded = _expanded.Contains(item.Id);
                            <tr @key="RowKey(row)"
                                class="@($"group {(_dragging == item.Id ? "opacity-50" : null)} {(_dropKey == row.Key ? "[&>td]:shadow-[inset_0_2px_0_0_var(--color-brand)]" : null)}")"
                                draggable="@(CanEdit ? "true" : "false")"
                                @ondragstart="() => StartDrag(item.Id)"
                                @ondragend="() => EndDrag()"
                                @ondragover:preventDefault
                                @ondragenter="() => _dropKey = row.Key"
                                @ondrop="() => DropOnItemAsync(row)">
                                <td class="sticky left-0 z-10 h-9 border-b border-r border-line bg-surface p-0 align-middle shadow-[4px_0_6px_-4px_rgb(41_37_36/0.14)] group-hover:bg-surface-2">
                                    <div class="flex h-9 items-center gap-0.5 pl-1.5 pr-1">
                                        <button type="button"
                                                class="grid h-7 w-7 shrink-0 cursor-pointer place-items-center rounded-md border-0 bg-transparent text-ink-soft transition hover:bg-brand-wash hover:text-brand-ink"
                                                aria-expanded="@(expanded ? "true" : "false")"
                                                aria-label="@($"{(expanded ? "Collapse" : "Expand")} sub-items of {item.Name}")"
                                                @onclick="() => ToggleExpand(item.Id)">
                                            <Icon Name="IconName.ChevronRight" Class="@($"h-3.5 w-3.5 transition-transform {(expanded ? "rotate-90" : "")}")" />
                                        </button>
                                        <input class="h-8 min-w-0 flex-1 rounded-md border-0 bg-transparent px-1.5 text-sm font-medium text-ink focus-visible:bg-surface focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-brand disabled:cursor-default"
                                               aria-label="Item name"
                                               value="@ItemNameById(item.Id)"
                                               data-committed="@ItemNameById(item.Id)"
                                               disabled="@(!CanEdit)"
                                               @oninput="e => _pendingNames[item.Id] = e.Value?.ToString()"
                                               @onchange="_ => SaveNameAsync(item.Id)"
                                               @onkeydown="e => OnKeyAsync(e, item.Id, Guid.Empty)" />
                                        @if (item.SubItemCount > 0)
                                        {
                                            <span class="ui-pill ui-pill-neutral shrink-0" title="@($"{item.SubItemCount} sub-items")">
                                                <Icon Name="IconName.Subitem" Class="h-3 w-3" />@item.SubItemCount
                                            </span>
                                        }
                                        <a class="grid h-7 w-7 shrink-0 place-items-center rounded-md text-ink-soft no-underline opacity-0 transition hover:bg-brand-wash hover:text-brand-ink focus-visible:opacity-100 group-hover:opacity-100 pointer-coarse:opacity-100"
                                           href="@($"/board/{BoardId}/item/{item.Id}")"
                                           aria-label="@($"Open {item.Name}")"
                                           draggable="false">
                                            <Icon Name="IconName.External" Class="h-3.5 w-3.5" />
                                        </a>
                                    </div>
                                </td>
                                @foreach (var column in board.Columns)
                                {
                                    <td class="h-9 border-b border-r border-line bg-surface p-0 align-middle last:border-r-0 group-hover:bg-surface-2">
                                        @CellEditor(item.Id, item.Name, column)
                                    </td>
                                }
                            </tr>
                        }
                        else if (row.PanelFor is not null)
                        {
                            var parent = row.PanelFor;
                            <tr @key="RowKey(row)">
                                <td colspan="@span" class="border-b border-line bg-surface-2 p-0">
                                    <div class="sticky left-0 w-[min(100%,calc(100vw-3rem))] max-w-[1100px] py-3 pl-10 pr-4 md:w-[min(100%,calc(100vw-8rem))]">
                                        <div class="mb-2 flex flex-wrap items-center gap-2">
                                            <h3 class="ui-section-title m-0">Sub-items of @parent.Name</h3>
                                            <span class="ui-pill ui-pill-neutral">@parent.SubItems.Count</span>

                                            <span class="ml-auto inline-flex items-center gap-1">
                                                <Button Href="@($"/board/{BoardId}/subitems")" Variant="ButtonVariant.Quiet" Size="ButtonSize.Sm">Manage sub-item columns</Button>

                                                @if (CanEdit)
                                                {
                                                    <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Disabled="_busy" @onclick="CopySubItemColumnsAsync">
                                                        @(board.HasSubItemColumns ? "Copy missing columns" : "Copy columns from this board")
                                                    </Button>
                                                }
                                            </span>
                                        </div>

                                        @if (!board.HasSubItemColumns)
                                        {
                                            <p class="m-0 max-w-2xl text-xs leading-relaxed text-ink-soft">
                                                Sub-items can have their own columns. Copy this board's columns to start them off —
                                                the copy is one-way, so later changes to either side stay independent.
                                            </p>
                                        }
                                        else
                                        {
                                            <div class="overflow-x-auto rounded-control border border-line bg-surface">
                                                <table class="w-full border-collapse text-sm">
                                                    <thead>
                                                        <tr class="bg-surface-2 text-xs text-ink-soft">
                                                            <th class="w-[28%] min-w-[180px] border-b border-line px-2 py-1.5 text-left font-medium">Sub-item</th>
                                                            @foreach (var column in board.SubItemColumns)
                                                            {
                                                                <th class="min-w-[120px] border-b border-l border-line px-2 py-1.5 text-left font-medium">
                                                                    <span class="flex items-center gap-1.5">
                                                                        <Icon Name="@ColumnIcons.For(column.Type)" Class="h-3.5 w-3.5 shrink-0" />@column.Title
                                                                    </span>
                                                                </th>
                                                            }
                                                            <th class="w-16 border-b border-l border-line py-1.5 text-right font-medium"><span class="sr-only">Order</span></th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @if (parent.SubItems.Count == 0)
                                                        {
                                                            <tr><td class="px-2 py-2.5 text-ink-soft" colspan="@(board.SubItemColumns.Count + 2)">No sub-items yet.</td></tr>
                                                        }

                                                        @for (var index = 0; index < parent.SubItems.Count; index++)
                                                        {
                                                            var sub = parent.SubItems[index];
                                                            var subIndex = index;
                                                            <tr class="group">
                                                                <td class="h-9 border-b border-line p-0 align-middle group-last:border-b-0">
                                                                    <input class="h-8 w-full rounded-md border-0 bg-transparent px-2 text-sm text-ink focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-brand disabled:cursor-default"
                                                                           aria-label="@($"Sub-item name: {sub.Name}")"
                                                                           value="@ItemNameById(sub.Id)"
                                                                           data-committed="@ItemNameById(sub.Id)"
                                                                           disabled="@(!CanEdit)"
                                                                           @oninput="e => _pendingNames[sub.Id] = e.Value?.ToString()"
                                                                           @onchange="_ => SaveNameAsync(sub.Id)"
                                                                           @onkeydown="e => OnKeyAsync(e, sub.Id, Guid.Empty)" />
                                                                </td>
                                                                @foreach (var column in board.SubItemColumns)
                                                                {
                                                                    <td class="h-9 border-b border-l border-line p-0 align-middle group-last:border-b-0">
                                                                        @CellEditor(sub.Id, sub.Name, column)
                                                                    </td>
                                                                }
                                                                <td class="border-b border-l border-line px-1 text-right align-middle group-last:border-b-0">
                                                                    @if (CanEdit)
                                                                    {
                                                                        <span class="inline-flex">
                                                                            <Button Variant="ButtonVariant.Quiet" Size="ButtonSize.Sm" IconOnly="true"
                                                                                    aria-label="@($"Move {sub.Name} up")" Disabled="@(subIndex == 0)"
                                                                                    @onclick="() => MoveSubItemAsync(parent, sub.Id, -1)"><Icon Name="IconName.ArrowUp" Class="h-3.5 w-3.5" /></Button>
                                                                            <Button Variant="ButtonVariant.Quiet" Size="ButtonSize.Sm" IconOnly="true"
                                                                                    aria-label="@($"Move {sub.Name} down")" Disabled="@(subIndex == parent.SubItems.Count - 1)"
                                                                                    @onclick="() => MoveSubItemAsync(parent, sub.Id, 1)"><Icon Name="IconName.ArrowDown" Class="h-3.5 w-3.5" /></Button>
                                                                        </span>
                                                                    }
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>

                                            @if (CanEdit)
                                            {
                                                <form class="mt-2 flex max-w-md items-center gap-2" @onsubmit="() => AddSubItemAsync(parent)" @onsubmit:preventDefault>
                                                    <input type="text" class="ui-input ui-input-sm"
                                                           placeholder="New sub-item name"
                                                           aria-label="@($"New sub-item of {parent.Name}")"
                                                           @bind="SubDraft(parent.Id).Name"
                                                           @bind:event="oninput" />
                                                    <Button Type="submit" Size="ButtonSize.Sm" IconStart="IconName.Plus" Busy="@(_busy && _addingSubTo == parent.Id)"
                                                            Disabled="@string.IsNullOrWhiteSpace(SubDraft(parent.Id).Name)">Add</Button>
                                                </form>
                                            }
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                        else if (row.AddTo is not null)
                        {
                            var group = row.AddTo;
                            <tr @key="RowKey(row)">
                                <td class="sticky left-0 z-10 h-9 border-b border-r border-line bg-surface p-0 shadow-[4px_0_6px_-4px_rgb(41_37_36/0.14)]">
                                    <div class="flex h-9 items-center gap-1 pl-3 pr-1">
                                        <Icon Name="IconName.Plus" Class="h-3.5 w-3.5 shrink-0 text-ink-soft" />
                                        <input aria-label="@($"Add item to {group.Title}")"
                                               class="h-8 min-w-0 flex-1 rounded-md border-0 bg-transparent px-1.5 text-sm text-ink placeholder:text-ink-soft focus-visible:bg-surface focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-brand"
                                               placeholder="Add item"
                                               @bind="Draft(group.Id).Name"
                                               @bind:event="oninput"
                                               @onkeydown="e => AddItemKeyAsync(e, group.Id)" />
                                        @if (_addingTo == group.Id)
                                        {
                                            <Spinner Class="h-3.5 w-3.5 text-ink-soft" />
                                            <span class="sr-only" role="status">Adding…</span>
                                        }
                                    </div>
                                </td>
                                @if (board.Columns.Count > 0)
                                {
                                    <td colspan="@board.Columns.Count" class="border-b border-line bg-surface"></td>
                                }
                            </tr>
                        }
                    </Virtualize>
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    [Parameter]
    public Guid BoardId { get; set; }

    [Parameter]
    public bool CanEdit { get; set; }

    private BoardModel? _board;
    // Committed values, rendered into the inputs.
    private readonly Dictionary<(Guid, Guid), string?> _cells = [];
    private readonly Dictionary<Guid, string?> _names = [];

    // In-flight text. Kept separate from _cells/_names on purpose: if @oninput fed the
    // value= attribute, every keystroke would re-render the input, reset the caret to the
    // end and drop characters while a person types.
    private readonly Dictionary<(Guid, Guid), string?> _pendingCells = [];
    private readonly Dictionary<Guid, string?> _pendingNames = [];
    private string? _error;
    private DateTimeOffset? _savedAt;
    private string? _lastFired;

    // Per-group "add item" drafts and per-parent "add sub-item" drafts. Bound with @bind so a
    // successful add clears exactly the box it came from.
    private readonly Dictionary<Guid, DraftText> _itemDrafts = [];
    private readonly Dictionary<Guid, DraftText> _subDrafts = [];
    private Guid? _addingTo;
    private Guid? _addingSubTo;

    // The flattened render list: one entry per group heading plus one per item. Virtualize
    // walks this instead of the model, so an item row and a group row can share a table.
    private List<GridRow> _rows = [];
    private int _totalRows;
    // Bumped on revert so the rows are re-created and show their committed values again.
    private int _revision;

    private ElementReference _scroller;
    private IJSObjectReference? _module;
    private bool _wired;

    protected override async Task OnInitializedAsync()
    {
        await Bootstrapper.EnsureResolvedAsync();
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_board is not { ItemCount: > 0 } || !CanEdit)
        {
            return;
        }

        if (_wired)
        {
            return;
        }

        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/grid.js");
            await _module.InvokeVoidAsync("wire", _scroller);
            _wired = true;
        }
        catch (JSException)
        {
            // Without the helper, Escape falls back to reloading the board's committed values.
            _module = null;
        }
    }

    private async Task LoadAsync()
    {
        _board = await Queries.GetAsync(BoardId);

        if (_board is null)
        {
            _rows = [];
            _totalRows = 0;
            return;
        }

        if (_board.ItemCount == 0)
        {
            // The scroll area goes away with the last item; a new one needs wiring again.
            _wired = false;
        }

        BuildRows();
    }

    /// <summary>
    /// Flattens the board into virtualised rows: group bands, item rows, for an expanded
    /// item one panel row holding its sub-items, and for an editor a trailing "add item" row
    /// per group.
    /// </summary>
    private void BuildRows()
    {
        if (_board is null)
        {
            _rows = [];
            _totalRows = 0;
            return;
        }

        var rows = new List<GridRow>(_board.ItemCount + (_board.Groups.Count * 2));

        foreach (var group in _board.Groups)
        {
            rows.Add(new GridRow($"g:{group.Id}", group, null));

            foreach (var item in group.Items)
            {
                rows.Add(new GridRow($"i:{item.Id}", null, item));
                AddCells(item);

                // Sub-items live in an expansion panel with their own column header, so the
                // panel is one virtualised row rather than one row per child.
                if (_expanded.Contains(item.Id))
                {
                    rows.Add(new GridRow($"p:{item.Id}", null, null, item));

                    foreach (var child in item.SubItems)
                    {
                        AddCells(child);
                    }
                }
            }

            if (CanEdit)
            {
                rows.Add(new GridRow($"a:{group.Id}", null, null, null, group));
            }
        }

        _rows = rows;
        _totalRows = rows.Count;

        void AddCells(ItemView item)
        {
            _names[item.Id] = item.Name;

            foreach (var column in _board.Columns.Concat(_board.SubItemColumns))
            {
                _cells[(item.Id, column.Id)] = item.Cells.TryGetValue(column.Id, out var value) ? value : null;
            }
        }
    }

    // --- typed cell editors ---------------------------------------------------------

    private const string CellBase =
        "h-9 w-full border-0 px-2 text-sm text-ink focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-brand disabled:cursor-default";

    /// <summary>
    /// The editor for one cell. A typed control is used only where its value round-trips in
    /// exactly the format the value writer accepts; anything else stays a text box.
    /// </summary>
    private RenderFragment CellEditor(Guid itemId, string itemName, ColumnView column) => __builder =>
    {
        var committed = CellText(itemId, column.Id);
        var label = $"{itemName}: {column.Title}";

        switch (column.Type)
        {
            case ColumnType.Status when ColumnSettings.Labels(column.SettingsJson) is { Count: > 0 } labels:
                {
                    var current = committed ?? string.Empty;
                    <div class="h-9 p-1">
                        <select class="@($"h-7 w-full cursor-pointer appearance-none rounded-md border-0 px-2 text-center text-xs font-medium focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-brand disabled:cursor-default {StatusPalette.StatusClasses(current)}")"
                                aria-label="@label"
                                disabled="@(!CanEdit)"
                                @onchange="e => CommitCellAsync(itemId, column.Id, e.Value?.ToString())">
                            <option value="" selected="@(current.Length == 0)">—</option>
                            @foreach (var option in labels)
                            {
                                <option value="@option" selected="@(string.Equals(option, current, StringComparison.Ordinal))">@option</option>
                            }
                            @if (current.Length > 0 && !labels.Contains(current))
                            {
                                <option value="@current" selected>@current</option>
                            }
                        </select>
                    </div>
                    break;
                }

            case ColumnType.Date when committed is null || IsIsoDate(committed):
                <input type="date"
                       class="@($"{CellBase} bg-transparent tabular-nums text-ink-soft")"
                       aria-label="@label"
                       value="@committed"
                       disabled="@(!CanEdit)"
                       @onchange="e => CommitCellAsync(itemId, column.Id, e.Value?.ToString())" />
                break;

            case ColumnType.Checkbox:
                {
                    var on = bool.TryParse(committed, out var flag) && flag;
                    <div class="grid h-9 place-items-center">
                        <input type="checkbox" class="ui-check" aria-label="@label"
                               checked="@on"
                               disabled="@(!CanEdit)"
                               @onchange="e => CommitCheckboxAsync(itemId, column.Id, e)" />
                    </div>
                    break;
                }

            default:
                {
                    // A status column without configured labels is still a free-text status:
                    // it keeps its coloured fill so the column can be skimmed.
                    var status = column.Type == ColumnType.Status;
                    var tone = status
                        ? $"h-7 rounded-md px-2 text-center text-xs font-medium {StatusPalette.StatusClasses(committed)}"
                        : $"{CellBase} bg-transparent {TextTone(column.Type)}";
                    <div class="@(status ? "h-9 p-1" : "contents")">
                        <input class="@($"{(status ? "w-full border-0 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-brand disabled:cursor-default " : "")}{tone}")"
                               aria-label="@label"
                               inputmode="@(column.Type == ColumnType.Number ? "decimal" : null)"
                               value="@committed"
                               data-committed="@committed"
                               disabled="@(!CanEdit)"
                               @oninput="e => _pendingCells[(itemId, column.Id)] = e.Value?.ToString()"
                               @onchange="_ => SaveCellAsync(itemId, column.Id)"
                               @onkeydown="e => OnKeyAsync(e, itemId, column.Id)" />
                    </div>
                    break;
                }
        }
    };

    private static string TextTone(ColumnType type) => type switch
    {
        ColumnType.Number => "text-right tabular-nums",
        ColumnType.Date => "tabular-nums text-ink-soft",
        ColumnType.People or ColumnType.Dropdown => "text-ink-soft",
        _ => string.Empty
    };

    private static bool IsIsoDate(string value) =>
        DateOnly.TryParseExact(value, "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.None, out _);

    /// <summary>A picker, checkbox or date commits the moment it changes; there is no draft.</summary>
    private async Task CommitCellAsync(Guid itemId, Guid columnId, string? value)
    {
        _pendingCells[(itemId, columnId)] = value;
        await SaveCellAsync(itemId, columnId);
    }

    /// <summary>Checkbox cells store "true"/"false", the strings the value writer parses.</summary>
    private Task CommitCheckboxAsync(Guid itemId, Guid columnId, ChangeEventArgs args) =>
        CommitCellAsync(itemId, columnId, args.Value is true ? "true" : "false");

    // --- adding ----------------------------------------------------------------------

    private sealed class DraftText
    {
        public string Name { get; set; } = string.Empty;
    }

    private DraftText Draft(Guid groupId)
    {
        if (!_itemDrafts.TryGetValue(groupId, out var draft))
        {
            draft = new DraftText();
            _itemDrafts[groupId] = draft;
        }

        return draft;
    }

    private DraftText SubDraft(Guid parentId)
    {
        if (!_subDrafts.TryGetValue(parentId, out var draft))
        {
            draft = new DraftText();
            _subDrafts[parentId] = draft;
        }

        return draft;
    }

    // --- drag and drop ---------------------------------------------------------------

    private Guid? _dragging;
    private string? _dropKey;
    private readonly HashSet<Guid> _expanded = [];

    private async Task AddItemKeyAsync(KeyboardEventArgs args, Guid groupId)
    {
        if (args.Key != "Enter")
        {
            return;
        }

        await AddItemAsync(groupId);
    }

    /// <summary>Adds an item to the group whose "add" row it was typed in.</summary>
    private async Task AddItemAsync(Guid groupId)
    {
        var draft = Draft(groupId);

        if (_addingTo is not null || string.IsNullOrWhiteSpace(draft.Name) || _board is null)
        {
            return;
        }

        _addingTo = groupId;

        try
        {
            var name = draft.Name.Trim();
            var result = await Editor.AddAsync(BoardId, groupId, name);

            if (!result.Succeeded)
            {
                _error = result.Error;
                return;
            }

            _error = null;
            draft.Name = string.Empty;
            await LoadAsync();
            Toasts.Success($"Item \"{name}\" added.");
        }
        finally
        {
            _addingTo = null;
        }
    }

    private bool _busy;

    private void ToggleExpand(Guid itemId)
    {
        if (!_expanded.Remove(itemId))
        {
            _expanded.Add(itemId);
        }

        BuildRows();
    }

    private async Task AddSubItemAsync(ItemView parent)
    {
        var draft = SubDraft(parent.Id);

        if (_busy || string.IsNullOrWhiteSpace(draft.Name))
        {
            return;
        }

        _busy = true;
        _addingSubTo = parent.Id;

        try
        {
            var result = await Editor.AddAsync(BoardId, parent.GroupId, draft.Name.Trim(), parent.Id);

            if (!result.Succeeded)
            {
                _error = result.Error;
                return;
            }

            _error = null;
            draft.Name = string.Empty;
            _expanded.Add(parent.Id);

            await RestoreAsync();
        }
        finally
        {
            _busy = false;
            _addingSubTo = null;
        }
    }

    private async Task CopySubItemColumnsAsync()
    {
        if (_busy)
        {
            return;
        }

        _busy = true;

        try
        {
            var result = await Editor.CopyParentColumnsAsync(BoardId);

            if (!result.Succeeded)
            {
                _error = result.Error;
                return;
            }

            _error = null;
            await RestoreAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task MoveSubItemAsync(ItemView parent, Guid subItemId, int delta)
    {
        var index = parent.SubItems.ToList().FindIndex(sub => sub.Id == subItemId);

        if (index < 0)
        {
            return;
        }

        await MoveAsync(subItemId, parent.GroupId, Math.Max(0, index + delta));
    }

    private void StartDrag(Guid itemId)
    {
        if (CanEdit)
        {
            _dragging = itemId;
        }
    }

    private void EndDrag()
    {
        _dragging = null;
        _dropKey = null;
    }

    /// <summary>Drops onto a row: the dragged item takes that row's place in its group.</summary>
    private async Task DropOnItemAsync(GridRow target)
    {
        if (_dragging is not { } itemId || target.Item is null || itemId == target.Item.Id)
        {
            EndDrag();
            return;
        }

        var group = _board?.Groups.FirstOrDefault(candidate => candidate.Items.Any(item => item.Id == target.Item.Id || item.SubItems.Any(sub => sub.Id == target.Item.Id)));
        if (group is null)
        {
            EndDrag();
            return;
        }

        var index = group.Items.ToList().FindIndex(item => item.Id == target.Item.Id);
        await MoveAsync(itemId, group.Id, Math.Max(0, index));
    }

    private async Task DropOnGroupAsync(Guid groupId)
    {
        if (_dragging is not { } itemId)
        {
            EndDrag();
            return;
        }

        var group = _board?.Groups.FirstOrDefault(candidate => candidate.Id == groupId);
        var count = group?.Items.Count ?? 0;

        await MoveAsync(itemId, groupId, count);
    }

    private async Task MoveAsync(Guid itemId, Guid groupId, int index)
    {
        EndDrag();

        var result = await Editor.MoveAsync(itemId, groupId, index);
        if (!result.Succeeded)
        {
            _error = result.Error;
            return;
        }

        _error = null;
        await RestoreAsync();
    }

    /// <summary>A stable key per row, plus the revert revision so a revert forces new DOM.</summary>
    private string RowKey(GridRow row) => row.Key + ":" + _revision;

    private string? CellText(Guid itemId, Guid columnId) =>
        _cells.TryGetValue((itemId, columnId), out var value) ? value : null;

    /// <summary>The text in an input right now: pending if the person has typed, else committed.</summary>
    private string? NameInput(Guid itemId) =>
        _pendingNames.TryGetValue(itemId, out var pending) ? pending : ItemNameById(itemId);

    private string? ItemNameById(Guid itemId) =>
        _names.TryGetValue(itemId, out var value) ? value : null;

    private string? CellInput(Guid itemId, Guid columnId) =>
        _pendingCells.TryGetValue((itemId, columnId), out var pending) ? pending : CellText(itemId, columnId);

    private async Task SaveNameAsync(Guid itemId)
    {
        if (!CanEdit)
        {
            return;
        }

        if (!_pendingNames.ContainsKey(itemId))
        {
            // Nothing typed since the last save (or Escape undid it): no write.
            return;
        }

        var name = NameInput(itemId);
        if (string.IsNullOrWhiteSpace(name))
        {
            _error = "An item needs a name.";
            await RestoreAsync();
            return;
        }

        var result = await Writer.RenameItemAsync(itemId, name);
        await CompleteAsync(result);

        if (result.Succeeded)
        {
            _names[itemId] = name;
            _pendingNames.Remove(itemId);
        }
    }

    private async Task SaveCellAsync(Guid itemId, Guid columnId)
    {
        if (!CanEdit)
        {
            return;
        }

        if (!_pendingCells.ContainsKey((itemId, columnId)))
        {
            // Nothing typed since the last save (or Escape undid it): no write, no automation.
            return;
        }

        var value = CellInput(itemId, columnId);
        var result = await Writer.SetAsync(itemId, columnId, value);
        await CompleteAsync(result);

        if (result.Succeeded)
        {
            _cells[(itemId, columnId)] = value;
            _pendingCells.Remove((itemId, columnId));
        }

        if (result.Succeeded && _board is not null)
        {
            // Two handlers can report the same commit (change + keydown). Only the first
            // sighting of a value runs automations, so a rule cannot fire twice for one edit.
            var fingerprint = itemId.ToString("n") + "|" + columnId.ToString("n") + "|" + value;

            if (_lastFired is null || !string.Equals(_lastFired, fingerprint, StringComparison.Ordinal))
            {
                _lastFired = fingerprint;

                // Automations run after the write is committed, so a failing rule can never
                // cost the person their edit.
                await Automations.FireAsync(BoardId, itemId, AutomationTrigger.CellChanged, columnId, value);
            }
        }
    }

    private async Task CompleteAsync(ValueWriteResult result)
    {
        if (result.Succeeded)
        {
            _error = null;
            _savedAt = DateTimeOffset.UtcNow;
            return;
        }

        _error = result.Error;
        await RestoreAsync();
    }

    private async Task RestoreAsync()
    {
        _cells.Clear();
        _names.Clear();
        _pendingCells.Clear();
        _pendingNames.Clear();
        _revision++;
        await LoadAsync();
    }

    /// <summary>
    /// Enter commits, Escape reverts the focused cell only. Tab is left to the browser so the
    /// native focus model keeps working — a custom focus model here would break screen readers.
    /// </summary>
    private async Task OnKeyAsync(KeyboardEventArgs args, Guid itemId, Guid columnId)
    {
        if (args.Key == "Escape")
        {
            if (_module is null)
            {
                // No client helper to put the text back: reload the committed values instead.
                await RestoreAsync();
                return;
            }

            // grid.js has already put the committed text back into this input; drop the draft
            // so the following blur does not save it.
            if (columnId == Guid.Empty)
            {
                _pendingNames.Remove(itemId);
            }
            else
            {
                _pendingCells.Remove((itemId, columnId));
            }

            return;
        }

        if (args.AltKey && args.Key is "ArrowUp" or "ArrowDown")
        {
            await MoveByKeyboardAsync(itemId, args.Key == "ArrowUp" ? -1 : 1);
            return;
        }

        if (args.Key != "Enter")
        {
            return;
        }

        if (columnId == Guid.Empty)
        {
            await SaveNameAsync(itemId);
        }
        else
        {
            await SaveCellAsync(itemId, columnId);
        }
    }

    /// <summary>Alt+Arrow moves the focused row one place, the keyboard equivalent of a drag.</summary>
    private async Task MoveByKeyboardAsync(Guid itemId, int delta)
    {
        if (!CanEdit || _board is null)
        {
            return;
        }

        foreach (var group in _board.Groups)
        {
            var item = group.Items.FirstOrDefault(candidate => candidate.Id == itemId);

            if (item is not null)
            {
                var target = group.Items.ToList().FindIndex(candidate => candidate.Id == itemId) + delta;
                await MoveAsync(itemId, group.Id, Math.Max(0, target));
                return;
            }

            var parent = group.Items.FirstOrDefault(candidate => candidate.SubItems.Any(sub => sub.Id == itemId));
            if (parent is not null)
            {
                var subIndex = parent.SubItems.ToList().FindIndex(candidate => candidate.Id == itemId) + delta;
                await MoveAsync(itemId, group.Id, Math.Max(0, subIndex));
                return;
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_module is not null)
            {
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone; nothing to release.
        }
    }

    /// <summary>
    /// A single row of the flattened table: a group band, an item, an item's sub-item panel or
    /// a group's "add item" row. <paramref name="Key"/> must stay stable so Virtualize can
    /// reuse a row's DOM when the visible window moves.
    /// </summary>
    private sealed record GridRow(string Key, GroupView? Group, ItemView? Item, ItemView? PanelFor = null, GroupView? AddTo = null);
}
