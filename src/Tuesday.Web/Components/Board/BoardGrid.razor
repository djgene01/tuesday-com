@using Tuesday.Application.Boards
@using Tuesday.Domain.Boards
@using Tuesday.Infrastructure.Queries
@using Tuesday.Infrastructure.Values
@using Tuesday.Web.Security
@inject BoardQueries Queries
@inject ColumnValueWriter Writer
@using Tuesday.Domain.Automation
@inject Tuesday.Infrastructure.Automations.AutomationService Automations
@inject TenantContextBootstrapper Bootstrapper
@inject Tuesday.Infrastructure.Boards.ItemEditor Editor

@*
    The grid carries the reference product's visual language: a white bordered card, a 34px row,
    faint #E6E9EF rules, group headings tinted with the group's own colour, and statuses as
    solid filled cells rather than text. Row virtualisation is unchanged — the flattened
    group/item list is what Virtualize walks.
*@

<div class="ui-card overflow-hidden">

    <div class="flex h-10 items-center gap-3 border-b border-line px-3">
        <p class="text-xs text-ink-soft">
            @if (_board is null)
            {
                <text>Loading…</text>
            }
            else
            {
                <text>@_board.ItemCount items · @_board.Columns.Count columns</text>
                @if (_rows.Count < _totalRows)
                {
                    <span class="text-ink-faint">· @_rows.Count of @_totalRows rows shown</span>
                }
            }
        </p>

        @if (_error is not null)
        {
            <p class="ml-auto text-xs font-medium text-status-stuck" role="alert">@_error</p>
        }
        else if (_savedAt is not null)
        {
            <p class="ml-auto text-xs text-ink-faint" role="status">Saved @_savedAt.Value.ToLocalTime().ToString("HH:mm:ss")</p>
        }
    </div>

    @if (_board is { ItemCount: 0 } empty)
    {
        @* An empty board should say what to do next, not show a header with no rows under it. *@
        <div class="px-6 py-14 text-center">
            <p class="font-display text-base font-semibold text-ink">No items yet</p>
            <p class="mx-auto mt-1 max-w-md text-sm text-ink-soft">
                @if (empty.Columns.Count == 0)
                {
                    <text>This board has no columns. Add columns first, then items can be filled in.</text>
                }
                else
                {
                    <text>This board has @empty.Columns.Count column@(empty.Columns.Count == 1 ? "" : "s") but no items.</text>
                }
            </p>
        </div>
    }
    else if (_board is { } board)
    {
        @* One table for the whole board: a single scroll area, one sticky header, and column
           widths that agree across groups. Group titles are rows of that same table, which is
           what makes a virtualised list possible without per-group scroll boxes. *@
        <div class="h-[min(72vh,780px)] overflow-auto">
            <table class="w-full border-collapse text-[13px]">
                <caption class="sr-only">@board.Name items by group</caption>
                <thead class="sticky top-0 z-10 bg-surface">
                    <tr class="border-b border-line text-[11px] font-medium uppercase tracking-[0.04em] text-ink-faint">
                        <th class="w-10 py-2 pl-3" scope="col"><span class="sr-only">Open</span></th>
                        <th class="min-w-[170px] py-2 text-left font-medium" scope="col">Item</th>
                        @foreach (var column in board.Columns)
                        {
                            <th class="min-w-[110px] px-2 py-2 text-left font-medium" scope="col">
                                <span class="flex items-center gap-1.5">
                                    <span class="text-ink-faint/70" aria-hidden="true">@ColumnGlyph(column.Type)</span>
                                    @column.Title
                                </span>
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    <Virtualize Items="_rows" Context="row" SpacerElement="tr" OverscanCount="8">
                        @if (row.Group is not null)
                        {
                            <tr class="group-row" @key="RowKey(row)" style="--group: @GroupHex(row.Group.Colour)"
                                @ondragover:preventDefault
                                @ondrop="() => DropOnGroupAsync(row.Group.Id)">
                                <td colspan="@(board.Columns.Count + 2)"
                                    class="border-b border-line px-3 py-2"
                                    style="background: @Tint(row.Group.Colour)">
                                    <div class="flex items-center gap-2">
                                        <span class="h-3 w-1 shrink-0 rounded-full" style="background: var(--group)" aria-hidden="true"></span>
                                        <h2 class="font-display text-[13px] font-semibold text-ink">@row.Group.Title</h2>
                                        <span class="rounded-full bg-white/70 px-1.5 py-0.5 text-[10px] font-medium text-ink-soft">@row.Group.Items.Count</span>
                                    </div>
                                </td>
                            </tr>
                        }
                        else if (row.Item is not null)
                        {
                            <tr @key="RowKey(row)"
                                class="group border-b border-line/80 last:border-0 hover:bg-canvas/70 @(_dragging == row.Item.Id ? "opacity-50" : null) @(_dropKey == row.Key ? "shadow-[inset_0_2px_0_0_var(--color-brand)]" : null)"
                                draggable="@(CanEdit ? "true" : "false")"
                                @ondragstart="() => StartDrag(row.Item.Id)"
                                @ondragend="() => EndDrag()"
                                @ondragover:preventDefault
                                @ondragenter="() => _dropKey = row.Key"
                                @ondrop="() => DropOnItemAsync(row)">
                                <td class="py-0 pl-2 align-middle">
                                    <span class="flex items-center gap-0.5">
                                        <button type="button"
                                                class="grid h-6 w-5 place-items-center rounded text-ink-faint transition hover:bg-brand-tint hover:text-brand-ink"
                                                aria-expanded="@_expanded.Contains(row.Item.Id)"
                                                aria-label="@($"{( _expanded.Contains(row.Item.Id) ? "Collapse" : "Expand")} sub-items of {row.Item.Name}")"
                                                @onclick="() => ToggleExpand(row.Item.Id)">
                                            <span class="text-[10px] @(_expanded.Contains(row.Item.Id) ? "rotate-90" : null) inline-block transition" aria-hidden="true">▸</span>
                                        </button>
                                        <a class="row-open grid h-6 w-6 place-items-center rounded text-ink-faint opacity-0 transition hover:bg-brand-tint hover:text-brand-ink focus-visible:opacity-100 group-hover:opacity-100"
                                           href="@($"/board/{BoardId}/item/{row.Item.Id}")"
                                           aria-label="@($"Open {row.Item.Name}")"><span aria-hidden="true">›</span></a>
                                    </span>
                                </td>
                                <td class="py-0 align-middle">
                                    <input class="h-[34px] w-full border-0 bg-transparent px-1 text-[13px] font-medium text-ink outline-none focus:bg-brand-tint/60 focus:ring-1 focus:ring-inset focus:ring-brand disabled:cursor-default"
                                           aria-label="Item name"
                                           value="@ItemNameById(row.Item.Id)"
                                           disabled="@(!CanEdit)"
                                           @oninput="e => _pendingNames[row.Item.Id] = e.Value?.ToString()"
                                           @onchange="_ => SaveNameAsync(row.Item.Id)"
                                           @onkeydown="e => OnKeyAsync(e, row.Item.Id, Guid.Empty)" />
                                </td>
                                @foreach (var column in board.Columns)
                                {
                                    <td class="py-0 align-middle">
                                        <input class="@CellClass(column, CellInput(row.Item.Id, column.Id))"
                                               aria-label="@($"{row.Item.Name}: {column.Title}")"
                                               value="@CellText(row.Item.Id, column.Id)"
                                               disabled="@(!CanEdit)"
                                               @oninput="e => _pendingCells[(row.Item.Id, column.Id)] = e.Value?.ToString()"
                                               @onchange="_ => SaveCellAsync(row.Item.Id, column.Id)"
                                               @onkeydown="e => OnKeyAsync(e, row.Item.Id, column.Id)" />
                                    </td>
                                }
                            </tr>
                        }
                        else if (row.PanelFor is not null)
                        {
                            <tr class="subpanel">
                                <td colspan="@(board.Columns.Count + 2)" class="border-b border-line bg-canvas/60 p-0">
                                    <div class="px-8 py-3">
                                        <div class="mb-2 flex items-center gap-2">
                                            <h3 class="font-display text-[11px] font-semibold uppercase tracking-[0.08em] text-ink-soft">Sub-items</h3>
                                            <span class="rounded-full bg-white px-1.5 py-0.5 text-[10px] font-medium text-ink-soft">@row.PanelFor.SubItems.Count</span>

                                            <span class="ml-auto inline-flex items-center gap-2">
                                                <a class="rounded-control px-2 py-1 text-[11px] font-medium text-ink-soft no-underline transition hover:text-brand"
                                                   href="@($"/board/{BoardId}/subitems")">Manage sub-item columns</a>

                                                @if (CanEdit)
                                                {
                                                    <button type="button"
                                                            class="rounded-control border border-line-strong bg-surface px-2.5 py-1 text-[11px] font-medium text-ink transition hover:border-brand hover:text-brand disabled:opacity-50"
                                                            disabled="@_busy"
                                                            @onclick="CopySubItemColumnsAsync">
                                                        @(board.HasSubItemColumns ? "Copy missing columns" : "Copy columns from this board")
                                                    </button>
                                                }
                                            </span>
                                        </div>

                                        @if (!board.HasSubItemColumns)
                                        {
                                            <p class="max-w-2xl text-[12px] leading-relaxed text-ink-soft">
                                                Sub-items can have their own columns. Copy this board's columns to start them off —
                                                the copy is one-way, so later changes to either side stay independent.
                                            </p>
                                        }
                                        else
                                        {
                                            <table class="w-full border-collapse text-[12.5px]">
                                                <thead>
                                                    <tr class="text-[10px] uppercase tracking-[0.06em] text-ink-faint">
                                                        <th class="w-[28%] py-1 pr-2 text-left font-semibold">Sub-item</th>
                                                        @foreach (var column in board.SubItemColumns)
                                                        {
                                                            <th class="py-1 pr-2 text-left font-semibold">@column.Title</th>
                                                        }
                                                        <th class="w-16 py-1 text-right font-semibold"><span class="sr-only">Order</span></th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @if (row.PanelFor.SubItems.Count == 0)
                                                    {
                                                        <tr><td class="py-2 text-ink-faint" colspan="@(board.SubItemColumns.Count + 2)">No sub-items yet.</td></tr>
                                                    }

                                                    @foreach (var sub in row.PanelFor.SubItems)
                                                    {
                                                        <tr class="border-t border-line/70">
                                                            <td class="py-0 pr-2 align-middle">
                                                                <input class="h-8 w-full rounded-control border border-transparent bg-transparent px-1 text-[12.5px] text-ink outline-none focus:border-brand focus:bg-surface"
                                                                       aria-label="@($"Sub-item name: {sub.Name}")"
                                                                       value="@ItemNameById(sub.Id)"
                                                                       disabled="@(!CanEdit)"
                                                                       @oninput="e => _pendingNames[sub.Id] = e.Value?.ToString()"
                                                                       @onchange="_ => SaveNameAsync(sub.Id)" />
                                                            </td>
                                                            @foreach (var column in board.SubItemColumns)
                                                            {
                                                                <td class="py-0 pr-2 align-middle">
                                                                    <input class="@CellClass(column, CellInput(sub.Id, column.Id))"
                                                                           aria-label="@($"{sub.Name}: {column.Title}")"
                                                                           value="@CellText(sub.Id, column.Id)"
                                                                           disabled="@(!CanEdit)"
                                                                           @oninput="e => _pendingCells[(sub.Id, column.Id)] = e.Value?.ToString()"
                                                                           @onchange="_ => SaveCellAsync(sub.Id, column.Id)" />
                                                                </td>
                                                            }
                                                            <td class="py-0 text-right align-middle">
                                                                @if (CanEdit)
                                                                {
                                                                    <span class="inline-flex">
                                                                        <button type="button" class="grid h-6 w-6 place-items-center rounded text-ink-faint hover:bg-brand-tint hover:text-brand disabled:opacity-40"
                                                                                aria-label="@($"Move {sub.Name} up")"
                                                                                @onclick="() => MoveSubItemAsync(row.PanelFor, sub.Id, -1)">↑</button>
                                                                        <button type="button" class="grid h-6 w-6 place-items-center rounded text-ink-faint hover:bg-brand-tint hover:text-brand disabled:opacity-40"
                                                                                aria-label="@($"Move {sub.Name} down")"
                                                                                @onclick="() => MoveSubItemAsync(row.PanelFor, sub.Id, 1)">↓</button>
                                                                    </span>
                                                                }
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>

                                            @if (CanEdit)
                                            {
                                                <div class="mt-2 flex items-center gap-2">
                                                    @* Committed on change, not on every keystroke: re-rendering the grid while the
                                                       user is still typing resets the caret and drops characters. *@
                                                    <input type="text" class="h-8 w-64 rounded-control border border-line-strong bg-surface px-2 text-[12.5px] text-ink outline-none focus:border-brand"
                                                           placeholder="New sub-item name"
                                                           aria-label="New sub-item name"
                                                           value="@(_addSubFor == row.PanelFor.Id ? _addSubName : string.Empty)"
                                                           @onchange="e => { _addSubFor = row.PanelFor.Id; _addSubName = e.Value?.ToString() ?? string.Empty; }" />
                                                    <button type="button" class="ui-btn-primary !h-8 !px-3 text-[12px] disabled:opacity-50"
                                                            disabled="@_busy"
                                                            @onclick="() => AddSubItemAsync(row.PanelFor)">
                                                        Add
                                                    </button>
                                                </div>
                                            }
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </Virtualize>
                </tbody>
            </table>
        </div>
    }

    @if (_board is { } addable && addable.Groups.Count > 0)
    {
        @* Without this a fresh board can never receive its first item: the empty state only
           describes the problem, and the seeded demo boards hid that. *@
        <div class="flex items-center gap-2 border-t border-line px-3 py-2">
            <span class="text-sm text-ink-faint" aria-hidden="true">+</span>
            <input aria-label="Add item"
                   class="w-full bg-transparent text-sm text-ink placeholder:text-ink-faint focus:outline-none"
                   placeholder="Add item"
                   @bind="_addItemName"
                   @bind:event="oninput"
                   @onkeydown="AddItemKeyAsync" />
            @if (_addingItem)
            {
                <span class="text-xs text-ink-faint" role="status">Adding…</span>
            }
        </div>
    }
</div>

@code {
    [Parameter]
    public Guid BoardId { get; set; }

    [Parameter]
    public bool CanEdit { get; set; }

    private BoardModel? _board;
    // Committed values, rendered into the inputs.
    private readonly Dictionary<(Guid, Guid), string?> _cells = [];
    private readonly Dictionary<Guid, string?> _names = [];

    // In-flight text. Kept separate from _cells/_names on purpose: if @oninput fed the
    // value= attribute, every keystroke would re-render the input, reset the caret to the
    // end and drop characters while a person types.
    private readonly Dictionary<(Guid, Guid), string?> _pendingCells = [];
    private readonly Dictionary<Guid, string?> _pendingNames = [];
    private string? _error;
    private DateTimeOffset? _savedAt;
    private string? _lastFired;
    private string _addItemName = string.Empty;
    private bool _addingItem;

    // The flattened render list: one entry per group heading plus one per item. Virtualize
    // walks this instead of the model, so an item row and a group row can share a table.
    private List<GridRow> _rows = [];
    private int _totalRows;
    // Bumped on revert so the rows are re-created and show their committed values again.
    private int _revision;

    protected override async Task OnInitializedAsync()
    {
        await Bootstrapper.EnsureResolvedAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _board = await Queries.GetAsync(BoardId);

        if (_board is null)
        {
            _rows = [];
            _totalRows = 0;
            return;
        }

        BuildRows();
    }

    /// <summary>
    /// Flattens the board into virtualised rows: group bands, item rows and — for an expanded
    /// item — one panel row holding its sub-items.
    /// </summary>
    private void BuildRows()
    {
        if (_board is null)
        {
            _rows = [];
            _totalRows = 0;
            return;
        }

        var rows = new List<GridRow>(_board.ItemCount + _board.Groups.Count);

        foreach (var group in _board.Groups)
        {
            rows.Add(new GridRow($"g:{group.Id}", group, null));

            foreach (var item in group.Items)
            {
                rows.Add(new GridRow($"i:{item.Id}", null, item));
                AddCells(item);

                // Sub-items live in an expansion panel with their own column header, so the
                // panel is one virtualised row rather than one row per child.
                if (_expanded.Contains(item.Id))
                {
                    rows.Add(new GridRow($"p:{item.Id}", null, null, item));

                    foreach (var child in item.SubItems)
                    {
                        AddCells(child);
                    }
                }
            }
        }

        _rows = rows;
        _totalRows = rows.Count;

        void AddCells(ItemView item)
        {
            _names[item.Id] = item.Name;

            foreach (var column in _board.Columns.Concat(_board.SubItemColumns))
            {
                _cells[(item.Id, column.Id)] = item.Cells.TryGetValue(column.Id, out var value) ? value : null;
            }
        }
    }

    // --- drag and drop ---------------------------------------------------------------

    private Guid? _dragging;
    private string? _dropKey;
    private readonly HashSet<Guid> _expanded = [];
    private async Task AddItemKeyAsync(KeyboardEventArgs args)
    {
        if (args.Key != "Enter")
        {
            return;
        }

        await AddItemAsync();
    }

    private async Task AddItemAsync()
    {
        if (_addingItem || string.IsNullOrWhiteSpace(_addItemName) || _board is not { Groups.Count: > 0 } board)
        {
            return;
        }

        _addingItem = true;

        try
        {
            var result = await Editor.AddAsync(BoardId, board.Groups[0].Id, _addItemName.Trim());

            if (!result.Succeeded)
            {
                _error = result.Error;
                return;
            }

            _addItemName = string.Empty;
            await LoadAsync();
        }
        finally
        {
            _addingItem = false;
        }
    }

    private Guid? _addSubFor;
    private string _addSubName = string.Empty;
    private bool _busy;

    private void ToggleExpand(Guid itemId)
    {
        if (!_expanded.Remove(itemId))
        {
            _expanded.Add(itemId);
        }

        BuildRows();
    }

    private async Task AddSubItemAsync(ItemView parent)
    {
        if (_busy || string.IsNullOrWhiteSpace(_addSubName))
        {
            return;
        }

        _busy = true;

        try
        {
            var result = await Editor.AddAsync(BoardId, parent.GroupId, _addSubName, parent.Id);

            if (!result.Succeeded)
            {
                _error = result.Error;
                return;
            }

            _error = null;
            _addSubName = string.Empty;
            _addSubFor = null;
            _expanded.Add(parent.Id);

            await RestoreAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CopySubItemColumnsAsync()
    {
        if (_busy)
        {
            return;
        }

        _busy = true;

        try
        {
            var result = await Editor.CopyParentColumnsAsync(BoardId);

            if (!result.Succeeded)
            {
                _error = result.Error;
                return;
            }

            _error = null;
            await RestoreAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task MoveSubItemAsync(ItemView parent, Guid subItemId, int delta)
    {
        var index = parent.SubItems.ToList().FindIndex(sub => sub.Id == subItemId);

        if (index < 0)
        {
            return;
        }

        await MoveAsync(subItemId, parent.GroupId, Math.Max(0, index + delta));
    }

    private void StartDrag(Guid itemId)
    {
        if (CanEdit)
        {
            _dragging = itemId;
        }
    }

    private void EndDrag()
    {
        _dragging = null;
        _dropKey = null;
    }

    /// <summary>Drops onto a row: the dragged item takes that row's place in its group.</summary>
    private async Task DropOnItemAsync(GridRow target)
    {
        if (_dragging is not { } itemId || target.Item is null || itemId == target.Item.Id)
        {
            EndDrag();
            return;
        }

        var group = _board?.Groups.FirstOrDefault(candidate => candidate.Items.Any(item => item.Id == target.Item.Id || item.SubItems.Any(sub => sub.Id == target.Item.Id)));
        if (group is null)
        {
            EndDrag();
            return;
        }

        var index = group.Items.ToList().FindIndex(item => item.Id == target.Item.Id);
        await MoveAsync(itemId, group.Id, Math.Max(0, index));
    }

    private async Task DropOnGroupAsync(Guid groupId)
    {
        if (_dragging is not { } itemId)
        {
            EndDrag();
            return;
        }

        var group = _board?.Groups.FirstOrDefault(candidate => candidate.Id == groupId);
        var count = group?.Items.Count ?? 0;

        await MoveAsync(itemId, groupId, count);
    }

    private async Task MoveAsync(Guid itemId, Guid groupId, int index)
    {
        EndDrag();

        var result = await Editor.MoveAsync(itemId, groupId, index);
        if (!result.Succeeded)
        {
            _error = result.Error;
            return;
        }

        _error = null;
        await RestoreAsync();
    }

    private string? ItemName(ItemView item) =>
        _names.TryGetValue(item.Id, out var value) ? value : item.Name;

    /// <summary>
    /// A cell's class follows its column type, so status, dates and numbers are visually
    /// distinguishable without reading every word. Status also takes a semantic tone.
    /// </summary>
    private static string CellClass(ColumnView column, string? value)
    {
        // No background in the base class: a status carries its own fill, and a stray
        // bg-transparent here would win the cascade and flatten every status to white.
        const string baseCell =
            "h-[34px] w-full border-0 px-2 text-[13px] outline-none focus:ring-1 focus:ring-inset focus:ring-brand disabled:cursor-default";

        return column.Type switch
        {
            ColumnType.Status => baseCell + " " + StatusClass(value),
            ColumnType.Date => baseCell + " bg-transparent tabular-nums text-ink-soft",
            ColumnType.Number => baseCell + " bg-transparent text-right tabular-nums",
            ColumnType.People => baseCell + " bg-transparent text-ink-soft",
            ColumnType.Dropdown => baseCell + " bg-transparent text-ink-soft",
            _ => baseCell + " bg-transparent"
        };
    }

    /// <summary>
    /// Statuses are solid fills, like a board's status column. Text is white on the darker
    /// fills and ink on the amber one, because white on #FDAB3D is only 1.9:1.
    /// </summary>
    private static string StatusClass(string? value) => (value ?? string.Empty).Trim().ToLowerInvariant() switch
    {
        "done" => "mx-1 rounded-sm bg-status-done text-center font-medium text-ink",
        "stuck" => "mx-1 rounded-sm bg-status-stuck text-center font-medium text-white",
        "working on it" => "mx-1 rounded-sm bg-status-working text-center font-medium text-ink",
        "not started" => "mx-1 rounded-sm bg-status-idle text-center font-medium text-ink",
        "review" => "mx-1 rounded-sm bg-status-review text-center font-medium text-white",
        _ => "mx-1 rounded-sm bg-status-info/15 text-center font-medium text-ink"
    };

    /// <summary>The group's own colour, used for the heading bar. Unknown names fall back to blue.</summary>
    private static string GroupHex(string colour) => colour switch
    {
        "amber" => "#FDAB3D",
        "teal" => "#00C875",
        "slate" => "#579BFC",
        "violet" => "#A25DDC",
        "rose" => "#E2445C",
        _ => "#579BFC"
    };

    /// <summary>A 6% wash of the group colour, so the heading reads as a band without shouting.</summary>
    private static string Tint(string colour) => Blend(GroupHex(colour), 0.06m);

    private static string Blend(string hex, decimal amount)
    {
        static int Channel(string h, int i) => Convert.ToInt32(h.Substring(1 + (i * 2), 2), 16);

        var r = (int)Math.Round(Channel(hex, 0) * amount + 255 * (1 - amount));
        var g = (int)Math.Round(Channel(hex, 1) * amount + 255 * (1 - amount));
        var b = (int)Math.Round(Channel(hex, 2) * amount + 255 * (1 - amount));

        return $"#{r:X2}{g:X2}{b:X2}";
    }

    /// <summary>A quiet type cue in the column header, the way a board shows column kinds.</summary>
    private static string ColumnGlyph(ColumnType type) => type switch
    {
        ColumnType.Status => "◉",
        ColumnType.Date => "▤",
        ColumnType.Number => "#",
        ColumnType.People => "☺",
        ColumnType.Dropdown => "▾",
        _ => "≡"
    };

    /// <summary>A stable key per row, plus the revert revision so a revert forces new DOM.</summary>
    private string RowKey(GridRow row) => row.Key + ":" + _revision;

    private string? CellText(Guid itemId, Guid columnId) =>
        _cells.TryGetValue((itemId, columnId), out var value) ? value : null;

    /// <summary>The text in an input right now: pending if the person has typed, else committed.</summary>
    private string? NameInput(Guid itemId) =>
        _pendingNames.TryGetValue(itemId, out var pending) ? pending : ItemNameById(itemId);

    private string? ItemNameById(Guid itemId) =>
        _names.TryGetValue(itemId, out var value) ? value : null;

    private string? CellInput(Guid itemId, Guid columnId) =>
        _pendingCells.TryGetValue((itemId, columnId), out var pending) ? pending : CellText(itemId, columnId);

    private async Task SaveNameAsync(Guid itemId)
    {
        if (!CanEdit)
        {
            return;
        }

        var name = NameInput(itemId);
        if (string.IsNullOrWhiteSpace(name))
        {
            _error = "An item needs a name.";
            await RestoreAsync();
            return;
        }

        var result = await Writer.RenameItemAsync(itemId, name);
        await CompleteAsync(result);

        if (result.Succeeded)
        {
            _names[itemId] = name;
            _pendingNames.Remove(itemId);
        }
    }

    private async Task SaveCellAsync(Guid itemId, Guid columnId)
    {
        if (!CanEdit)
        {
            return;
        }

        var value = CellInput(itemId, columnId);
        var result = await Writer.SetAsync(itemId, columnId, value);
        await CompleteAsync(result);

        if (result.Succeeded)
        {
            _cells[(itemId, columnId)] = value;
            _pendingCells.Remove((itemId, columnId));
        }

        if (result.Succeeded && _board is not null)
        {
            // Two handlers can report the same commit (change + keydown). Only the first
            // sighting of a value runs automations, so a rule cannot fire twice for one edit.
            var fingerprint = itemId.ToString("n") + "|" + columnId.ToString("n") + "|" + value;

            if (_lastFired is null || !string.Equals(_lastFired, fingerprint, StringComparison.Ordinal))
            {
                _lastFired = fingerprint;

                // Automations run after the write is committed, so a failing rule can never
                // cost the person their edit.
                await Automations.FireAsync(BoardId, itemId, AutomationTrigger.CellChanged, columnId, value);
            }
        }
    }

    private async Task CompleteAsync(ValueWriteResult result)
    {
        if (result.Succeeded)
        {
            _error = null;
            _savedAt = DateTimeOffset.UtcNow;
            return;
        }

        _error = result.Error;
        await RestoreAsync();
    }

    private async Task RestoreAsync()
    {
        _cells.Clear();
        _names.Clear();
        _pendingCells.Clear();
        _pendingNames.Clear();
        _revision++;
        await LoadAsync();
    }

    /// <summary>
    /// Enter commits, Escape reverts. Tab is left to the browser so the native focus
    /// model keeps working — a custom focus model here would break screen readers.
    /// </summary>
    private async Task OnKeyAsync(KeyboardEventArgs args, Guid itemId, Guid columnId)
    {
        if (args.Key == "Escape")
        {
            await RestoreAsync();
            return;
        }

        if (args.AltKey && args.Key is "ArrowUp" or "ArrowDown")
        {
            await MoveByKeyboardAsync(itemId, args.Key == "ArrowUp" ? -1 : 1);
            return;
        }

        if (args.Key != "Enter")
        {
            return;
        }

        if (columnId == Guid.Empty)
        {
            await SaveNameAsync(itemId);
        }
        else
        {
            await SaveCellAsync(itemId, columnId);
        }
    }

    /// <summary>Alt+Arrow moves the focused row one place, the keyboard equivalent of a drag.</summary>
    private async Task MoveByKeyboardAsync(Guid itemId, int delta)
    {
        if (!CanEdit || _board is null)
        {
            return;
        }

        foreach (var group in _board.Groups)
        {
            var item = group.Items.FirstOrDefault(candidate => candidate.Id == itemId);

            if (item is not null)
            {
                var target = group.Items.ToList().FindIndex(candidate => candidate.Id == itemId) + delta;
                await MoveAsync(itemId, group.Id, Math.Max(0, target));
                return;
            }

            var parent = group.Items.FirstOrDefault(candidate => candidate.SubItems.Any(sub => sub.Id == itemId));
            if (parent is not null)
            {
                var subIndex = parent.SubItems.ToList().FindIndex(candidate => candidate.Id == itemId) + delta;
                await MoveAsync(itemId, group.Id, Math.Max(0, subIndex));
                return;
            }
        }
    }

    /// <summary>
    /// A single row of the flattened table. Exactly one of <paramref name="Group"/> and
    /// <paramref name="Item"/> is set; <paramref name="Key"/> must stay stable so Virtualize
    /// can reuse a row's DOM when the visible window moves.
    /// </summary>
    private sealed record GridRow(string Key, GroupView? Group, ItemView? Item, ItemView? PanelFor = null);
}
