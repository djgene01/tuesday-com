@using Tuesday.Domain.Collaboration
@using Tuesday.Application.Collaboration
@using Tuesday.Application.Tenancy
@using Tuesday.Infrastructure.Collaboration
@using Tuesday.Web.Collaboration
@using Tuesday.Web.Security
@inject AttachmentService Files
@inject AttachmentLinks Links
@inject ITenantContext Tenant
@inject TenantContextBootstrapper Bootstrapper
@inject ToastService Toasts
@inject ILogger<AttachmentPanel> Logger

<section class="ui-card mt-4 overflow-hidden" aria-labelledby="attachments-title">
    <header class="ui-card-head">
        <h2 id="attachments-title" class="ui-card-title">Attachments</h2>
        <span class="ui-pill ui-pill-neutral">@(_rows is null ? "…" : _rows.Count.ToString(System.Globalization.CultureInfo.InvariantCulture))</span>
    </header>

    @if (CanEdit)
    {
        <div class="border-b border-line px-4 py-3">
            <label class="block">
                <span class="ui-label">Add a file <span class="font-normal text-ink-soft">(up to 25 MB)</span></span>
                <InputFile OnChange="UploadAsync" disabled="@_busy"
                           class="block w-full cursor-pointer rounded-control border border-dashed border-line-strong bg-surface-2 px-3 py-2 text-sm text-ink-soft file:mr-3 file:cursor-pointer file:rounded-control file:border-0 file:bg-brand-wash file:px-3 file:py-1 file:font-[inherit] file:text-xs file:font-medium file:text-brand-ink hover:border-brand/40" />
            </label>
            <p class="m-0 mt-1.5 flex items-center gap-2 text-xs text-ink-soft">
                @if (_busy)
                {
                    <Spinner Label="Uploading…" Class="h-3.5 w-3.5" />
                }
                else
                {
                    <text>Files are private to this item. Download links expire after one hour.</text>
                }
            </p>
        </div>
    }

    @if (_error is not null)
    {
        <div class="border-b border-line px-4 py-3">
            <Alert Kind="AlertKind.Error">@_error</Alert>
        </div>
    }

    @if (_rows is null)
    {
        <div class="px-4 py-4"><Skeleton Lines="2" /></div>
    }
    else if (_rows.Count == 0)
    {
        <EmptyState Title="No files yet" IconName="IconName.File" Bare="true" Compact="true">
            @(CanEdit ? "Attach briefs, screenshots or exports — anyone who can see this item can download them." : "Nobody has attached a file to this item.")
        </EmptyState>
    }
    else
    {
        <ul class="m-0 list-none divide-y divide-line p-0">
            @foreach (var row in _rows)
            {
                <li class="flex flex-wrap items-center gap-3 px-4 py-2.5">
                    <span class="grid h-8 w-8 shrink-0 place-items-center rounded-control bg-surface-2 text-ink-soft ring-1 ring-inset ring-line" aria-hidden="true">
                        <Icon Name="IconName.File" Class="h-4 w-4" />
                    </span>
                    <span class="min-w-0 flex-1">
                        <span class="block truncate text-sm font-medium text-ink">@row.FileName</span>
                        <span class="block text-xs text-ink-soft">@Size(row.ByteSize) · @row.CreatedAt.ToLocalTime().ToString("d MMM, HH:mm")</span>
                    </span>
                    <Button Href="@DownloadHref(row)" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" download
                            aria-label="@($"Download {row.FileName}")">Download</Button>
                </li>
            }
        </ul>
    }
</section>

@code {
    [Parameter, EditorRequired]
    public Guid BoardId { get; set; }

    [Parameter, EditorRequired]
    public Guid ItemId { get; set; }

    [Parameter]
    public bool CanEdit { get; set; }

    private IReadOnlyList<AttachmentRow>? _rows;
    private string? _error;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        await Bootstrapper.EnsureResolvedAsync();
        await LoadAsync();
    }

    private async Task LoadAsync() => _rows = await Files.ListAsync(ItemId);

    private async Task UploadAsync(InputFileChangeEventArgs change)
    {
        if (!CanEdit || Tenant.UserId is not { } userId || Tenant.TenantId is not { } tenantId || _busy)
        {
            return;
        }

        _busy = true;
        _error = null;

        try
        {
            var file = change.File;

            await using var stream = file.OpenReadStream(Attachment.MaxBytes);
            var result = await Files.SaveAsync(
                tenantId, BoardId, ItemId, userId, file.Name, file.ContentType, file.Size, stream);

            if (!result.Succeeded)
            {
                _error = result.Error;
                return;
            }

            await LoadAsync();
            Toasts.Success($"\"{file.Name}\" attached.");
        }
        catch (InvalidOperationException)
        {
            _error = "That file is larger than the 25 MB limit.";
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            // The exception text can carry paths and provider detail; the person gets a plain
            // message and the log gets the specifics.
            Logger.LogError(exception, "Attachment upload failed for item {ItemId}.", ItemId);
            _error = "The upload failed. Try again, or try a smaller file.";
        }
        finally
        {
            _busy = false;
        }
    }

    private string DownloadHref(AttachmentRow row) =>
        $"/attachments/{row.Id:D}?t={Links.Create(row.Id, BoardId, ItemId, TimeSpan.FromHours(1))}";

    private const double Kilobyte = 1024.0;
    private const double Megabyte = 1024.0 * 1024.0;

    // Written with if/else rather than relational patterns: some Razor compiler builds read
    // "< 1024" inside a switch expression as the start of a markup tag.
    private static string Size(long bytes)
    {
        if (bytes >= Megabyte)
        {
            return $"{bytes / Megabyte:0.#} MB";
        }

        return bytes >= Kilobyte ? $"{bytes / Kilobyte:0.#} KB" : $"{bytes} B";
    }
}
