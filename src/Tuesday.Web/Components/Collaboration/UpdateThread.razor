@using Microsoft.AspNetCore.Components
@using Tuesday.Application.Collaboration
@using Tuesday.Application.Tenancy
@using Tuesday.Infrastructure.Collaboration
@using Tuesday.Web.Collaboration
@using Tuesday.Web.Security
@implements IAsyncDisposable
@inject UpdateService Updates
@inject BoardBroadcaster FanOut
@inject ITenantContext Tenant
@inject TenantContextBootstrapper Bootstrapper

<section class="ui-card mt-4 overflow-hidden" aria-label="Updates">
    <header class="flex items-center gap-3 border-b border-line px-4 py-3">
        <h2 class="font-display text-[15px] font-semibold text-ink">Updates</h2>
        <p class="text-xs text-ink-faint">@CountLabel</p>
    </header>

    @if (CanEdit)
    {
        <div class="border-b border-line px-4 py-3">
            <label class="block">
                <span class="sr-only">Write an update</span>
                <textarea @bind="_draft" @bind:event="oninput" rows="3"
                          placeholder="Write an update — plain text, or simple HTML like <strong>bold</strong>"
                          aria-label="Write an update"
                          class="w-full resize-y rounded-control border border-line-strong bg-surface px-3 py-2 text-sm text-ink outline-none transition placeholder:text-ink-faint focus:border-brand focus:ring-2 focus:ring-brand/20"></textarea>
            </label>
            <div class="mt-2 flex items-center gap-3">
                <p class="text-[11px] text-ink-faint">Formatting is limited to bold, italic, lists, quotes, code and links.</p>
                <button type="button" class="ui-btn-primary ml-auto !h-8 !px-3 text-[13px] disabled:opacity-50"
                        disabled="@(string.IsNullOrWhiteSpace(_draft) || _busy)"
                        @onclick="PostAsync">
                    @(_busy ? "Posting…" : "Post update")
                </button>
            </div>
        </div>
    }

    @if (_error is not null)
    {
        <p class="border-b border-line bg-status-stuck/10 px-4 py-2 text-sm text-status-stuck" role="alert">@_error</p>
    }

    @if (_nodes is null)
    {
        <p class="px-4 py-4 text-sm text-ink-faint">Loading…</p>
    }
    else if (_nodes.Count == 0)
    {
        <p class="px-4 py-8 text-center text-sm text-ink-soft">No updates yet. The first one starts the conversation.</p>
    }
    else
    {
        <ul class="divide-y divide-line">
        @foreach (var node in _nodes)
        {
            <li class="px-4 py-3">
                <article aria-label="@($"Update from {node.AuthorName}")">
                    <header class="mb-1.5 flex items-center gap-2">
                        <span class="grid h-7 w-7 place-items-center rounded-full bg-brand-tint text-[11px] font-semibold text-brand-ink" aria-hidden="true">@Initials(node.AuthorName)</span>
                        <span class="text-[13px] font-semibold text-ink">@node.AuthorName</span>
                        <time class="text-[11px] text-ink-faint" datetime="@node.CreatedAt.ToString("O")">@Stamp(node.CreatedAt)</time>
                        @if (node.EditedAt is not null)
                        {
                            <span class="ui-pill bg-canvas text-[10px] text-ink-faint">edited</span>
                        }
                    </header>

                    @if (node.IsDeleted)
                    {
                        <p class="pl-9 text-sm italic text-ink-faint">This update was deleted.</p>
                    }
                    else
                    {
                        <div class="prose-update pl-9 text-sm text-ink">@((MarkupString)node.Html)</div>
                    }

                    <footer class="mt-1.5 flex flex-wrap items-center gap-1 pl-9">
                        <button type="button"
                                class="inline-flex items-center gap-1 rounded-full border px-2 py-0.5 text-[11px] transition @(node.LikedByMe ? "border-status-stuck/30 bg-status-stuck/10 text-status-stuck" : "border-line text-ink-soft hover:bg-canvas")"
                                aria-pressed="@(node.LikedByMe ? "true" : "false")"
                                disabled="@(!CanEdit)"
                                @onclick="() => ToggleLikeAsync(node.Id)">
                            ♥ @node.LikeCount
                        </button>

                        @if (CanEdit && !node.IsDeleted)
                        {
                            <button type="button" class="ui-btn-quiet !px-2 !py-0.5 text-[11px]" @onclick="() => ToggleReply(node.Id)">
                                @(_replyTo == node.Id ? "Cancel" : "Reply")
                            </button>
                        }

                        @if (CanEdit && !node.IsDeleted && node.AuthorId == Tenant.UserId)
                        {
                            <button type="button" class="ui-btn-quiet !px-2 !py-0.5 text-[11px]" @onclick="() => StartEdit(node)">
                                @(_editingId == node.Id ? "Cancel edit" : "Edit")
                            </button>
                        }

                        @if (CanEdit && !node.IsDeleted && (node.AuthorId == Tenant.UserId || Tenant.Role == Tuesday.Domain.Tenancy.TenantRole.Admin))
                        {
                            <button type="button" class="ui-btn-quiet !px-2 !py-0.5 text-[11px] hover:text-status-stuck" @onclick="() => DeleteAsync(node.Id)" disabled="@_busy">
                                Delete
                            </button>
                        }

                        <button type="button" class="ui-btn-quiet !px-2 !py-0.5 text-[11px]" @onclick="() => ToggleReplies(node.Id)">
                            @(IsOpen(node.Id) ? "Hide replies" : $"Replies ({node.Replies.Count})")
                        </button>
                    </footer>

                    @if (_editingId == node.Id)
                    {
                        <div class="mt-2 space-y-2 pl-9">
                            <textarea @bind="_editDraft" @bind:event="oninput" rows="3"
                                      aria-label="Edit update"
                                      class="w-full resize-y rounded-control border border-line-strong px-3 py-2 text-sm text-ink outline-none focus:border-brand focus:ring-2 focus:ring-brand/20"></textarea>
                            <button type="button" class="ui-btn-primary !h-8 !px-3 text-[13px] disabled:opacity-50"
                                    disabled="@(string.IsNullOrWhiteSpace(_editDraft) || _busy)"
                                    @onclick="() => SaveEditAsync(node.Id)">
                                Save
                            </button>
                        </div>
                    }

                    @if (_replyTo == node.Id)
                    {
                        <div class="mt-2 space-y-2 pl-9">
                            <textarea @bind="_replyDraft" @bind:event="oninput" rows="2"
                                      aria-label="@($"Reply to {node.AuthorName}")"
                                      class="w-full resize-y rounded-control border border-line-strong px-3 py-2 text-sm text-ink outline-none focus:border-brand focus:ring-2 focus:ring-brand/20"></textarea>
                            <button type="button" class="ui-btn-primary !h-8 !px-3 text-[13px] disabled:opacity-50"
                                    disabled="@(string.IsNullOrWhiteSpace(_replyDraft) || _busy)"
                                    @onclick="() => ReplyAsync(node.Id)">
                                Post reply
                            </button>
                        </div>
                    }

                    @if (IsOpen(node.Id) && node.Replies.Count > 0)
                    {
                        <ul class="mt-2 space-y-3 border-l-2 border-line pl-4 ml-9">
                            @foreach (var reply in node.Replies)
                            {
                                <li>
                                    <article aria-label="@($"Reply from {reply.AuthorName}")">
                                        <header class="mb-1 flex items-center gap-2">
                                            <span class="grid h-6 w-6 place-items-center rounded-full bg-canvas text-[10px] font-semibold text-ink-soft" aria-hidden="true">@Initials(reply.AuthorName)</span>
                                            <span class="text-[12px] font-semibold text-ink">@reply.AuthorName</span>
                                            <time class="text-[11px] text-ink-faint" datetime="@reply.CreatedAt.ToString("O")">@Stamp(reply.CreatedAt)</time>
                                        </header>
                                        <div class="prose-update text-sm text-ink">@((MarkupString)reply.Html)</div>
                                        <footer class="mt-1 flex items-center gap-1">
                                            <button type="button"
                                                    class="inline-flex items-center gap-1 rounded-full border px-2 py-0.5 text-[11px] transition @(reply.LikedByMe ? "border-status-stuck/30 bg-status-stuck/10 text-status-stuck" : "border-line text-ink-soft hover:bg-canvas")"
                                                    aria-pressed="@(reply.LikedByMe ? "true" : "false")"
                                                    disabled="@(!CanEdit)"
                                                    @onclick="() => ToggleLikeAsync(reply.Id)">
                                                ♥ @reply.LikeCount
                                            </button>
                                        </footer>
                                    </article>
                                </li>
                            }
                        </ul>
                    }
                </article>
            </li>
        }
        </ul>
    }
</section>

@code {
    [Parameter, EditorRequired]
    public Guid BoardId { get; set; }

    [Parameter, EditorRequired]
    public Guid ItemId { get; set; }

    [Parameter]
    public bool CanEdit { get; set; }

    private IReadOnlyList<UpdateNode>? _nodes;
    private readonly HashSet<Guid> _open = [];
    private string _draft = string.Empty;
    private string _replyDraft = string.Empty;
    private Guid? _replyTo;
    private Guid? _editingId;
    private string _editDraft = string.Empty;
    private string? _error;
    private bool _busy;

    private string CountLabel => _nodes is null
        ? "Loading"
        : $"{_nodes.Count} thread{(_nodes.Count == 1 ? string.Empty : "s")} · {_nodes.Sum(node => node.Replies.Count)} replies";

    protected override async Task OnInitializedAsync()
    {
        await Bootstrapper.EnsureResolvedAsync();
        await LoadAsync();
        FanOut.Published += OnPublished;
    }

    private async Task OnPublished(UpdateEvent updateEvent)
    {
        // Same board, same item, and not the echo of our own write (we reload inline).
        if (updateEvent.ItemId != ItemId || updateEvent.BoardId != BoardId)
        {
            return;
        }

        await InvokeAsync(async () =>
        {
            await LoadAsync();
            StateHasChanged();
        });
    }

    public ValueTask DisposeAsync()
    {
        FanOut.Published -= OnPublished;
        return ValueTask.CompletedTask;
    }

    private async Task LoadAsync()
    {
        _nodes = await Updates.ThreadAsync(ItemId, Tenant.UserId);
    }

    private async Task PostAsync()
    {
        if (Tenant.UserId is not { } userId)
        {
            _error = "Your session has no user identity.";
            return;
        }

        _busy = true;
        _error = null;

        try
        {
            var result = await Updates.PostAsync(BoardId, ItemId, userId, _draft);
            if (!result.Succeeded)
            {
                _error = result.Error;
                return;
            }

            _draft = string.Empty;
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ReplyAsync(Guid threadId)
    {
        if (Tenant.UserId is not { } userId)
        {
            return;
        }

        _busy = true;
        _error = null;

        try
        {
            var result = await Updates.ReplyAsync(threadId, userId, _replyDraft);
            if (!result.Succeeded)
            {
                _error = result.Error;
                return;
            }

            _replyDraft = string.Empty;
            _replyTo = null;
            _open.Add(threadId);
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ToggleLikeAsync(Guid updateId)
    {
        if (Tenant.UserId is not { } userId || !CanEdit)
        {
            return;
        }

        await Updates.ToggleLikeAsync(updateId, userId);
        await LoadAsync();
    }

    private void ToggleReply(Guid id)
    {
        _replyTo = _replyTo == id ? null : id;
        _replyDraft = string.Empty;
    }

    private void StartEdit(UpdateNode node)
    {
        if (_editingId == node.Id)
        {
            _editingId = null;
            _editDraft = string.Empty;
            return;
        }

        _editingId = node.Id;
        _editDraft = node.Text;
        _replyTo = null;
    }

    private async Task SaveEditAsync(Guid updateId)
    {
        if (Tenant.UserId is not { } userId)
        {
            return;
        }

        _busy = true;
        _error = null;

        try
        {
            // The draft is plain text from the editor, so it is wrapped as a paragraph and
            // sanitised server-side like any other write.
            var result = await Updates.EditAsync(updateId, userId, $"<p>{System.Net.WebUtility.HtmlEncode(_editDraft)}</p>");

            if (!result.Succeeded)
            {
                _error = result.Error;
                return;
            }

            _editingId = null;
            _editDraft = string.Empty;
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteAsync(Guid updateId)
    {
        if (Tenant.UserId is not { } userId)
        {
            return;
        }

        _busy = true;
        _error = null;

        try
        {
            var moderated = Tenant.Role == Tuesday.Domain.Tenancy.TenantRole.Admin;

            if (!await Updates.DeleteAsync(updateId, userId, moderated))
            {
                _error = "That update could not be deleted.";
                return;
            }

            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private void ToggleReplies(Guid id)
    {
        if (!_open.Add(id))
        {
            _open.Remove(id);
        }
    }

    private bool IsOpen(Guid id) => _open.Contains(id);

    private static string Initials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length switch
        {
            0 => "?",
            1 => parts[0][..1].ToUpperInvariant(),
            _ => (parts[0][..1] + parts[^1][..1]).ToUpperInvariant()
        };
    }

    private static string Stamp(DateTimeOffset when) =>
        when.ToLocalTime().ToString("d MMM, HH:mm");
}
