@using Microsoft.AspNetCore.Components
@using Tuesday.Application.Collaboration
@using Tuesday.Application.Tenancy
@using Tuesday.Infrastructure.Collaboration
@using Tuesday.Web.Collaboration
@using Tuesday.Web.Security
@implements IAsyncDisposable
@inject UpdateService Updates
@inject BoardBroadcaster FanOut
@inject ITenantContext Tenant
@inject TenantContextBootstrapper Bootstrapper
@inject ToastService Toasts

<section class="ui-card mt-4 overflow-hidden" aria-labelledby="updates-title">
    <header class="ui-card-head">
        <h2 id="updates-title" class="ui-card-title">Updates</h2>
        <p class="m-0 text-xs text-ink-soft">@CountLabel</p>
    </header>

    @if (CanEdit)
    {
        <form class="border-b border-line px-4 py-3" @onsubmit="PostAsync" @onsubmit:preventDefault>
            <label class="block">
                <span class="sr-only">Write an update</span>
                <textarea @bind="_draft" @bind:event="oninput" rows="3"
                          placeholder="Write an update — plain text, or simple HTML like <strong>bold</strong>"
                          aria-label="Write an update" aria-describedby="update-format-hint"
                          class="ui-textarea"></textarea>
            </label>
            <div class="mt-2 flex flex-wrap items-center gap-3">
                <p id="update-format-hint" class="m-0 text-xs text-ink-soft">Formatting is limited to bold, italic, lists, quotes, code and links.</p>
                <Button Type="submit" Class="ml-auto" Busy="_posting"
                        Disabled="@(string.IsNullOrWhiteSpace(_draft) || _busy)">Post update</Button>
            </div>
        </form>
    }

    @if (_error is not null)
    {
        <div class="border-b border-line px-4 py-3"><Alert Kind="AlertKind.Error">@_error</Alert></div>
    }

    @if (_nodes is null)
    {
        <div class="px-4 py-4"><Skeleton Lines="3" /></div>
    }
    else if (_nodes.Count == 0)
    {
        <EmptyState Title="No updates yet" IconName="IconName.Text" Bare="true" Compact="true">
            The first one starts the conversation. Mention someone with @@name to notify them.
        </EmptyState>
    }
    else
    {
        <ul class="m-0 list-none divide-y divide-line p-0">
        @foreach (var node in _nodes)
        {
            <li class="px-4 py-3.5">
                <article aria-label="@($"Update from {node.AuthorName}")">
                    <header class="mb-1.5 flex flex-wrap items-center gap-x-2 gap-y-0.5">
                        <Avatar Name="@node.AuthorName" Size="28" />
                        <span class="text-sm font-semibold text-ink">@node.AuthorName</span>
                        <time class="text-xs text-ink-soft" datetime="@node.CreatedAt.ToString("O")">@Stamp(node.CreatedAt)</time>
                        @if (node.EditedAt is not null)
                        {
                            <span class="ui-pill ui-pill-neutral">edited</span>
                        }
                    </header>

                    @if (node.IsDeleted)
                    {
                        <p class="m-0 pl-9 text-sm italic text-ink-soft">This update was deleted.</p>
                    }
                    else
                    {
                        <div class="prose-update pl-9 text-sm text-ink">@((MarkupString)node.Html)</div>
                    }

                    <footer class="mt-2 flex flex-wrap items-center gap-1 pl-9">
                        <button type="button"
                                class="@LikeClass(node.LikedByMe)"
                                aria-pressed="@(node.LikedByMe ? "true" : "false")"
                                aria-label="@($"Like, {node.LikeCount} so far")"
                                disabled="@(!CanEdit)"
                                @onclick="() => ToggleLikeAsync(node.Id)">
                            <Icon Name="IconName.Heart" Class="@(node.LikedByMe ? "h-3.5 w-3.5 fill-current" : "h-3.5 w-3.5")" />
                            <span aria-hidden="true">@node.LikeCount</span>
                        </button>

                        @if (CanEdit && !node.IsDeleted)
                        {
                            <Button Variant="ButtonVariant.Quiet" Size="ButtonSize.Sm" @onclick="() => ToggleReply(node.Id)"
                                    aria-expanded="@(_replyTo == node.Id ? "true" : "false")">
                                @(_replyTo == node.Id ? "Cancel reply" : "Reply")
                            </Button>
                        }

                        @if (CanEdit && !node.IsDeleted && node.AuthorId == Tenant.UserId)
                        {
                            <Button Variant="ButtonVariant.Quiet" Size="ButtonSize.Sm" @onclick="() => StartEdit(node)"
                                    aria-expanded="@(_editingId == node.Id ? "true" : "false")">
                                @(_editingId == node.Id ? "Cancel edit" : "Edit")
                            </Button>
                        }

                        @if (CanEdit && !node.IsDeleted && (node.AuthorId == Tenant.UserId || Tenant.Role == Tuesday.Domain.Tenancy.TenantRole.Admin))
                        {
                            <Button Variant="ButtonVariant.QuietDanger" Size="ButtonSize.Sm" @onclick="() => AskDeleteAsync(node)" Disabled="_busy">
                                Delete
                            </Button>
                        }

                        @if (node.Replies.Count > 0)
                        {
                            <Button Variant="ButtonVariant.Quiet" Size="ButtonSize.Sm" @onclick="() => ToggleReplies(node.Id)"
                                    IconEnd="@(IsOpen(node.Id) ? IconName.ChevronDown : IconName.ChevronRight)"
                                    aria-expanded="@(IsOpen(node.Id) ? "true" : "false")">
                                @(IsOpen(node.Id) ? "Hide replies" : $"{node.Replies.Count} repl{(node.Replies.Count == 1 ? "y" : "ies")}")
                            </Button>
                        }
                    </footer>

                    @if (_editingId == node.Id)
                    {
                        <form class="mt-2 space-y-2 pl-9" @onsubmit="() => SaveEditAsync(node.Id)" @onsubmit:preventDefault>
                            <textarea @bind="_editDraft" @bind:event="oninput" rows="3"
                                      aria-label="Edit update" class="ui-textarea"></textarea>
                            <Button Type="submit" Size="ButtonSize.Sm" Busy="_busy"
                                    Disabled="@string.IsNullOrWhiteSpace(_editDraft)">Save</Button>
                        </form>
                    }

                    @if (_replyTo == node.Id)
                    {
                        <form class="mt-2 space-y-2 pl-9" @onsubmit="() => ReplyAsync(node.Id)" @onsubmit:preventDefault>
                            <textarea @bind="_replyDraft" @bind:event="oninput" rows="2"
                                      aria-label="@($"Reply to {node.AuthorName}")" class="ui-textarea min-h-[3.5rem]"></textarea>
                            <Button Type="submit" Size="ButtonSize.Sm" Busy="_busy"
                                    Disabled="@string.IsNullOrWhiteSpace(_replyDraft)">Post reply</Button>
                        </form>
                    }

                    @if (IsOpen(node.Id) && node.Replies.Count > 0)
                    {
                        <ul class="m-0 ml-9 mt-3 list-none space-y-3 border-l-2 border-line p-0 pl-4">
                            @foreach (var reply in node.Replies)
                            {
                                <li>
                                    <article aria-label="@($"Reply from {reply.AuthorName}")">
                                        <header class="mb-1 flex flex-wrap items-center gap-2">
                                            <Avatar Name="@reply.AuthorName" Size="24" Muted="true" />
                                            <span class="text-xs font-semibold text-ink">@reply.AuthorName</span>
                                            <time class="text-xs text-ink-soft" datetime="@reply.CreatedAt.ToString("O")">@Stamp(reply.CreatedAt)</time>
                                        </header>
                                        <div class="prose-update text-sm text-ink">@((MarkupString)reply.Html)</div>
                                        <footer class="mt-1 flex items-center gap-1">
                                            <button type="button"
                                                    class="@LikeClass(reply.LikedByMe)"
                                                    aria-pressed="@(reply.LikedByMe ? "true" : "false")"
                                                    aria-label="@($"Like, {reply.LikeCount} so far")"
                                                    disabled="@(!CanEdit)"
                                                    @onclick="() => ToggleLikeAsync(reply.Id)">
                                                <Icon Name="IconName.Heart" Class="@(reply.LikedByMe ? "h-3.5 w-3.5 fill-current" : "h-3.5 w-3.5")" />
                                                <span aria-hidden="true">@reply.LikeCount</span>
                                            </button>
                                        </footer>
                                    </article>
                                </li>
                            }
                        </ul>
                    }
                </article>
            </li>
        }
        </ul>
    }
</section>

<ConfirmDialog @ref="_confirmDelete" Title="Delete this update?" ConfirmLabel="Delete update" OnConfirm="DeleteAsync"
               Message="The update is removed for everyone who can see this item. This cannot be undone." />

@code {
    [Parameter, EditorRequired]
    public Guid BoardId { get; set; }

    [Parameter, EditorRequired]
    public Guid ItemId { get; set; }

    [Parameter]
    public bool CanEdit { get; set; }

    private IReadOnlyList<UpdateNode>? _nodes;
    private readonly HashSet<Guid> _open = [];
    private string _draft = string.Empty;
    private string _replyDraft = string.Empty;
    private Guid? _replyTo;
    private Guid? _editingId;
    private string _editDraft = string.Empty;
    private string? _error;
    private bool _busy;
    private bool _posting;
    private ConfirmDialog? _confirmDelete;
    private Guid? _pendingDelete;

    private static string LikeClass(bool liked) =>
        "inline-flex h-7 cursor-pointer items-center gap-1 rounded-full border px-2 text-xs transition disabled:cursor-default "
        + (liked ? "border-bad/30 bg-bad-bg text-bad" : "border-line bg-surface text-ink-soft hover:bg-surface-2 hover:text-ink");

    private string CountLabel => _nodes is null
        ? "Loading"
        : $"{_nodes.Count} thread{(_nodes.Count == 1 ? string.Empty : "s")} · {_nodes.Sum(node => node.Replies.Count)} replies";

    protected override async Task OnInitializedAsync()
    {
        await Bootstrapper.EnsureResolvedAsync();
        await LoadAsync();
        FanOut.Published += OnPublished;
    }

    private async Task OnPublished(UpdateEvent updateEvent)
    {
        // Same board, same item, and not the echo of our own write (we reload inline).
        if (updateEvent.ItemId != ItemId || updateEvent.BoardId != BoardId)
        {
            return;
        }

        await InvokeAsync(async () =>
        {
            await LoadAsync();
            StateHasChanged();
        });
    }

    public ValueTask DisposeAsync()
    {
        FanOut.Published -= OnPublished;
        return ValueTask.CompletedTask;
    }

    private async Task LoadAsync()
    {
        _nodes = await Updates.ThreadAsync(ItemId, Tenant.UserId);
    }

    private async Task PostAsync()
    {
        if (Tenant.UserId is not { } userId)
        {
            _error = "Your session has no user identity.";
            return;
        }

        if (_busy || string.IsNullOrWhiteSpace(_draft))
        {
            return;
        }

        _busy = true;
        _posting = true;
        _error = null;

        try
        {
            var result = await Updates.PostAsync(BoardId, ItemId, userId, _draft);
            if (!result.Succeeded)
            {
                _error = result.Error;
                return;
            }

            _draft = string.Empty;
            await LoadAsync();
            Toasts.Success("Update posted.");
        }
        finally
        {
            _busy = false;
            _posting = false;
        }
    }

    private async Task ReplyAsync(Guid threadId)
    {
        if (Tenant.UserId is not { } userId)
        {
            return;
        }

        if (_busy || string.IsNullOrWhiteSpace(_replyDraft))
        {
            return;
        }

        _busy = true;
        _error = null;

        try
        {
            var result = await Updates.ReplyAsync(threadId, userId, _replyDraft);
            if (!result.Succeeded)
            {
                _error = result.Error;
                return;
            }

            _replyDraft = string.Empty;
            _replyTo = null;
            _open.Add(threadId);
            await LoadAsync();
            Toasts.Success("Reply posted.");
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ToggleLikeAsync(Guid updateId)
    {
        if (Tenant.UserId is not { } userId || !CanEdit)
        {
            return;
        }

        await Updates.ToggleLikeAsync(updateId, userId);
        await LoadAsync();
    }

    private void ToggleReply(Guid id)
    {
        _replyTo = _replyTo == id ? null : id;
        _replyDraft = string.Empty;
    }

    private void StartEdit(UpdateNode node)
    {
        if (_editingId == node.Id)
        {
            _editingId = null;
            _editDraft = string.Empty;
            return;
        }

        _editingId = node.Id;
        _editDraft = node.Text;
        _replyTo = null;
    }

    private async Task SaveEditAsync(Guid updateId)
    {
        if (Tenant.UserId is not { } userId)
        {
            return;
        }

        _busy = true;
        _error = null;

        try
        {
            // The draft is plain text from the editor, so it is wrapped as a paragraph and
            // sanitised server-side like any other write.
            var result = await Updates.EditAsync(updateId, userId, $"<p>{System.Net.WebUtility.HtmlEncode(_editDraft)}</p>");

            if (!result.Succeeded)
            {
                _error = result.Error;
                return;
            }

            _editingId = null;
            _editDraft = string.Empty;
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task AskDeleteAsync(UpdateNode node)
    {
        _pendingDelete = node.Id;

        if (_confirmDelete is not null)
        {
            await _confirmDelete.OpenAsync();
        }
    }

    private async Task DeleteAsync()
    {
        if (Tenant.UserId is not { } userId || _pendingDelete is not { } updateId)
        {
            return;
        }

        _busy = true;
        _error = null;

        try
        {
            var moderated = Tenant.Role == Tuesday.Domain.Tenancy.TenantRole.Admin;

            if (!await Updates.DeleteAsync(updateId, userId, moderated))
            {
                _error = "That update could not be deleted.";
                return;
            }

            await LoadAsync();
            Toasts.Success("Update deleted.");
        }
        finally
        {
            _busy = false;
            _pendingDelete = null;
        }
    }

    private void ToggleReplies(Guid id)
    {
        if (!_open.Add(id))
        {
            _open.Remove(id);
        }
    }

    private bool IsOpen(Guid id) => _open.Contains(id);

    private static string Stamp(DateTimeOffset when) =>
        when.ToLocalTime().ToString("d MMM, HH:mm");
}
