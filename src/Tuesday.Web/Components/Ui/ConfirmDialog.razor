@implements IAsyncDisposable
@inject IJSRuntime JS

@*
    A confirmation step before a destructive or irreversible action. Interactive components
    only. The native <dialog> opened with showModal() provides the focus trap, Escape and the
    inert backdrop; the module returns focus to whatever opened it.

    Usage: <ConfirmDialog @ref="_confirm" Title="..." Message="..." OnConfirm="..." />
           await _confirm.OpenAsync();
*@

<dialog @ref="_dialog" class="ui-dialog" aria-labelledby="@_titleId" aria-describedby="@_bodyId">
    <div class="flex gap-3 px-5 pb-4 pt-5">
        @if (Danger)
        {
            <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-bad-bg text-bad" aria-hidden="true">
                <Icon Name="IconName.Alert" Class="h-[18px] w-[18px]" />
            </span>
        }
        <div class="min-w-0">
            <h2 id="@_titleId" class="m-0 font-display text-md font-semibold tracking-normal text-ink">@Title</h2>
            <div id="@_bodyId" class="mt-1 text-sm text-ink-soft">
                @if (ChildContent is not null)
                {
                    @ChildContent
                }
                else
                {
                    <p class="m-0">@Message</p>
                }
            </div>
        </div>
    </div>
    <div class="flex justify-end gap-2 border-t border-line bg-surface-2 px-5 py-3">
        <Button Variant="ButtonVariant.Ghost" @onclick="CancelAsync" disabled="@_busy" autofocus>@CancelLabel</Button>
        <Button Variant="@(Danger ? ButtonVariant.Danger : ButtonVariant.Primary)" Busy="_busy" @onclick="ConfirmAsync">@ConfirmLabel</Button>
    </div>
</dialog>

@code {
    private static int _sequence;
    private readonly string _titleId;
    private readonly string _bodyId;
    private ElementReference _dialog;
    private IJSObjectReference? _module;
    private bool _busy;

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Message { get; set; }

    [Parameter]
    public string ConfirmLabel { get; set; } = "Confirm";

    [Parameter]
    public string CancelLabel { get; set; } = "Cancel";

    [Parameter]
    public bool Danger { get; set; } = true;

    [Parameter]
    public EventCallback OnConfirm { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    public ConfirmDialog()
    {
        var id = Interlocked.Increment(ref _sequence);
        _titleId = $"confirm-{id}-title";
        _bodyId = $"confirm-{id}-body";
    }

    public async Task OpenAsync()
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Ui/ConfirmDialog.razor.js");
        await _module.InvokeVoidAsync("open", _dialog);
    }

    private async Task CloseAsync()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("close", _dialog);
        }
    }

    private Task CancelAsync() => CloseAsync();

    private async Task ConfirmAsync()
    {
        _busy = true;

        try
        {
            await OnConfirm.InvokeAsync();
        }
        finally
        {
            _busy = false;
        }

        await CloseAsync();
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_module is not null)
            {
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone; nothing to release.
        }
    }
}
