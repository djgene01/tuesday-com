@*
    One stroke icon. Decorative by default (aria-hidden); pass Label to make it the accessible
    name of its own, for an icon that stands alone without visible text next to it.
    The drawings are original, built from simple primitives on a 24px grid.
*@

<svg class="@(Class ?? "h-4 w-4")" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="@StrokeWidth" stroke-linecap="round" stroke-linejoin="round"
     aria-hidden="@(Label is null ? "true" : null)" role="@(Label is null ? null : "img")"
     aria-label="@Label" focusable="false">
    @((MarkupString)Paths(Name))
</svg>

@code {
    [Parameter, EditorRequired]
    public IconName Name { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public string StrokeWidth { get; set; } = "1.75";

