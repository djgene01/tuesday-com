@*
    The top of every app page: optional breadcrumb, an eyebrow, the h1 (where Blazor puts focus
    after navigation), a one-line subtitle and the page's actions at the right edge.
*@

<header class="@($"mb-6 {Class}".TrimEnd())">
    @if (Crumbs is { Count: > 0 })
    {
        <Breadcrumbs Items="Crumbs" />
    }
    <div class="flex flex-wrap items-end gap-x-4 gap-y-3">
        <div class="min-w-0 flex-1">
            @if (Eyebrow is not null)
            {
                <p class="m-0 text-2xs font-semibold uppercase tracking-[0.1em] text-ink-soft">@Eyebrow</p>
            }
            <div class="flex flex-wrap items-center gap-2">
                <h1 class="m-0 font-display text-2xl font-semibold tracking-tight text-ink [overflow-wrap:anywhere]" tabindex="-1">@Title</h1>
                @Badges
            </div>
            @if (Subtitle is not null)
            {
                <p class="m-0 mt-1 max-w-3xl text-sm text-ink-soft">@Subtitle</p>
            }
        </div>
        @if (Actions is not null)
        {
            <div class="flex flex-wrap items-center gap-2">@Actions</div>
        }
    </div>
</header>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Eyebrow { get; set; }

    [Parameter]
    public RenderFragment? Subtitle { get; set; }

    [Parameter]
    public RenderFragment? Badges { get; set; }

    [Parameter]
    public RenderFragment? Actions { get; set; }

    [Parameter]
    public IReadOnlyList<Crumb>? Crumbs { get; set; }

    [Parameter]
    public string? Class { get; set; }
}
