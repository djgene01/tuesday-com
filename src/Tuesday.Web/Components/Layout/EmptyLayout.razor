@inherits LayoutComponentBase

@*
    A bare layout for the sign-in flow. The app shell belongs to signed-in work; showing a
    navigation rail and the signed-in identity on a login screen is confusing, and it lets a
    stale cookie paint the wrong context behind the form.
*@

@Body

<div id="blazor-error-ui" role="alert">
    <Icon Name="IconName.Alert" Class="h-4 w-4 shrink-0" />
    <span>Something went wrong and the page stopped responding.</span>
    <a href="." class="reload">Reload</a>
    <button type="button" class="dismiss" aria-label="Dismiss">
        <Icon Name="IconName.Close" Class="h-4 w-4" />
    </button>
</div>
