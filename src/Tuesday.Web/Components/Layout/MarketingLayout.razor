@inherits LayoutComponentBase

@* The public shell: a marketing header and footer, no app rail. The signed-in product keeps
   MainLayout, so a visitor never lands in a half-populated workspace chrome. *@

<div class="paper overflow-x-hidden">
    <header class="sticky top-0 z-40 border-b border-line/70 bg-canvas/80 backdrop-blur-xl">
        <div class="mx-auto flex h-16 max-w-[1180px] items-center gap-6 px-5">
            <a class="flex items-center gap-2 no-underline" href="/">
                <span class="grid h-8 w-8 place-items-center rounded-[10px] bg-ink text-[15px] font-semibold text-canvas" aria-hidden="true">T</span>
                <span class="text-[15px] font-semibold tracking-[-0.01em] text-ink">Tuesday.com</span>
            </a>

            <nav class="ml-4 hidden items-center gap-6 text-[13px] text-ink-soft md:flex" aria-label="Primary">
                <a class="no-underline hover:text-ink" href="#teams">Teams</a>
                <a class="no-underline hover:text-ink" href="#context">How it works</a>
                <a class="no-underline hover:text-ink" href="#run">Run it yourself</a>
                <a class="no-underline hover:text-ink" href="#status">Status</a>
                <a class="no-underline hover:text-ink" href="/openapi/v1.json">API</a>
            </nav>

            <div class="ml-auto flex items-center gap-2">
                <a class="hidden text-[13px] text-ink-soft no-underline hover:text-ink sm:inline" href="/login">Log in</a>
                <a class="ui-btn-primary !h-9 !py-0 px-4 text-[13px] leading-none" href="/workspace">Get started</a>
            </div>
        </div>
    </header>

    @Body

    <footer class="mt-24 border-t border-line bg-surface/60">
        <div class="mx-auto grid max-w-[1180px] gap-10 px-5 py-14 sm:grid-cols-2 lg:grid-cols-4">
            <div>
                <div class="flex items-center gap-2">
                    <span class="grid h-7 w-7 place-items-center rounded-[8px] bg-ink text-[13px] font-semibold text-canvas" aria-hidden="true">T</span>
                    <span class="text-[14px] font-semibold text-ink">Tuesday.com</span>
                </div>
                <p class="mt-3 max-w-[240px] text-[13px] leading-relaxed text-ink-soft">
                    A work operating system you can read, run and fork. MIT licensed, clean-room built.
                </p>
            </div>

            <div>
                <h2 class="text-[11px] font-semibold uppercase tracking-[0.08em] text-ink-faint">Product</h2>
                <ul class="mt-3 space-y-2 text-[13px]">
                    <li><a class="text-ink-soft no-underline hover:text-ink" href="/workspace">Boards</a></li>
                    <li><a class="text-ink-soft no-underline hover:text-ink" href="#context">Updates</a></li>
                    <li><a class="text-ink-soft no-underline hover:text-ink" href="#context">Automations</a></li>
                    <li><a class="text-ink-soft no-underline hover:text-ink" href="/account/tokens">API tokens</a></li>
                </ul>
            </div>

            <div>
                <h2 class="text-[11px] font-semibold uppercase tracking-[0.08em] text-ink-faint">Operate</h2>
                <ul class="mt-3 space-y-2 text-[13px]">
                    <li><a class="text-ink-soft no-underline hover:text-ink" href="/health/ready">Readiness probe</a></li>
                    <li><a class="text-ink-soft no-underline hover:text-ink" href="/health/live">Liveness probe</a></li>
                    <li><a class="text-ink-soft no-underline hover:text-ink" href="/openapi/v1.json">OpenAPI</a></li>
                    <li><a class="text-ink-soft no-underline hover:text-ink" href="/.well-known/openid-configuration">OpenID discovery</a></li>
                </ul>
            </div>

            <div>
                <h2 class="text-[11px] font-semibold uppercase tracking-[0.08em] text-ink-faint">Elsewhere</h2>
                <ul class="mt-3 space-y-2 text-[13px]">
                    <li><a class="text-ink-soft no-underline hover:text-ink" href="https://github.com/djgene01/tuesday-com" rel="noopener">Source on GitHub</a></li>
                    <li><a class="text-ink-soft no-underline hover:text-ink" href="https://github.com/djgene01/tuesday-com/blob/main/LICENSE" rel="noopener">MIT licence</a></li>
                    <li><a class="text-ink-soft no-underline hover:text-ink" href="https://github.com/djgene01/tuesday-com/issues" rel="noopener">Report an issue</a></li>
                </ul>
            </div>
        </div>

        <div class="mx-auto flex max-w-[1180px] flex-wrap items-center gap-3 border-t border-line px-5 py-6 text-[12px] text-ink-faint">
            <span>© @DateTime.UtcNow.Year Tuesday.com — clean-room implementation, MIT licensed.</span>
            <span class="ml-auto flex items-center gap-1.5">
                <span class="h-1.5 w-1.5 rounded-full bg-status-done" aria-hidden="true"></span>
                running on your infrastructure
            </span>
        </div>
    </footer>
</div>
