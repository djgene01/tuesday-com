@inherits LayoutComponentBase

@* The public shell: a marketing header and footer, no app rail. The signed-in product keeps
   MainLayout, so a visitor never lands in a half-populated workspace chrome. The `marketing`
   class scopes the decorative paper grain, the floating blobs and the soft 2rem curves to
   this layout only. *@

<a class="skip-link" href="#main">Skip to content</a>

<div class="marketing overflow-x-hidden">
    <header class="sticky top-0 z-40 border-b border-line/70 bg-canvas/80 backdrop-blur-xl">
        <div class="mx-auto flex h-16 max-w-[1180px] items-center gap-6 px-5">
            <a class="flex items-center gap-2 no-underline" href="/">
                <span class="grid h-8 w-8 place-items-center rounded-[10px] bg-ink text-md font-semibold text-canvas" aria-hidden="true">T</span>
                <span class="text-md font-semibold tracking-[-0.01em] text-ink">Tuesday.com</span>
            </a>

            <nav class="ml-4 hidden items-center gap-6 text-sm text-ink-soft md:flex" aria-label="Primary">
                <a class="text-ink-soft no-underline hover:text-ink" href="#teams">Teams</a>
                <a class="text-ink-soft no-underline hover:text-ink" href="#context">How it works</a>
                <a class="text-ink-soft no-underline hover:text-ink" href="#run">Run it yourself</a>
                <a class="text-ink-soft no-underline hover:text-ink" href="#status">Status</a>
            </nav>

            <div class="ml-auto flex items-center gap-2">
                <a class="hidden text-sm text-ink-soft no-underline hover:text-ink sm:inline" href="/login">Log in</a>
                <Button Href="/workspace" Size="ButtonSize.Lg" Class="rounded-pill">Get started</Button>
            </div>
        </div>
    </header>

    <main id="main" tabindex="-1" class="outline-none">
        @Body
    </main>

    <footer class="mt-24 border-t border-line bg-surface/60">
        <div class="mx-auto grid max-w-[1180px] gap-10 px-5 py-14 sm:grid-cols-2 lg:grid-cols-4">
            <div>
                <div class="flex items-center gap-2">
                    <span class="grid h-7 w-7 place-items-center rounded-[8px] bg-ink text-sm font-semibold text-canvas" aria-hidden="true">T</span>
                    <span class="text-base font-semibold text-ink">Tuesday.com</span>
                </div>
                <p class="mt-3 max-w-[240px] text-sm leading-relaxed text-ink-soft">
                    A work operating system you can read, run and fork. MIT licensed, clean-room built.
                </p>
            </div>

            <div>
                <h2 class="text-2xs font-semibold uppercase tracking-[0.08em] text-ink-soft">Product</h2>
                <ul class="mt-3 list-none space-y-2 p-0 text-sm">
                    <li><a class="text-ink-soft no-underline hover:text-ink" href="/workspace">Boards</a></li>
                    <li><a class="text-ink-soft no-underline hover:text-ink" href="#context">Updates</a></li>
                    <li><a class="text-ink-soft no-underline hover:text-ink" href="#context">Automations</a></li>
                    <li><a class="text-ink-soft no-underline hover:text-ink" href="/account/tokens">API tokens</a></li>
                </ul>
            </div>

            <div>
                <h2 class="text-2xs font-semibold uppercase tracking-[0.08em] text-ink-soft">Developers &amp; operators</h2>
                <ul class="mt-3 list-none space-y-2 p-0 text-sm">
                    <li><a class="text-ink-soft no-underline hover:text-ink" href="/openapi/v1.json">API reference</a></li>
                    <li><a class="text-ink-soft no-underline hover:text-ink" href="/health/ready">Readiness probe</a></li>
                    <li><a class="text-ink-soft no-underline hover:text-ink" href="/health/live">Liveness probe</a></li>
                    <li><a class="text-ink-soft no-underline hover:text-ink" href="/.well-known/openid-configuration">OpenID discovery</a></li>
                </ul>
            </div>

            <div>
                <h2 class="text-2xs font-semibold uppercase tracking-[0.08em] text-ink-soft">Elsewhere</h2>
                <ul class="mt-3 list-none space-y-2 p-0 text-sm">
                    <li><a class="text-ink-soft no-underline hover:text-ink" href="https://github.com/djgene01/tuesday-com" rel="noopener">Source on GitHub</a></li>
                    <li><a class="text-ink-soft no-underline hover:text-ink" href="https://github.com/djgene01/tuesday-com/blob/main/LICENSE" rel="noopener">MIT licence</a></li>
                    <li><a class="text-ink-soft no-underline hover:text-ink" href="https://github.com/djgene01/tuesday-com/issues" rel="noopener">Report an issue</a></li>
                </ul>
            </div>
        </div>

        <div class="mx-auto flex max-w-[1180px] flex-wrap items-center gap-3 border-t border-line px-5 py-6 text-xs text-ink-soft">
            <span>© @DateTime.UtcNow.Year Tuesday.com — clean-room implementation, MIT licensed.</span>
            <span class="ml-auto flex items-center gap-1.5">
                <span class="h-1.5 w-1.5 rounded-full bg-status-done" aria-hidden="true"></span>
                running on your infrastructure
            </span>
        </div>
    </footer>
</div>
