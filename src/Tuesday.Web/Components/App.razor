@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor Http

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Tuesday.com — a work operating system for boards, items and views." />
    <meta name="color-scheme" content="light" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="preload" href="/fonts/Figtree-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Poppins-600.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/fonts/fonts.css" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["css/tailwind.css"]" />
    <link rel="stylesheet" href="@Assets["Tuesday.Web.styles.css"]" />
    <ImportMap Nonce="@Nonce" />
    <HeadOutlet />
</head>

<body>
    @* Interactive components bring their own @rendermode, so the document itself stays
       static. The auth forms are plain HTML posts and opt out of enhanced navigation with
       data-enhance-nav="false", which stops Blazor rejecting a form it does not own. *@
    <Routes />
    <ReconnectModal />
    @* The nonce must be on the bootstrap tag: Blazor reuses it for the scripts it injects
       at circuit start, and the CSP header only allows that nonce plus same-origin files. *@
    <script src="@Assets["_framework/blazor.web.js"]" nonce="@Nonce"></script>
</body>

</html>

@code {
    private string Nonce => Http.HttpContext?.Items[Tuesday.Web.Security.SecurityHeadersMiddleware.NonceItemKey] as string ?? string.Empty;
}

