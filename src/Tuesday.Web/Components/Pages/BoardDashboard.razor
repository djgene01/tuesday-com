@page "/board/{BoardId:guid}/dashboard"
@using Microsoft.AspNetCore.Authorization
@using Tuesday.Application.Boards
@using Tuesday.Application.Tenancy
@using Tuesday.Domain.Automation
@using Tuesday.Infrastructure.Automations
@using Tuesday.Infrastructure.Queries
@using Tuesday.Web.Security
@attribute [Authorize(Policy = "capability:ViewWorkspace")]
@inject WorkspaceQueries Boards
@inject BoardQueries Queries
@inject AutomationService Automations
@inject WebhookService Hooks
@inject ITenantContext Tenant
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>@(_board?.Name ?? "Board") dashboard — Tuesday.com</PageTitle>

@if (_board is null)
{
    <main class="mx-auto max-w-[900px]">
        <div class="ui-card px-6 py-14 text-center">
            <p class="font-display text-lg font-semibold text-ink">Board not found</p>
            <a class="ui-btn-primary mt-5" href="/workspace">Back to your workspace</a>
        </div>
    </main>
}
else
{
    <main class="mx-auto max-w-[1200px]">
        <nav class="mb-1 flex items-center gap-1.5 text-xs text-ink-soft" aria-label="Breadcrumb">
            <a class="hover:text-brand" href="/board/@BoardId">@_board.Name</a>
            <span aria-hidden="true">/</span>
            <span class="text-ink-faint">Dashboard</span>
        </nav>

        <div class="mb-5 flex flex-wrap items-center gap-3">
            <h1 class="font-display text-[26px] font-semibold leading-tight tracking-tight text-ink">Dashboard</h1>
            <a class="ui-btn-ghost ml-auto !h-9 !px-4 text-[13px]" href="/board/@BoardId">Back to the board</a>
        </div>

        <section class="mb-5 grid grid-cols-2 gap-3 lg:grid-cols-4" aria-label="Board totals">
            <div class="ui-card px-4 py-3">
                <span class="block font-display text-[24px] font-semibold tabular-nums text-ink">@_board.ItemCount</span>
                <span class="text-[11px] font-semibold uppercase tracking-[0.08em] text-ink-soft">Items</span>
            </div>
            <div class="ui-card px-4 py-3">
                <span class="block font-display text-[24px] font-semibold tabular-nums text-ink">@_board.Groups.Count</span>
                <span class="text-[11px] font-semibold uppercase tracking-[0.08em] text-ink-soft">Groups</span>
            </div>
            <div class="ui-card px-4 py-3">
                <span class="block font-display text-[24px] font-semibold tabular-nums @(_overdue > 0 ? "text-status-stuck" : "text-ink")">@_overdue</span>
                <span class="text-[11px] font-semibold uppercase tracking-[0.08em] text-ink-soft">Overdue</span>
            </div>
            <div class="ui-card px-4 py-3">
                <span class="block font-display text-[24px] font-semibold tabular-nums text-ink">@_donePercent%</span>
                <span class="text-[11px] font-semibold uppercase tracking-[0.08em] text-ink-soft">Done</span>
            </div>
        </section>

        <div class="grid gap-4 lg:grid-cols-2">
            <section class="ui-card p-4" aria-label="By status">
                <h2 class="mb-3 font-display text-[15px] font-semibold text-ink">By status</h2>
                @foreach (var lane in _byStatus)
                {
                    <div class="mb-2 flex items-center gap-3 last:mb-0">
                        <span class="w-[110px] shrink-0 truncate text-[13px] text-ink-soft">@lane.Label</span>
                        <span class="h-3 flex-1 overflow-hidden rounded-full bg-canvas">
                            <span class="block h-full rounded-full" style="width:@(Width(lane.Count)); background:@StatusColour(lane.Label)"></span>
                        </span>
                        <span class="w-9 text-right text-[12px] tabular-nums text-ink-soft">@lane.Count</span>
                    </div>
                }
            </section>

            <section class="ui-card p-4" aria-label="By group">
                <h2 class="mb-3 font-display text-[15px] font-semibold text-ink">By group</h2>
                @for (var i = 0; i < _board.Groups.Count; i++)
                {
                    var group = _board.Groups[i];
                    <div class="mb-2 flex items-center gap-3 last:mb-0">
                        <span class="w-[110px] shrink-0 truncate text-[13px] text-ink-soft">@group.Title</span>
                        <span class="h-3 flex-1 overflow-hidden rounded-full bg-canvas">
                            <span class="block h-full rounded-full" style="width:@(Width(group.Items.Count)); background:@GroupColour(i)"></span>
                        </span>
                        <span class="w-9 text-right text-[12px] tabular-nums text-ink-soft">@group.Items.Count</span>
                    </div>
                }
            </section>

            <section class="ui-card p-4" aria-label="Automations">
                <h2 class="mb-3 font-display text-[15px] font-semibold text-ink">Automations</h2>
                @if (_automations.Count == 0)
                {
                    <p class="text-sm text-ink-soft">No automations on this board.</p>
                }
                else
                {
                    <ul class="divide-y divide-line">
                        @foreach (var rule in _automations)
                        {
                            <li class="flex flex-wrap items-center gap-2 py-2 first:pt-0 last:pb-0">
                                <span class="text-[13px] font-medium text-ink">@rule.Name</span>
                                <span class="text-[11px] text-ink-faint">@rule.Trigger · @(string.IsNullOrWhiteSpace(rule.Condition) ? "always" : rule.Condition)</span>
                                <span class="ui-pill ml-auto @(rule.Enabled ? "bg-status-done/15 text-[#007a4d]" : "bg-canvas text-ink-faint")">@(rule.Enabled ? "on" : "off")</span>
                            </li>
                        }
                    </ul>
                }

                <h3 class="mb-2 mt-4 text-[11px] font-semibold uppercase tracking-[0.08em] text-ink-soft">Recent runs</h3>
                @if (_runs.Count == 0)
                {
                    <p class="text-sm text-ink-soft">Nothing has run yet. Edit a status cell to fire a rule.</p>
                }
                else
                {
                    <ul class="divide-y divide-line">
                        @foreach (var run in _runs)
                        {
                            <li class="flex flex-wrap items-center gap-2 py-2 first:pt-0 last:pb-0">
                                <span class="ui-pill @(run.Status == AutomationRunStatus.Succeeded ? "bg-status-done/15 text-[#007a4d]" : "bg-status-stuck/10 text-status-stuck")">@run.Status</span>
                                <span class="text-[13px] font-medium text-ink">@run.Name</span>
                                <span class="text-[11px] text-ink-faint">@run.Message · @run.CreatedAt.ToLocalTime().ToString("d MMM, HH:mm")</span>
                            </li>
                        }
                    </ul>
                }
            </section>

            <section class="ui-card p-4" aria-label="Webhooks">
                <h2 class="mb-3 font-display text-[15px] font-semibold text-ink">Webhooks</h2>
                @if (_hooks.Count == 0)
                {
                    <p class="text-sm text-ink-soft">
                        No webhooks registered. Register one through
                        <code class="rounded bg-canvas px-1 py-0.5 text-[12px] text-ink-soft">POST /api/v1/boards/{BoardId}/webhooks</code>.
                    </p>
                }
                else
                {
                    <ul class="divide-y divide-line">
                        @foreach (var hook in _hooks)
                        {
                            <li class="flex flex-wrap items-center gap-2 py-2 first:pt-0 last:pb-0">
                                <span class="truncate text-[13px] font-medium text-ink">@hook.Url</span>
                                <span class="text-[11px] text-ink-faint">last status @(hook.LastStatus?.ToString() ?? "never") · @(hook.LastCalledAt?.ToLocalTime().ToString("d MMM, HH:mm") ?? "not called")</span>
                                <span class="ui-pill ml-auto @(hook.Enabled ? "bg-status-done/15 text-[#007a4d]" : "bg-canvas text-ink-faint")">@(hook.Enabled ? "on" : "off")</span>
                            </li>
                        }
                    </ul>
                }
            </section>
        </div>
    </main>
}

@code {
    [Parameter]
    public Guid BoardId { get; set; }

    private BoardModel? _board;
    private IReadOnlyList<(string Label, int Count)> _byStatus = [];
    private IReadOnlyList<AutomationRow> _automations = [];
    private IReadOnlyList<AutomationRunRow> _runs = [];
    private IReadOnlyList<WebhookRow> _hooks = [];
    private int _overdue;
    private int _donePercent;
    private int _max = 1;

    protected override async Task OnInitializedAsync()
    {
        if (Tenant.UserId is not { } userId || Tenant.Role is not { } role)
        {
            return;
        }

        if (await Boards.FindBoardAsync(BoardId, userId, role) is null)
        {
            HttpContextAccessor.HttpContext?.Response.StatusCode = StatusCodes.Status404NotFound;
            return;
        }

        _board = await Queries.GetAsync(BoardId);

        if (_board is null)
        {
            return;
        }

        var statusColumn = _board.Columns.FirstOrDefault(column => column.Title.Equals("Status", StringComparison.OrdinalIgnoreCase))
                           ?? _board.Columns.FirstOrDefault(column => column.Type == Tuesday.Domain.Boards.ColumnType.Status);

        var dueColumn = _board.Columns.FirstOrDefault(column => column.Type == Tuesday.Domain.Boards.ColumnType.Date);

        var today = DateOnly.FromDateTime(DateTime.UtcNow);

        _byStatus = statusColumn is null
            ? []
            : _board.Items
                .GroupBy(item => item.Cells.GetValueOrDefault(statusColumn.Id) ?? "No status")
                .OrderByDescending(group => group.Count())
                .Select(group => (group.Key, group.Count()))
                .ToList();

        // Bars read as a share of the board, so 125 of 500 fills a quarter of the track.
        _max = Math.Max(1, _board.ItemCount);

        _overdue = dueColumn is null
            ? 0
            : _board.Items.Count(item =>
                DateOnly.TryParse(item.Cells.GetValueOrDefault(dueColumn.Id), out var due)
                && due < today
                && !string.Equals(item.Cells.GetValueOrDefault(statusColumn?.Id ?? Guid.Empty), "Done", StringComparison.OrdinalIgnoreCase));

        var done = statusColumn is null
            ? 0
            : _board.Items.Count(item =>
                string.Equals(item.Cells.GetValueOrDefault(statusColumn.Id), "Done", StringComparison.OrdinalIgnoreCase));

        _donePercent = _board.ItemCount == 0 ? 0 : (int)Math.Round(done * 100.0 / _board.ItemCount);

        _automations = await Automations.ListAsync(BoardId);
        _runs = await Automations.RecentRunsAsync(BoardId, 8);
        _hooks = await Hooks.ListAsync(BoardId);
    }

    private static string StatusColour(string label) => label.Trim().ToLowerInvariant() switch
    {
        "done" => "#00C875",
        "stuck" => "#C42B45",
        "working on it" => "#FDAB3D",
        "not started" => "#C4C4C4",
        _ => "#6161FF"
    };

    /// <summary>Bar width as a bare percentage; the style attribute supplies the property.</summary>
    /// <summary>Distinct bar colours per group, so the chart is readable at a glance.</summary>
    private static string GroupColour(int index) => (index % 5) switch
    {
        0 => "#6161FF",
        1 => "#579BFC",
        2 => "#A25DDC",
        3 => "#00C875",
        _ => "#FDAB3D"
    };

    private string Width(int count) =>
        (count * 100.0 / _max).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) + "%";
}
