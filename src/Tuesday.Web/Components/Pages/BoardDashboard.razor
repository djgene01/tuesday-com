@page "/board/{BoardId:guid}/dashboard"
@using Microsoft.AspNetCore.Authorization
@using Tuesday.Application.Boards
@using Tuesday.Application.Tenancy
@using Tuesday.Domain.Automation
@using Tuesday.Infrastructure.Automations
@using Tuesday.Infrastructure.Queries
@using Tuesday.Web.Security
@attribute [Authorize(Policy = "capability:ViewWorkspace")]
@inject WorkspaceQueries Boards
@inject BoardQueries Queries
@inject AutomationService Automations
@inject WebhookService Hooks
@inject ITenantContext Tenant
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>@(_board?.Name ?? "Board") dashboard — Tuesday.com</PageTitle>

@if (_board is null)
{
    <NotFoundPanel Title="Board not found" Message="Either it does not exist, or it is not shared with you." />
}
else
{
    <div class="mx-auto max-w-[1200px]">
        <PageHeader Title="Dashboard" Class="mb-5"
                    Crumbs="@([new Crumb(_board.Name, $"/board/{BoardId}"), new Crumb("Dashboard")])">
            <Actions>
                <Button Href="@($"/board/{BoardId}")" Variant="ButtonVariant.Ghost" IconStart="IconName.ChevronLeft">Back to the board</Button>
            </Actions>
        </PageHeader>

        <section class="mb-5 grid grid-cols-2 gap-3 lg:grid-cols-4" aria-label="Board totals">
            <div class="ui-card px-4 py-3.5">
                <span class="ui-section-title">Items</span>
                <span class="mt-1 block font-display text-2xl font-semibold tabular-nums text-ink">@_board.ItemCount</span>
            </div>
            <div class="ui-card px-4 py-3.5">
                <span class="ui-section-title">Groups</span>
                <span class="mt-1 block font-display text-2xl font-semibold tabular-nums text-ink">@_board.Groups.Count</span>
            </div>
            <div class="ui-card px-4 py-3.5">
                <span class="ui-section-title">Overdue</span>
                <span class="mt-1 block font-display text-2xl font-semibold tabular-nums @(_overdue > 0 ? "text-bad" : "text-ink")">@_overdue</span>
            </div>
            <div class="ui-card px-4 py-3.5">
                <span class="ui-section-title">Done</span>
                <span class="mt-1 block font-display text-2xl font-semibold tabular-nums text-ink">@_donePercent%</span>
            </div>
        </section>

        <div class="grid gap-4 lg:grid-cols-2">
            <section class="ui-card p-4" aria-labelledby="by-status">
                <h2 id="by-status" class="ui-card-title mb-3">By status</h2>
                @if (_byStatus.Count == 0)
                {
                    <p class="m-0 text-sm text-ink-soft">This board has no status column to chart.</p>
                }
                @foreach (var lane in _byStatus)
                {
                    <div class="mb-2 flex items-center gap-3 last:mb-0">
                        <span class="w-[110px] shrink-0 truncate text-sm text-ink-soft">@lane.Label</span>
                        <span class="h-3 flex-1 overflow-hidden rounded-full bg-surface-2 ring-1 ring-inset ring-line">
                            <span class="block h-full rounded-full" style="width:@(Width(lane.Count)); background:@StatusPalette.StatusFill(lane.Label)"></span>
                        </span>
                        <span class="w-9 text-right text-xs tabular-nums text-ink-soft">@lane.Count</span>
                    </div>
                }
            </section>

            <section class="ui-card p-4" aria-labelledby="by-group">
                <h2 id="by-group" class="ui-card-title mb-3">By group</h2>
                @for (var i = 0; i < _board.Groups.Count; i++)
                {
                    var group = _board.Groups[i];
                    <div class="mb-2 flex items-center gap-3 last:mb-0">
                        <span class="w-[110px] shrink-0 truncate text-sm text-ink-soft">@group.Title</span>
                        <span class="h-3 flex-1 overflow-hidden rounded-full bg-surface-2 ring-1 ring-inset ring-line">
                            <span class="block h-full rounded-full" style="width:@(Width(group.Items.Count)); background:@StatusPalette.SeriesFill(i)"></span>
                        </span>
                        <span class="w-9 text-right text-xs tabular-nums text-ink-soft">@group.Items.Count</span>
                    </div>
                }
            </section>

            <section class="ui-card p-4" aria-labelledby="automations">
                <h2 id="automations" class="ui-card-title mb-3">Automations</h2>
                @if (_automations.Count == 0)
                {
                    <p class="m-0 text-sm text-ink-soft">No automations on this board.</p>
                }
                else
                {
                    <ul class="m-0 list-none divide-y divide-line p-0">
                        @foreach (var rule in _automations)
                        {
                            <li class="flex flex-wrap items-center gap-2 py-2 first:pt-0 last:pb-0">
                                <span class="text-sm font-medium text-ink">@rule.Name</span>
                                <span class="text-xs text-ink-soft">@rule.Trigger · @(string.IsNullOrWhiteSpace(rule.Condition) ? "always" : rule.Condition)</span>
                                <span class="ui-pill ml-auto @(rule.Enabled ? "ui-pill-ok" : "ui-pill-neutral")">@(rule.Enabled ? "On" : "Off")</span>
                            </li>
                        }
                    </ul>
                }

                <h3 class="ui-section-title mb-2 mt-5">Recent runs</h3>
                @if (_runs.Count == 0)
                {
                    <p class="m-0 text-sm text-ink-soft">Nothing has run yet. Edit a status cell to fire a rule.</p>
                }
                else
                {
                    <ul class="m-0 list-none divide-y divide-line p-0">
                        @foreach (var run in _runs)
                        {
                            <li class="flex flex-wrap items-center gap-2 py-2 first:pt-0 last:pb-0">
                                <span class="ui-pill @(run.Status == AutomationRunStatus.Succeeded ? "ui-pill-ok" : "ui-pill-bad")">@run.Status</span>
                                <span class="text-sm font-medium text-ink">@run.Name</span>
                                <span class="text-xs text-ink-soft">@run.Message · @run.CreatedAt.ToLocalTime().ToString("d MMM, HH:mm")</span>
                            </li>
                        }
                    </ul>
                }
            </section>

            <section class="ui-card p-4" aria-labelledby="webhooks">
                <h2 id="webhooks" class="ui-card-title mb-3">Webhooks</h2>
                @if (_hooks.Count == 0)
                {
                    <p class="m-0 text-sm text-ink-soft">
                        No webhooks yet. A webhook tells another system the moment something on this board changes.
                    </p>
                    <p class="m-0 mt-2 text-xs text-ink-soft">
                        Developers register them through the API:
                        <code class="break-all rounded bg-surface-2 px-1 py-0.5 text-ink">POST /api/v1/boards/@BoardId/webhooks</code>
                    </p>
                }
                else
                {
                    <ul class="m-0 list-none divide-y divide-line p-0">
                        @foreach (var hook in _hooks)
                        {
                            <li class="flex flex-wrap items-center gap-2 py-2 first:pt-0 last:pb-0">
                                <span class="min-w-0 truncate text-sm font-medium text-ink">@hook.Url</span>
                                <span class="text-xs text-ink-soft">Last status @(hook.LastStatus?.ToString() ?? "never") · @(hook.LastCalledAt?.ToLocalTime().ToString("d MMM, HH:mm") ?? "not called")</span>
                                <span class="ui-pill ml-auto @(hook.Enabled ? "ui-pill-ok" : "ui-pill-neutral")">@(hook.Enabled ? "On" : "Off")</span>
                            </li>
                        }
                    </ul>
                }
            </section>
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid BoardId { get; set; }

    private BoardModel? _board;
    private IReadOnlyList<(string Label, int Count)> _byStatus = [];
    private IReadOnlyList<AutomationRow> _automations = [];
    private IReadOnlyList<AutomationRunRow> _runs = [];
    private IReadOnlyList<WebhookRow> _hooks = [];
    private int _overdue;
    private int _donePercent;
    private int _max = 1;

    protected override async Task OnInitializedAsync()
    {
        if (Tenant.UserId is not { } userId || Tenant.Role is not { } role)
        {
            return;
        }

        if (await Boards.FindBoardAsync(BoardId, userId, role) is null)
        {
            // 404 without leaking existence. Applied on OnStarting, like BoardView: assigning a
            // 4xx mid-render makes Blazor discard the body and the browser shows its own page.
            if (HttpContextAccessor.HttpContext is { } context)
            {
                context.Response.OnStarting(() =>
                {
                    context.Response.StatusCode = StatusCodes.Status404NotFound;
                    return Task.CompletedTask;
                });
            }

            return;
        }

        _board = await Queries.GetAsync(BoardId);

        if (_board is null)
        {
            return;
        }

        var statusColumn = _board.Columns.FirstOrDefault(column => column.Title.Equals("Status", StringComparison.OrdinalIgnoreCase))
                           ?? _board.Columns.FirstOrDefault(column => column.Type == Tuesday.Domain.Boards.ColumnType.Status);

        var dueColumn = _board.Columns.FirstOrDefault(column => column.Type == Tuesday.Domain.Boards.ColumnType.Date);

        var today = DateOnly.FromDateTime(DateTime.UtcNow);

        _byStatus = statusColumn is null
            ? []
            : _board.Items
                .GroupBy(item => item.Cells.GetValueOrDefault(statusColumn.Id) ?? "No status")
                .OrderByDescending(group => group.Count())
                .Select(group => (group.Key, group.Count()))
                .ToList();

        // Bars read as a share of the board, so 125 of 500 fills a quarter of the track.
        _max = Math.Max(1, _board.ItemCount);

        _overdue = dueColumn is null
            ? 0
            : _board.Items.Count(item =>
                DateOnly.TryParse(item.Cells.GetValueOrDefault(dueColumn.Id), out var due)
                && due < today
                && !string.Equals(item.Cells.GetValueOrDefault(statusColumn?.Id ?? Guid.Empty), "Done", StringComparison.OrdinalIgnoreCase));

        var done = statusColumn is null
            ? 0
            : _board.Items.Count(item =>
                string.Equals(item.Cells.GetValueOrDefault(statusColumn.Id), "Done", StringComparison.OrdinalIgnoreCase));

        _donePercent = _board.ItemCount == 0 ? 0 : (int)Math.Round(done * 100.0 / _board.ItemCount);

        _automations = await Automations.ListAsync(BoardId);
        _runs = await Automations.RecentRunsAsync(BoardId, 8);
        _hooks = await Hooks.ListAsync(BoardId);
    }

    /// <summary>Bar width as a bare percentage; the style attribute supplies the property.</summary>
    private string Width(int count) =>
        (count * 100.0 / _max).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) + "%";
}
