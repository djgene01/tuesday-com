@page "/account/security"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Tuesday.Infrastructure.Identity
@using Tuesday.Web.Security
@attribute [Authorize]
@rendermode InteractiveServer
@inject UserManager<ApplicationUser> Users
@inject SignInManager<ApplicationUser> SignIn
@inject NavigationManager Navigation
@inject ToastService Toasts

<PageTitle>Account security — Tuesday.com</PageTitle>

<div class="mx-auto max-w-[820px]">
    <PageHeader Title="Account security" Eyebrow="Your account">
        <Subtitle>A second factor protects your session, your API tokens and the board data your role can reach.</Subtitle>
    </PageHeader>

    @if (_message is not null)
    {
        <Alert Kind="AlertKind.Success" Class="mb-4">@_message</Alert>
    }

    @if (_error is not null)
    {
        <Alert Kind="AlertKind.Error" Class="mb-4">@_error</Alert>
    }

    @if (_userId is null)
    {
        <div class="ui-card p-5"><Skeleton Lines="3" /></div>
    }
    else if (_enabled)
    {
        <section class="ui-card p-5" aria-labelledby="totp-title">
            <div class="flex items-start gap-3">
                <span class="grid h-9 w-9 shrink-0 place-items-center rounded-control bg-ok-bg text-ok" aria-hidden="true">
                    <Icon Name="IconName.Shield" Class="h-[18px] w-[18px]" />
                </span>
                <div class="min-w-0 flex-1">
                    <div class="flex items-center gap-2">
                        <h2 id="totp-title" class="ui-card-title">Authenticator app</h2>
                        <span class="ui-pill ui-pill-ok">On</span>
                    </div>
                    <p class="m-0 mt-0.5 text-sm text-ink-soft">You will be asked for a six-digit code when you sign in.</p>
                </div>
            </div>

            @if (_recoveryCodes is not null)
            {
                <div class="mt-5 rounded-control border border-line bg-surface-2 p-4">
                    <h3 class="ui-section-title m-0">Recovery codes</h3>
                    <p class="m-0 mt-1 text-xs text-ink-soft">Store these somewhere safe. Each one works once, and they replace any earlier set.</p>
                    <ul class="m-0 mt-3 grid list-none grid-cols-2 gap-1.5 p-0 sm:grid-cols-5">
                        @foreach (var recoveryCode in _recoveryCodes)
                        {
                            <li class="rounded-md bg-surface px-2 py-1 text-center ring-1 ring-inset ring-line"><code class="text-xs text-ink">@recoveryCode</code></li>
                        }
                    </ul>
                </div>
            }

            <div class="mt-5 flex flex-wrap gap-2 border-t border-line pt-4">
                <Button Variant="ButtonVariant.Ghost" @onclick="AskRegenerateAsync" Disabled="_busy">Generate new recovery codes</Button>
                <Button Variant="ButtonVariant.QuietDanger" @onclick="AskDisableAsync" Disabled="_busy">Turn off two-factor</Button>
            </div>
        </section>
    }
    else
    {
        <section class="ui-card p-5" aria-labelledby="totp-title">
            <div class="flex items-start gap-3">
                <span class="grid h-9 w-9 shrink-0 place-items-center rounded-control bg-surface-2 text-ink-soft ring-1 ring-inset ring-line" aria-hidden="true">
                    <Icon Name="IconName.Shield" Class="h-[18px] w-[18px]" />
                </span>
                <div class="min-w-0 flex-1">
                    <div class="flex items-center gap-2">
                        <h2 id="totp-title" class="ui-card-title">Authenticator app</h2>
                        <span class="ui-pill ui-pill-neutral">Off</span>
                    </div>
                    <p class="m-0 mt-0.5 text-sm text-ink-soft">Enrol an authenticator app (1Password, Google Authenticator, Authy) to turn it on.</p>
                </div>
                @if (_sharedKey is null)
                {
                    <Button @onclick="BeginEnrolmentAsync" Busy="_busy">Set up authenticator</Button>
                }
            </div>

            @if (_sharedKey is not null)
            {
                <form class="mt-5 rounded-control border border-line bg-surface-2 p-4" @onsubmit="ConfirmEnrolmentAsync" @onsubmit:preventDefault>
                    <ol class="m-0 list-decimal space-y-4 pl-5 text-sm text-ink">
                        <li>
                            Add this key to your app.
                            <p class="m-0 mt-2 rounded-control bg-surface px-3 py-2 ring-1 ring-inset ring-line"><code class="select-all text-sm tracking-[0.12em] text-ink">@FormatKey(_sharedKey)</code></p>
                            <p class="m-0 mt-1.5 break-all text-xs text-ink-soft">Or open this link on the device: <code>@_authenticatorUri</code></p>
                        </li>
                        <li>
                            Enter the current six-digit code.
                            <Field Label="Verification code" Class="mt-2 max-w-xs">
                                <input type="text" name="code" inputmode="numeric" autocomplete="one-time-code"
                                       @bind="_code" @bind:event="oninput" maxlength="7" class="ui-input ui-input-code" />
                            </Field>
                        </li>
                    </ol>

                    <Button Type="submit" Class="mt-4" Busy="_busy" Disabled="@string.IsNullOrWhiteSpace(_code)">Verify and turn on</Button>
                </form>
            }
        </section>
    }
</div>

<ConfirmDialog @ref="_confirmDisable" Title="Turn off two-factor authentication?" ConfirmLabel="Turn off" OnConfirm="DisableAsync"
               Message="Signing in will only need your password. Your authenticator key and recovery codes stop working, and you will have to enrol again to turn it back on." />

<ConfirmDialog @ref="_confirmRegenerate" Title="Generate new recovery codes?" ConfirmLabel="Generate new codes" OnConfirm="RegenerateCodesAsync"
               Message="Your current recovery codes stop working as soon as the new set is created." />

@code {
    private string? _message;
    private string? _error;
    private bool _busy;
    private bool _enabled;
    private Guid? _userId;
    private string? _sharedKey;
    private string? _authenticatorUri;
    private string _code = string.Empty;
    private string[]? _recoveryCodes;
    private ConfirmDialog? _confirmDisable;
    private ConfirmDialog? _confirmRegenerate;

    private Task AskDisableAsync() => _confirmDisable?.OpenAsync() ?? Task.CompletedTask;

    private Task AskRegenerateAsync() => _confirmRegenerate?.OpenAsync() ?? Task.CompletedTask;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var user = await CurrentAsync();

        if (user is null)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        _userId = user.Id;
        _enabled = await Users.GetTwoFactorEnabledAsync(user);
    }

    private async Task<ApplicationUser?> CurrentAsync()
    {
        if (AuthState is null)
        {
            return null;
        }

        var state = await AuthState;
        return await Users.GetUserAsync(state.User);
    }

    private async Task BeginEnrolmentAsync()
    {
        _busy = true;
        _error = null;
        _message = null;

        try
        {
            var user = await CurrentAsync();

            if (user is null)
            {
                _error = "Your session expired. Sign in again.";
                return;
            }

            _sharedKey = await Users.GetAuthenticatorKeyAsync(user);

            if (string.IsNullOrEmpty(_sharedKey))
            {
                await Users.ResetAuthenticatorKeyAsync(user);
                _sharedKey = await Users.GetAuthenticatorKeyAsync(user);
            }

            _authenticatorUri = TotpUri("Tuesday.com", user.Email ?? user.UserName ?? "account", _sharedKey!);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ConfirmEnrolmentAsync()
    {
        _busy = true;
        _error = null;
        _message = null;

        try
        {
            var user = await CurrentAsync();

            if (user is null)
            {
                _error = "Your session expired. Sign in again.";
                return;
            }

            // Spaces are what people type when the app shows "123 456".
            var code = _code.Replace(" ", string.Empty, StringComparison.Ordinal).Trim();
            var result = await Users.VerifyTwoFactorTokenAsync(
                user, TokenOptions.DefaultAuthenticatorProvider, code);

            if (!result)
            {
                _error = "That code was not accepted. Check the clock on your device.";
                return;
            }

            await Users.SetTwoFactorEnabledAsync(user, true);
            _enabled = true;
            _sharedKey = null;
            _authenticatorUri = null;
            _code = string.Empty;
            _recoveryCodes = (await Users.GenerateNewTwoFactorRecoveryCodesAsync(user, 10))?.ToArray();
            _message = "Two-factor authentication is on. Save your recovery codes.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RegenerateCodesAsync()
    {
        _busy = true;
        _error = null;
        _message = null;

        try
        {
            var user = await CurrentAsync();

            if (user is null)
            {
                _error = "Your session expired. Sign in again.";
                return;
            }

            _recoveryCodes = (await Users.GenerateNewTwoFactorRecoveryCodesAsync(user, 10))?.ToArray();
            Toasts.Success("New recovery codes generated. The previous set no longer works.");
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DisableAsync()
    {
        _busy = true;
        _error = null;
        _message = null;

        try
        {
            var user = await CurrentAsync();

            if (user is null)
            {
                _error = "Your session expired. Sign in again.";
                return;
            }

            await Users.SetTwoFactorEnabledAsync(user, false);
            await Users.ResetAuthenticatorKeyAsync(user);
            _enabled = false;
            _recoveryCodes = null;
            Toasts.Success("Two-factor authentication is off.");
        }
        finally
        {
            _busy = false;
        }
    }

    private static string FormatKey(string key) =>
        string.Join(' ', key.ToCharArray().Chunk(4).Select(part => new string(part)));

    /// <summary>
    /// The otpauth URI an authenticator app scans. TotpUri lives in Web because it is a
    /// presentation concern; the generator and validator stay in Identity.
    /// </summary>
    private static string TotpUri(string issuer, string account, string key)
    {
        var label = Uri.EscapeDataString(issuer + ":" + account);
        var secret = Uri.EscapeDataString(key);

        return $"otpauth://totp/{label}?secret={secret}&issuer={Uri.EscapeDataString(issuer)}&digits=6&period=30";
    }
}
