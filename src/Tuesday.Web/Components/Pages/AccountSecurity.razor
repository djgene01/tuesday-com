@page "/account/security"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Tuesday.Infrastructure.Identity
@using Tuesday.Web.Security
@attribute [Authorize]
@rendermode InteractiveServer
@inject UserManager<ApplicationUser> Users
@inject SignInManager<ApplicationUser> SignIn
@inject NavigationManager Navigation

<PageTitle>Account security — Tuesday.com</PageTitle>

<section class="mx-auto max-w-[820px]">
    <p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-ink-soft">Your account</p>
    <h1 class="mt-1 font-display text-[26px] font-semibold leading-tight tracking-tight text-ink">Account security</h1>
    <p class="mt-1 text-sm text-ink-soft">A second factor protects your session, your API tokens and the board data your role can reach.</p>

    @if (_message is not null)
    {
        <p class="mt-4 rounded-lg border border-status-done/30 bg-status-done/10 px-4 py-2 text-sm text-[#007a4d]" role="status">@_message</p>
    }

    @if (_error is not null)
    {
        <p class="mt-4 rounded-lg border border-status-stuck/30 bg-status-stuck/10 px-4 py-2 text-sm text-status-stuck" role="alert">@_error</p>
    }

    @if (_userId is null)
    {
        <p class="mt-4 text-sm text-ink-faint">Loading…</p>
    }
    else if (_enabled)
    {
        <div class="ui-card mt-4 p-5">
            <div class="flex items-center gap-2">
                <h2 class="font-display text-[15px] font-semibold text-ink">Authenticator app</h2>
                <span class="ui-pill bg-status-done/15 text-[#007a4d]">On</span>
            </div>
            <p class="mt-1 text-sm text-ink-soft">You will be asked for a six-digit code when you sign in.</p>

            @if (_recoveryCodes is not null)
            {
                <h3 class="mt-4 text-[11px] font-semibold uppercase tracking-[0.08em] text-ink-soft">Recovery codes</h3>
                <p class="mt-1 text-[12px] text-ink-faint">Store these somewhere safe. Each one works once, and they replace any earlier set.</p>
                <ul class="mt-2 grid grid-cols-2 gap-1.5 sm:grid-cols-5">
                    @foreach (var recoveryCode in _recoveryCodes)
                    {
                        <li class="rounded-control bg-canvas px-2 py-1 text-center"><code class="text-[12px] text-ink">@recoveryCode</code></li>
                    }
                </ul>
            }

            <div class="mt-4 flex flex-wrap gap-2">
                <button type="button" class="ui-btn-ghost !h-9 px-4 text-[13px]" @onclick="RegenerateCodesAsync" disabled="@_busy">Generate new recovery codes</button>
                <button type="button" class="ui-btn-quiet !h-9 px-4 text-[13px] hover:text-status-stuck" @onclick="DisableAsync" disabled="@_busy">Turn off two-factor</button>
            </div>
        </div>
    }
    else
    {
        <div class="ui-card mt-4 p-5">
            <div class="flex items-center gap-2">
                <h2 class="font-display text-[15px] font-semibold text-ink">Authenticator app</h2>
                <span class="ui-pill bg-canvas text-ink-soft">Off</span>
            </div>
            <p class="mt-1 text-sm text-ink-soft">Enrol an authenticator app (1Password, Google Authenticator, Authy) to turn it on.</p>
            <button type="button" class="ui-btn-primary mt-4 !h-9 px-4 text-[13px]" @onclick="BeginEnrolmentAsync" disabled="@_busy">Set up authenticator</button>

            @if (_sharedKey is not null)
            {
                <div class="mt-5 rounded-lg border border-line bg-canvas p-4">
                    <p class="text-[12px] text-ink-soft">Add this key to your app, then enter the current six-digit code.</p>
                    <p class="mt-2 rounded-control bg-surface px-3 py-2"><code class="text-[13px] tracking-[0.12em] text-ink">@FormatKey(_sharedKey)</code></p>
                    <p class="mt-2 break-all text-[11px] text-ink-faint">Or open this link on the device: <code class="text-ink-soft">@_authenticatorUri</code></p>

                    <label class="mt-3 block">
                        <span class="mb-1 block text-[11px] font-semibold uppercase tracking-[0.06em] text-ink-soft">Verification code</span>
                        <input type="text" name="code" inputmode="numeric" autocomplete="one-time-code"
                               @bind="_code" @bind:event="oninput" maxlength="7"
                               class="h-11 w-full rounded-control border border-line-strong bg-surface px-3 text-center text-lg tracking-[0.3em] text-ink outline-none focus:border-brand focus:ring-2 focus:ring-brand/20" />
                    </label>

                    <button type="button" class="ui-btn-primary mt-3 !h-9 px-4 text-[13px]" @onclick="ConfirmEnrolmentAsync" disabled="@_busy">Verify and turn on</button>
                </div>
            }
        </div>
    }
</section>

@code {
    private string? _message;
    private string? _error;
    private bool _busy;
    private bool _enabled;
    private Guid? _userId;
    private string? _sharedKey;
    private string? _authenticatorUri;
    private string _code = string.Empty;
    private string[]? _recoveryCodes;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var user = await CurrentAsync();

        if (user is null)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        _userId = user.Id;
        _enabled = await Users.GetTwoFactorEnabledAsync(user);
    }

    private async Task<ApplicationUser?> CurrentAsync()
    {
        if (AuthState is null)
        {
            return null;
        }

        var state = await AuthState;
        return await Users.GetUserAsync(state.User);
    }

    private async Task BeginEnrolmentAsync()
    {
        _busy = true;
        _error = null;
        _message = null;

        try
        {
            var user = await CurrentAsync();

            if (user is null)
            {
                _error = "Your session expired. Sign in again.";
                return;
            }

            _sharedKey = await Users.GetAuthenticatorKeyAsync(user);

            if (string.IsNullOrEmpty(_sharedKey))
            {
                await Users.ResetAuthenticatorKeyAsync(user);
                _sharedKey = await Users.GetAuthenticatorKeyAsync(user);
            }

            _authenticatorUri = TotpUri("Tuesday.com", user.Email ?? user.UserName ?? "account", _sharedKey!);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ConfirmEnrolmentAsync()
    {
        _busy = true;
        _error = null;
        _message = null;

        try
        {
            var user = await CurrentAsync();

            if (user is null)
            {
                _error = "Your session expired. Sign in again.";
                return;
            }

            // Spaces are what people type when the app shows "123 456".
            var code = _code.Replace(" ", string.Empty, StringComparison.Ordinal).Trim();
            var result = await Users.VerifyTwoFactorTokenAsync(
                user, TokenOptions.DefaultAuthenticatorProvider, code);

            if (!result)
            {
                _error = "That code was not accepted. Check the clock on your device.";
                return;
            }

            await Users.SetTwoFactorEnabledAsync(user, true);
            _enabled = true;
            _sharedKey = null;
            _authenticatorUri = null;
            _code = string.Empty;
            _recoveryCodes = (await Users.GenerateNewTwoFactorRecoveryCodesAsync(user, 10))?.ToArray();
            _message = "Two-factor authentication is on. Save your recovery codes.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RegenerateCodesAsync()
    {
        _busy = true;
        _error = null;
        _message = null;

        try
        {
            var user = await CurrentAsync();

            if (user is null)
            {
                _error = "Your session expired. Sign in again.";
                return;
            }

            _recoveryCodes = (await Users.GenerateNewTwoFactorRecoveryCodesAsync(user, 10))?.ToArray();
            _message = "New recovery codes generated. The previous set no longer works.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DisableAsync()
    {
        _busy = true;
        _error = null;
        _message = null;

        try
        {
            var user = await CurrentAsync();

            if (user is null)
            {
                _error = "Your session expired. Sign in again.";
                return;
            }

            await Users.SetTwoFactorEnabledAsync(user, false);
            await Users.ResetAuthenticatorKeyAsync(user);
            _enabled = false;
            _recoveryCodes = null;
            _message = "Two-factor authentication is off.";
        }
        finally
        {
            _busy = false;
        }
    }

    private static string FormatKey(string key) =>
        string.Join(' ', key.ToCharArray().Chunk(4).Select(part => new string(part)));

    /// <summary>
    /// The otpauth URI an authenticator app scans. TotpUri lives in Web because it is a
    /// presentation concern; the generator and validator stay in Identity.
    /// </summary>
    private static string TotpUri(string issuer, string account, string key)
    {
        var label = Uri.EscapeDataString(issuer + ":" + account);
        var secret = Uri.EscapeDataString(key);

        return $"otpauth://totp/{label}?secret={secret}&issuer={Uri.EscapeDataString(issuer)}&digits=6&period=30";
    }
}
