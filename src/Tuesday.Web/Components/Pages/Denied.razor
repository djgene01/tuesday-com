@page "/denied"
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]

<PageTitle>No access — Tuesday.com</PageTitle>

<main class="mx-auto max-w-[640px] py-10">
    <div class="ui-card px-6 py-12 text-center">
        <span class="ui-pill bg-status-stuck/10 text-status-stuck">403</span>
        <h1 class="mt-3 font-display text-[24px] font-semibold tracking-tight text-ink">No access</h1>
        <p class="mx-auto mt-1 max-w-sm text-sm text-ink-soft">Your role does not allow this. Ask a tenant admin if you need it.</p>
        <a class="ui-btn-primary mt-6" href="/workspace">Back to your workspace</a>
    </div>
</main>
