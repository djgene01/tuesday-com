@page "/denied"
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]

<PageTitle>No access — Tuesday.com</PageTitle>

<div class="mx-auto max-w-[640px] py-10">
    <EmptyState Title="No access" Code="403" Heading="true">
        <ChildContent>Your role does not allow this. Ask a tenant admin if you need it.</ChildContent>
        <Actions>
            <Button Href="/workspace">Back to your workspace</Button>
        </Actions>
    </EmptyState>
</div>
