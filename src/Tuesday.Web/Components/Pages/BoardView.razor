@page "/board/{Id:guid}"
@using Microsoft.AspNetCore.Authorization
@using Tuesday.Application.Tenancy
@using Tuesday.Infrastructure.Queries
@using Tuesday.Web.Components.Board
@using Tuesday.Web.Components.Views
@attribute [Authorize(Policy = "capability:ViewWorkspace")]
@inject WorkspaceQueries Queries
@inject ITenantContext Tenant
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>@(_board?.Name ?? "Not found") — Tuesday.com</PageTitle>

@if (_board is null)
{
    <NotFoundPanel Title="Board not found" Message="Either it does not exist, or it is not shared with you." />
}
else
{
    <div class="mx-auto max-w-[1600px]">
        <PageHeader Title="@_board.Name" Class="mb-4"
                    Crumbs="@([new Crumb(_board.WorkspaceName, "/workspace"), new Crumb(_board.Name)])">
            <Badges>
                <span class="ui-pill ui-pill-neutral">@_board.Type</span>
                @if (!_board.CanEdit)
                {
                    <span class="ui-pill ui-pill-neutral"><Icon Name="IconName.Lock" Class="h-3 w-3" />Read-only</span>
                }
            </Badges>
            <Actions>
                <Button Href="@($"/board/{Id}/subitems")" Variant="ButtonVariant.Quiet" IconStart="IconName.Subitem">Sub-item columns</Button>
                <Button Href="@($"/board/{Id}/dashboard")" Variant="ButtonVariant.Ghost" IconStart="IconName.Chart">Dashboard</Button>
            </Actions>
        </PageHeader>

        <BoardViewsHost BoardId="Id" CanEdit="_board.CanEdit" @rendermode="InteractiveServer" />
    </div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private BoardCard? _board;

    protected override async Task OnInitializedAsync()
    {
        if (Tenant.UserId is not { } userId || Tenant.Role is not { } role)
        {
            return;
        }

        _board = await Queries.FindBoardAsync(Id, userId, role);

        if (_board is null && HttpContextAccessor.HttpContext is { } context)
        {
            // 404, not 403: an ungranted guest must not learn that the board exists.
            // Applied on OnStarting: setting a 4xx status before the render completes makes
            // Blazor discard the body, which left the browser showing its own error page.
            context.Response.OnStarting(() =>
            {
                context.Response.StatusCode = StatusCodes.Status404NotFound;
                return Task.CompletedTask;
            });
        }
    }
}
