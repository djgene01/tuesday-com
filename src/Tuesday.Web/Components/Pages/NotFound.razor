@page "/not-found"
@page "/{*path:nonfile}"
@using Microsoft.AspNetCore.Http

<PageTitle>Not found — Tuesday.com</PageTitle>

<main class="mx-auto max-w-[640px] py-10">
    <div class="ui-card px-6 py-12 text-center">
        <span class="ui-pill bg-canvas text-ink-soft">404</span>
        <h1 class="mt-3 font-display text-[24px] font-semibold tracking-tight text-ink">Not found</h1>
        <p class="mx-auto mt-1 max-w-sm text-sm text-ink-soft">That page does not exist, or it is not shared with you.</p>
        <a class="ui-btn-primary mt-6" href="/workspace">Back to your workspace</a>
    </div>
</main>

@code {
    /// <summary>The unmatched path, supplied by the catch-all route.</summary>
    [Parameter]
    public string? Path { get; set; }

    // The 404 status is set by NotFoundStatusMiddleware, not here: assigning a 4xx status
    // inside a Blazor SSR component makes the framework discard the rendered body, which
    // produced an empty page that browsers replaced with their own "can't be found" screen.

}
