@page "/workspace"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Tuesday.Application.Security
@using Tuesday.Application.Tenancy
@using Tuesday.Domain.Tenancy
@using Tuesday.Infrastructure.Identity
@using Tuesday.Infrastructure.Queries
@attribute [Authorize(Policy = "capability:ViewWorkspace")]
@inject WorkspaceQueries Queries
@inject ITenantContext Tenant
@inject Tuesday.Infrastructure.Tenancy.TenantResolver Resolver
@inject Microsoft.AspNetCore.Identity.UserManager<ApplicationUser> Users
@inject Tuesday.Infrastructure.Persistence.TuesdayDbContext Db
@inject ILogger<Workspace> Logger
@inject Tuesday.Application.Collaboration.IEmailSender Email
@inject Microsoft.Extensions.Options.IOptions<Tuesday.Application.Collaboration.EmailOptions> EmailOptions
@inject Microsoft.AspNetCore.Components.NavigationManager Nav

<PageTitle>Workspace — Tuesday.com</PageTitle>

<div class="mx-auto max-w-[1200px]">
    <PageHeader Title="Boards" Eyebrow="@($"Workspace · {Tenant.Role}")">
        <Subtitle>
            @_boards.Count board@( _boards.Count == 1 ? "" : "s" ) visible to you.
            @if (!CanCreate)
            {
                <text>Your role is read-only.</text>
            }
        </Subtitle>
        <Actions>
            @if (CanCreate)
            {
                <Button Href="#new-board" IconStart="IconName.Plus">New board</Button>
            }
        </Actions>
    </PageHeader>

    @if (_notice is not null)
    {
        <Alert Kind="AlertKind.Success" Class="mb-4">@_notice</Alert>
    }

    @if (_error is not null)
    {
        <Alert Kind="AlertKind.Error" Class="mb-4">@_error</Alert>
    }

    @if (_boards.Count == 0)
    {
        <EmptyState Title="No boards yet" IconName="IconName.Board">
            <ChildContent>
                @if (CanCreate)
                {
                    <text>Boards hold your team's work as rows and columns. Create the first one — it comes with groups, a status column and a table view.</text>
                }
                else
                {
                    <text>No boards are shared with you yet. Ask a workspace admin to give you access.</text>
                }
            </ChildContent>
            <Actions>
                @if (CanCreate)
                {
                    <Button Href="#new-board" IconStart="IconName.Plus">Create a board</Button>
                }
            </Actions>
        </EmptyState>
    }
    else
    {
        <ul class="m-0 grid list-none gap-3 p-0 sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var board in _boards)
            {
                <li>
                    <a class="group flex h-full items-start gap-3 rounded-card border border-line bg-surface p-4 text-ink no-underline shadow-[0_1px_2px_rgb(41_37_36/0.03)] transition hover:border-line-strong hover:shadow-card"
                       href="@($"/board/{board.Id}")">
                        <span class="grid h-9 w-9 shrink-0 place-items-center rounded-control bg-brand-wash text-brand-ink" aria-hidden="true">
                            <Icon Name="IconName.Board" Class="h-[18px] w-[18px]" />
                        </span>
                        <span class="flex min-w-0 flex-1 flex-col gap-2">
                            <span class="truncate font-display text-md font-semibold text-ink group-hover:text-brand-ink">@board.Name</span>
                            <span class="flex flex-wrap items-center gap-1.5">
                                <span class="ui-pill ui-pill-neutral">@board.WorkspaceName</span>
                                <span class="ui-pill ui-pill-neutral">@board.Type</span>
                                @if (board.IsGranted)
                                {
                                    <span class="ui-pill ui-pill-brand">Granted</span>
                                }
                            </span>
                        </span>
                        <Icon Name="IconName.ChevronRight" Class="mt-2 h-4 w-4 shrink-0 text-ink-soft opacity-0 transition group-hover:opacity-100" />
                    </a>
                </li>
            }
        </ul>
    }

    @if (CanCreate || CanManageMembers)
    {
        <div class="mt-8 grid gap-4 lg:grid-cols-2">
            @if (CanCreate)
            {
                <section id="new-board" class="ui-card scroll-mt-20 p-5" aria-labelledby="new-board-title">
                    <h2 id="new-board-title" class="ui-card-title">New board</h2>
                    <p class="mt-0.5 text-sm text-ink-soft">Starts with Backlog, In progress and Done groups.</p>
                    <EditForm Model="NewBoard" FormName="create-board" method="post" OnValidSubmit="CreateBoardAsync" class="mt-4">
                        <DataAnnotationsValidator />
                        <div class="grid gap-3 sm:grid-cols-[1fr_auto] sm:items-start">
                            <Field Label="Name">
                                <InputText @bind-Value="NewBoard.Name" required class="ui-input" placeholder="e.g. Q3 launch" />
                                <ValidationMessage For="() => NewBoard.Name" />
                            </Field>
                            <Field Label="Workspace">
                                <InputSelect @bind-Value="NewBoard.WorkspaceId" class="ui-select min-w-[11rem]">
                                    @foreach (var workspace in _workspaces)
                                    {
                                        <option value="@workspace.Id">@workspace.Name</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="() => NewBoard.WorkspaceId" />
                            </Field>
                        </div>
                        <Button Type="submit" Class="mt-4" IconStart="IconName.Plus">Create board</Button>
                    </EditForm>
                </section>
            }

            @if (CanManageMembers)
            {
                <section class="ui-card p-5" aria-labelledby="invite-title">
                    <h2 id="invite-title" class="ui-card-title">Invite someone</h2>
                    <p class="mt-0.5 text-sm text-ink-soft">They get a one-time link to set a password.</p>
                    <EditForm Model="Invite" FormName="invite" method="post" OnValidSubmit="InviteAsync" class="mt-4">
                        <DataAnnotationsValidator />
                        <div class="grid gap-3 sm:grid-cols-[1fr_auto] sm:items-start">
                            <Field Label="Email">
                                <InputText @bind-Value="Invite.Email" type="email" required class="ui-input" placeholder="name@company.com" />
                                <ValidationMessage For="() => Invite.Email" />
                            </Field>
                            <Field Label="Role">
                                <InputSelect @bind-Value="Invite.Role" class="ui-select min-w-[9rem]">
                                    <option value="@TenantRole.Member">Member</option>
                                    <option value="@TenantRole.Viewer">Viewer</option>
                                    <option value="@TenantRole.Guest">Guest</option>
                                </InputSelect>
                                <ValidationMessage For="() => Invite.Role" />
                            </Field>
                        </div>
                        <Button Type="submit" Variant="ButtonVariant.Secondary" Class="mt-4" IconStart="IconName.Users">Send invite</Button>
                    </EditForm>
                </section>
            }
        </div>
    }
</div>

@code {
    private IReadOnlyList<BoardCard> _boards = [];
    private IReadOnlyList<WorkspaceChoice> _workspaces = [];
    private string? _notice;
    private string? _error;

    [SupplyParameterFromForm(FormName = "create-board")]
    private NewBoardInput NewBoard { get; set; } = new();

    [SupplyParameterFromForm(FormName = "invite")]
    private InviteInput Invite { get; set; } = new();

    private bool CanCreate => Tenant.Role is { } role && PermissionSnapshot.For(role).Can(Capability.CreateBoard);

    private bool CanManageMembers => Tenant.Role is { } role && PermissionSnapshot.For(role).Can(Capability.ManageMembers);

    protected override async Task OnInitializedAsync()
    {
        if (Tenant.UserId is not { } userId || Tenant.Role is not { } role || Tenant.TenantId is not { } tenantId)
        {
            return;
        }

        _boards = await Queries.GetVisibleBoardsAsync(userId, role);
        _workspaces = await Queries.GetWorkspaceChoicesAsync();
    }

    private async Task CreateBoardAsync()
    {
        _error = null;
        _notice = null;

        if (Tenant.UserId is not { } userId || Tenant.TenantId is not { } tenantId || !CanCreate)
        {
            _error = "Your role cannot create boards.";
            return;
        }

        if (!_workspaces.Any(workspace => workspace.Id == NewBoard.WorkspaceId))
        {
            _error = "Choose a workspace you can see.";
            return;
        }

        var board = Tuesday.Domain.Workspaces.Board.Create(
            tenantId,
            NewBoard.WorkspaceId,
            NewBoard.Name,
            Tuesday.Domain.Workspaces.BoardType.Main,
            userId);

        Db.Boards.Add(board);

        // A board with no groups, columns or view renders "no items yet" and cannot accept work —
        // which is what a fresh Production install hit. Give every new board a usable skeleton.
        Db.ItemGroups.AddRange(
            Tuesday.Domain.Boards.ItemGroup.Create(tenantId, board.Id, "Backlog", "slate", 0),
            Tuesday.Domain.Boards.ItemGroup.Create(tenantId, board.Id, "In progress", "amber", 1),
            Tuesday.Domain.Boards.ItemGroup.Create(tenantId, board.Id, "Done", "teal", 2));

        Db.BoardColumns.AddRange(
            Tuesday.Domain.Boards.BoardColumn.Create(tenantId, board.Id, "status", "Status",
                Tuesday.Domain.Boards.ColumnType.Status, 0,
                """{"labels":["Not started","Working on it","Stuck","Done"]}"""),
            Tuesday.Domain.Boards.BoardColumn.Create(tenantId, board.Id, "owner", "Owner",
                Tuesday.Domain.Boards.ColumnType.People, 1),
            Tuesday.Domain.Boards.BoardColumn.Create(tenantId, board.Id, "due", "Due date",
                Tuesday.Domain.Boards.ColumnType.Date, 2),
            Tuesday.Domain.Boards.BoardColumn.Create(tenantId, board.Id, "notes", "Notes",
                Tuesday.Domain.Boards.ColumnType.Text, 3));

        Db.BoardViews.Add(Tuesday.Domain.Views.BoardView.Create(
            tenantId, board.Id, "Main table", Tuesday.Domain.Views.ViewType.Grid, 0));

        Db.AuditEntries.Add(Tuesday.Domain.Auditing.AuditEntry.Record(
            tenantId, userId, "board.created", nameof(Tuesday.Domain.Workspaces.Board), board.Id.ToString(), board.Name));

        await Db.SaveChangesAsync();

        _notice = $"Board \"{board.Name}\" created.";
        NewBoard = new();

        if (Tenant.Role is { } role)
        {
            _boards = await Queries.GetVisibleBoardsAsync(userId, role);
        }
    }

    private async Task InviteAsync()
    {
        _error = null;
        _notice = null;

        if (Tenant.UserId is not { } actorId || Tenant.TenantId is not { } tenantId || !CanManageMembers)
        {
            _error = "Your role cannot invite people.";
            return;
        }

        var email = Invite.Email.Trim().ToLowerInvariant();
        var user = await Users.FindByEmailAsync(email);

        if (user is null)
        {
            user = new ApplicationUser
            {
                UserName = email,
                Email = email,
                EmailConfirmed = true,
                DisplayName = email.Split('@')[0]
            };

            // A password nobody knows, replaced when the invitation is accepted. The account is
            // created now so the membership and the audit trail point at a real user id.
            var placeholder = Guid.NewGuid().ToString("N") + "!Aa1";
            var created = await Users.CreateAsync(user, placeholder);
            if (!created.Succeeded)
            {
                _error = string.Join("; ", created.Errors.Select(error => error.Description));
                return;
            }
        }

        var existing = await Resolver.HasMembershipAsync(tenantId, user.Id);

        if (existing)
        {
            _notice = $"{email} is already in this tenant.";
            return;
        }

        Db.Memberships.Add(Tuesday.Domain.Tenancy.Membership.Create(tenantId, user.Id, Invite.Role));
        Db.AuditEntries.Add(Tuesday.Domain.Auditing.AuditEntry.Record(
            tenantId, actorId, "membership.invited", nameof(Tuesday.Domain.Tenancy.Membership), user.Id.ToString(), Invite.Role.ToString()));

        await Db.SaveChangesAsync();

        var (invitation, token) = Tuesday.Domain.Tenancy.Invite.Create(tenantId, email, Invite.Role, actorId);
        Db.Invites.Add(invitation);
        await Db.SaveChangesAsync();

        var link = $"{Nav.BaseUri}invite/{token}";

        await Email.SendAsync(
            email,
            "You're invited to Tuesday.com",
            $"<p>Set your password to join: <a href=\"{link}\">{link}</a></p><p>The link works once and expires in "
            + $"{Tuesday.Domain.Tenancy.Invite.LifetimeDays} days.</p>");

        Logger.LogInformation("Invited {Email} as {Role}.", email, Invite.Role);

        _notice = EmailOptions.Value.Enabled
            ? $"{email} added as {Invite.Role}. Invitation emailed."
            : $"{email} added as {Invite.Role}. Share this one-time link: {link}";

        Invite = new();
    }

    public sealed class NewBoardInput
    {
        [System.ComponentModel.DataAnnotations.Required, System.ComponentModel.DataAnnotations.StringLength(200)]
        public string Name { get; set; } = string.Empty;

        public Guid WorkspaceId { get; set; }
    }

    public sealed class InviteInput
    {
        [System.ComponentModel.DataAnnotations.Required, System.ComponentModel.DataAnnotations.EmailAddress]
        public string Email { get; set; } = string.Empty;

        public TenantRole Role { get; set; } = TenantRole.Viewer;
    }
}
