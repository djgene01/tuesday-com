@page "/search"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Tuesday.Application.Tenancy
@using Tuesday.Infrastructure.Collaboration
@using Tuesday.Infrastructure.Queries
@using Tuesday.Web.Security
@attribute [Authorize]
@inject WorkspaceQueries Boards
@inject SearchService Finder
@inject ITenantContext Tenant
@inject TenantContextBootstrapper Bootstrapper

<PageTitle>Search — Tuesday.com</PageTitle>

<div class="mx-auto max-w-[900px]">
    <PageHeader Title="Search" Eyebrow="Everything you can see" />

    <form class="flex gap-2" method="get" action="/search" role="search">
        <label class="relative block flex-1">
            <span class="sr-only">Search items and updates</span>
            <span class="pointer-events-none absolute inset-y-0 left-3 grid place-items-center text-ink-soft" aria-hidden="true">
                <Icon Name="IconName.Search" Class="h-4 w-4" />
            </span>
            <input type="search" name="q" value="@Query" placeholder="Item names and update text" autofocus
                   class="ui-input ui-input-lg pl-9" />
        </label>
        <Button Type="submit" Size="ButtonSize.Lg">Search</Button>
    </form>

    @if (string.IsNullOrWhiteSpace(Query))
    {
        <EmptyState Title="Search your boards" IconName="IconName.Search" Bare="true" Compact="true" Class="mt-6">
            Search runs over the boards you can open — item names first, then what people wrote.
        </EmptyState>
    }
    else if (_hits is null)
    {
        <div class="ui-card mt-6 p-4"><Skeleton Lines="4" /></div>
    }
    else if (_hits.Count == 0)
    {
        <EmptyState Title="@($"Nothing matches “{Query}”")" IconName="IconName.Search" Compact="true" Class="mt-6">
            Try fewer words, or check the spelling. Only boards shared with you are searched.
        </EmptyState>
    }
    else
    {
        <p class="m-0 mt-5 text-xs text-ink-soft" role="status">@_hits.Count result@(_hits.Count == 1 ? string.Empty : "s") for “@Query”</p>
        <ul class="ui-card m-0 mt-2 list-none divide-y divide-line overflow-hidden p-0">
            @foreach (var hit in _hits)
            {
                <li class="relative flex flex-wrap items-center gap-x-3 gap-y-1 px-4 py-3 transition hover:bg-surface-2">
                    <span class="ui-pill @(hit.Kind == "update" ? "ui-pill-brand" : "ui-pill-neutral")">@(hit.Kind == "update" ? "Update" : "Item")</span>
                    <a class="text-sm font-medium text-ink no-underline after:absolute after:inset-0 hover:text-brand-ink hover:underline" href="@LinkFor(hit)">@hit.Title</a>
                    <span class="flex items-center gap-1 text-xs text-ink-soft">
                        <Icon Name="IconName.Board" Class="h-3.5 w-3.5" />@hit.BoardName
                    </span>
                    @if (hit.Kind == "update")
                    {
                        <p class="m-0 w-full text-xs text-ink-soft">@hit.Snippet</p>
                    }
                </li>
            }
        </ul>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "q")]
    public string? Query { get; set; }

    private IReadOnlyList<SearchHit>? _hits;

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrWhiteSpace(Query))
        {
            _hits = null;
            return;
        }

        await Bootstrapper.EnsureResolvedAsync();

        if (Tenant.UserId is not { } userId || Tenant.Role is not { } role)
        {
            _hits = [];
            return;
        }

        var boards = await Boards.GetVisibleBoardsAsync(userId, role);
        _hits = await Finder.SearchAsync(boards.Select(board => board.Id).ToList(), Query);
    }

    private static string LinkFor(SearchHit hit) => hit.ItemId is { } itemId
        ? $"/board/{hit.BoardId:D}/item/{itemId:D}"
        : $"/board/{hit.BoardId:D}";
}
