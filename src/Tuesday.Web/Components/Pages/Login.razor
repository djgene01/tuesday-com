@page "/login"
@layout EmptyLayout
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Tuesday.Infrastructure.Identity
@attribute [AllowAnonymous]
@inject SignInManager<ApplicationUser> SignInManager
@inject NavigationManager Navigation
@inject IHostEnvironment Environment

<PageTitle>Sign in — Tuesday.com</PageTitle>

<a class="skip-link" href="#main">Skip to content</a>

<main id="main" class="flex min-h-screen items-center justify-center bg-canvas px-4 py-10 font-sans">
    <section class="w-full max-w-[400px]">
        <div class="mb-6 flex items-center justify-center gap-2">
            <span class="grid h-9 w-9 place-items-center rounded-control bg-brand font-display text-base font-bold text-white" aria-hidden="true">T</span>
            <span class="font-display text-lg font-semibold tracking-tight text-ink">Tuesday<span class="text-brand">.</span>com</span>
        </div>

        <div class="rounded-card border border-line bg-surface p-7 shadow-card">
            @if (_requiresTwoFactor)
            {
                <span class="mb-3 grid h-10 w-10 place-items-center rounded-full bg-brand-wash text-brand-ink" aria-hidden="true">
                    <Icon Name="IconName.Shield" Class="h-5 w-5" />
                </span>
            }
            <h1 class="m-0 font-display text-xl font-semibold tracking-tight text-ink">
                @(_requiresTwoFactor ? "Two-step verification" : "Sign in")
            </h1>
            <p class="m-0 mt-1 text-sm text-ink-soft">
                @(_requiresTwoFactor
                    ? "Enter the six-digit code from your authenticator app."
                    : "Use your work account. Access is scoped to your tenant and role.")
            </p>

            @if (_error is not null)
            {
                <Alert Kind="AlertKind.Error" Class="mt-4">@_error</Alert>
            }

            @if (!_requiresTwoFactor)
            {
                <EditForm Model="Credentials" FormName="login" method="post" OnValidSubmit="SignInAsync" class="mt-5 space-y-4">
                    <DataAnnotationsValidator />

                    <Field Label="Email">
                        <InputText @bind-Value="Credentials.Email" type="email" autocomplete="username" required class="ui-input ui-input-lg" />
                        <ValidationMessage For="() => Credentials.Email" />
                    </Field>

                    <Field Label="Password">
                        <InputText @bind-Value="Credentials.Password" type="password" autocomplete="current-password" required class="ui-input ui-input-lg" />
                        <ValidationMessage For="() => Credentials.Password" />
                    </Field>

                    <Button Type="submit" Size="ButtonSize.Lg" Block="true" Class="mt-1">Sign in</Button>
                </EditForm>
            }
            else
            {
                @* A plain form: the code is submitted once to its own endpoint, which never
                   renders it back. EditForm is not used for this step. *@
                <form method="post" action="/login/totp" name="totp" class="mt-5 space-y-4">
                    <AntiforgeryToken />

                    <Field Label="Authenticator code" Hint="The code changes every 30 seconds.">
                        <input type="text" name="code" inputmode="numeric" autocomplete="one-time-code" maxlength="7" required
                               autofocus class="ui-input ui-input-code" />
                    </Field>

                    <Button Type="submit" Size="ButtonSize.Lg" Block="true">Verify</Button>
                    <a class="block text-center text-sm text-ink-soft no-underline hover:text-ink hover:underline" href="/login">Use a different account</a>
                </form>
            }
        </div>

        @if (Environment.IsDevelopment())
        {
            @* Seeded demo accounts exist only in Development, so the hint does too. *@
            <p class="mt-4 text-center text-2xs leading-relaxed text-ink-soft">
                Development accounts: admin@@, member@@, viewer@@, guest@@tuesday.local — password <code class="rounded bg-surface-2 px-1 py-0.5 text-ink">Tuesday!Demo1</code>.
            </p>
        }
    </section>
</main>

@code {
    private string? _error;
    private bool _requiresTwoFactor;

    [SupplyParameterFromForm(FormName = "login")]
    private LoginForm Credentials { get; set; } = new();

    [CascadingParameter]
    private HttpContext? Http { get; set; }

    protected override void OnInitialized()
    {
        // The password step redirects here with step=totp once Identity reports a pending
        // second factor; the pending user rides in its own identity cookie.
        _requiresTwoFactor = Http?.Request.Query["step"].ToString() == "totp";

        _error = Http?.Request.Query["error"].ToString() switch
        {
            "code" => "That code was not accepted. Check the clock on your device.",
            "locked" => "This account is temporarily locked after repeated failures.",
            "empty" => "Enter the code from your authenticator app.",
            _ => null
        };
    }

    private async Task SignInAsync()
    {
        _error = null;

        if (string.IsNullOrWhiteSpace(Credentials.Email) || string.IsNullOrEmpty(Credentials.Password))
        {
            _error = "Enter your email and password.";
            return;
        }

        var result = await SignInManager.PasswordSignInAsync(
            Credentials.Email.Trim(),
            Credentials.Password,
            isPersistent: true,
            lockoutOnFailure: true);

        if (result.Succeeded)
        {
            Navigation.NavigateTo("/workspace", forceLoad: true);
            return;
        }

        if (result.RequiresTwoFactor)
        {
            Navigation.NavigateTo("/login?step=totp", forceLoad: true);
            return;
        }

        _error = result.IsLockedOut
            ? "This account is temporarily locked after repeated failures."
            : "Email or password is incorrect.";
    }

    public sealed class LoginForm
    {
        [System.ComponentModel.DataAnnotations.Required]
        public string Email { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        public string Password { get; set; } = string.Empty;
    }
}
