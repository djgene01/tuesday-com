@page "/"
@layout MarketingLayout
@using Microsoft.Extensions.Diagnostics.HealthChecks
@inject HealthCheckService HealthChecks
@inject IHostEnvironment Environment

<PageTitle>Tuesday.com — the work operating system you can own</PageTitle>

@* The public home. Composition follows the shape a buyer expects from a work platform — hero,
   proof strip, use-case grid, alternating feature rows, closing call to action — while every claim
   on the page is something this repository actually does. Nothing is borrowed from another
   product's copy or assets. *@

<section class="relative overflow-hidden">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 -top-40 z-0 mx-auto hidden max-w-[1100px] justify-between sm:flex">
        <div class="blob h-[420px] w-[420px] bg-sage"></div>
        <div class="blob mt-24 h-[360px] w-[360px] bg-lavender" style="animation-delay:1.8s"></div>
        <div class="blob mt-10 h-[280px] w-[280px] bg-brand-tint" style="animation-delay:3s"></div>
    </div>

    <div class="relative z-10 mx-auto max-w-[1180px] px-5 pt-16 sm:pt-24">
        <div class="reveal mx-auto max-w-[860px] text-center">
            <p class="inline-flex items-center gap-2 rounded-full border border-line bg-surface/70 px-3 py-1 text-[11px] font-medium uppercase tracking-[0.12em] text-brand-ink">
                <span class="h-1.5 w-1.5 rounded-full bg-brand" aria-hidden="true"></span>
                Work operating system
            </p>

            <h1 class="mt-6 font-display text-[clamp(2.9rem,7vw,5.5rem)] font-medium leading-[0.98] tracking-[-0.03em] text-ink">
                Get complex work done,<br class="hidden sm:block" />
                <span class="font-hand text-[clamp(3.2rem,8vw,6rem)] leading-[0.9] text-brand-ink">without the busywork.</span>
            </h1>

            <p class="mx-auto mt-6 max-w-[620px] text-[16px] leading-relaxed text-ink-soft">
                Boards with typed columns, five ways to see the same data, threaded updates and
                multi-step automations — in one application you run on your own server, under the MIT licence.
            </p>

            <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
                <a class="ui-btn-primary !h-11 !px-6 text-[14px]" href="/workspace">Get started free</a>
                <a class="ui-btn-ghost !h-11 !px-6 text-[14px]" href="#context">See how it works</a>
            </div>

            <p class="mt-4 text-[12px] text-ink-faint">
                No credit card. No seats to negotiate. One container, one database.
            </p>
        </div>

        <figure class="reveal relative mt-14">
            <img src="/img/hero-board.png" width="1536" height="1024" loading="eager" decoding="async"
                 alt="Abstract illustration of a work board built from soft pastel cards"
                 style="height:auto;aspect-ratio:3 / 2" class="mx-auto w-full max-w-[1040px] rounded-[2.5rem] border border-line object-cover object-center shadow-[var(--shadow-card)]" />

            @* Floating proof cards, positioned over the artwork the way a product shot would be. *@
            <figcaption class="mx-auto mt-6 flex max-w-[900px] flex-wrap justify-center gap-3 px-2">
                <span class="rounded-[1.4rem] border border-line bg-surface/95 px-4 py-2 text-[12px] font-medium text-ink shadow-[var(--shadow-card)]">5 views, one dataset</span>
                <span class="rounded-[1.4rem] border border-line bg-surface/95 px-4 py-2 text-[12px] font-medium text-ink shadow-[var(--shadow-card)]">Typed columns</span>
                <span class="rounded-[1.4rem] border border-line bg-surface/95 px-4 py-2 text-[12px] font-medium text-ink shadow-[var(--shadow-card)]">Multi-step automations</span>
                <span class="rounded-[1.4rem] border border-line bg-surface/95 px-4 py-2 text-[12px] font-medium text-ink shadow-[var(--shadow-card)]">Signed API + MCP</span>
            </figcaption>
        </figure>
    </div>
</section>

<section class="mx-auto mt-24 max-w-[1180px] px-5">
    <figure class="reveal">
        <img src="/img/product-board.png" width="1344" height="840" loading="lazy" decoding="async"
             alt="A Tuesday.com board with grouped rows and typed columns in the table view"
             style="height:auto;aspect-ratio:16 / 10" class="w-full rounded-[2.5rem] border border-line object-cover object-top shadow-[var(--shadow-card)]" />
        <figcaption class="mt-3 px-1 text-[12px] text-ink-faint">
            A real board from this build — grouped rows, typed columns, five views. Not a mockup.
        </figcaption>
    </figure>
</section>

<section id="status" class="mx-auto mt-20 max-w-[1180px] px-5" aria-labelledby="status-title">
    <div class="reveal flex flex-wrap items-center gap-x-6 gap-y-3 rounded-[2rem] border border-line bg-surface px-6 py-4">
        <h2 id="status-title" class="text-[13px] font-semibold text-ink">Live status</h2>
        <span class="ui-pill @(_report.Status == HealthStatus.Healthy ? "bg-sage text-[#2f5d43]" : "bg-brand-tint text-ink")">
            @_report.Status
        </span>
        @foreach (var entry in _report.Entries)
        {
            <span class="inline-flex items-center gap-1.5 text-[12px] text-ink-soft">
                <span class="h-1.5 w-1.5 rounded-full @(entry.Value.Status == HealthStatus.Healthy ? "bg-status-done" : entry.Value.Status == HealthStatus.Degraded ? "bg-status-working" : "bg-status-stuck")"
                      aria-hidden="true"></span>
                @entry.Key
            </span>
        }
        <span class="ml-auto text-[11px] text-ink-faint">checked @_checkedAt.ToString("HH:mm:ss") UTC</span>
    </div>
</section>

<section id="teams" class="mx-auto mt-24 max-w-[1180px] px-5" aria-labelledby="teams-title">
    <div class="reveal max-w-[640px]">
        <p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-brand-ink">One workspace</p>
        <h2 id="teams-title" class="mt-2 font-display text-[clamp(1.9rem,3.6vw,2.75rem)] font-medium leading-[1.05] tracking-[-0.025em] text-ink">
            A board for every team,<br />sharing the same people and data.
        </h2>
        <p class="mt-4 text-[15px] leading-relaxed text-ink-soft">
            Create a board and it arrives with groups, typed columns and a view — so the first thing
            you do is add work, not configure a grid.
        </p>
    </div>

    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        @foreach (var card in Cards)
        {
            <a class="reveal group flex h-full flex-col rounded-[2rem] border border-line bg-surface p-6 no-underline transition hover:-translate-y-0.5 hover:shadow-[var(--shadow-card)]"
               href="/workspace">
                <span class="grid h-11 w-11 place-items-center rounded-[1.1rem] text-[18px]" style="background:@card.Tint" aria-hidden="true">@card.Glyph</span>
                <h3 class="mt-5 text-[16px] font-semibold text-ink">@card.Title</h3>
                <p class="mt-1.5 text-[13px] leading-relaxed text-ink-soft">@card.Body</p>
                <span class="mt-auto pt-4 text-[12px] font-medium text-brand-ink group-hover:underline">Open the board →</span>
            </a>
        }
    </div>
</section>

<section id="context" class="mx-auto mt-28 max-w-[1180px] px-5">
    <div class="reveal grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
        <div>
            <p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-brand-ink">Work in context</p>
            <h2 class="mt-2 font-display text-[clamp(1.9rem,3.4vw,2.6rem)] font-medium leading-[1.05] tracking-[-0.025em] text-ink">
                The conversation lives next to the work.
            </h2>
            <p class="mt-4 max-w-[460px] text-[15px] leading-relaxed text-ink-soft">
                Every item carries its own thread. Replies, edits and automation runs are recorded
                beside the row they belong to, so the history is never in someone's inbox.
            </p>
            <ul class="mt-6 space-y-3 text-[14px] text-ink-soft">
                <li class="flex gap-3"><span class="mt-1.5 h-1.5 w-1.5 flex-none rounded-full bg-brand" aria-hidden="true"></span>Threaded updates with likes and mentions</li>
                <li class="flex gap-3"><span class="mt-1.5 h-1.5 w-1.5 flex-none rounded-full bg-brand" aria-hidden="true"></span>Sub-items that inherit their parent's people</li>
                <li class="flex gap-3"><span class="mt-1.5 h-1.5 w-1.5 flex-none rounded-full bg-brand" aria-hidden="true"></span>Five views — table, kanban, calendar, timeline and chart</li>
            </ul>
        </div>

        <img src="/img/feature-context.png" width="1024" height="1024" loading="lazy" decoding="async"
             alt="Abstract illustration of stacked translucent panels in sage and lavender light"
             style="height:auto;aspect-ratio:1 / 1" class="w-full rounded-[2.5rem] border border-line object-cover shadow-[var(--shadow-card)]" />
    </div>
</section>

<section class="mx-auto mt-28 max-w-[1180px] px-5">
    <div class="reveal rounded-[2.5rem] border border-line bg-sage/50 p-8 sm:p-12">
        <div class="grid gap-10 lg:grid-cols-[1.1fr_1fr]">
            <div>
                <p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-brand-ink">Automations</p>
                <h2 class="mt-2 font-display text-[clamp(1.9rem,3.4vw,2.6rem)] font-medium leading-[1.05] tracking-[-0.025em] text-ink">
                    Let the boring parts move themselves.
                </h2>
                <p class="mt-4 max-w-[480px] text-[15px] leading-relaxed text-ink-soft">
                    A rule can run several actions in order. Each step is attempted on its own, a
                    failing step is recorded rather than swallowed, and a depth guard stops two rules
                    from bouncing a status back and forth forever.
                </p>
            </div>

            <div class="space-y-3">
                <div class="rounded-[1.5rem] border border-line bg-surface p-4">
                    <p class="text-[11px] font-semibold uppercase tracking-[0.08em] text-ink-faint">When status becomes</p>
                    <p class="mt-1 text-[15px] font-medium text-ink">Done</p>
                </div>
                <div class="rounded-[1.5rem] border border-line bg-surface p-4">
                    <p class="text-[11px] font-semibold uppercase tracking-[0.08em] text-ink-faint">Then, in order</p>
                    <ol class="mt-2 space-y-1.5 text-[14px] text-ink-soft">
                        <li>1 — notify the owner</li>
                        <li>2 — set the due date to +7 days</li>
                        <li>3 — post an update on the item</li>
                    </ol>
                </div>
                <p class="pl-1 text-[12px] text-ink-faint">Steps 1–10 · loop guard at depth 3 · runs recorded</p>
            </div>
        </div>
    </div>
</section>

<section id="run" class="mx-auto mt-28 max-w-[1180px] overflow-x-hidden px-5">
    <div class="reveal grid grid-cols-1 gap-10 lg:grid-cols-2 lg:items-center">
        <div class="order-2 min-w-0 lg:order-1">
            <div class="min-w-0 rounded-[2.5rem] border border-line bg-surface p-6 shadow-[var(--shadow-card)]">
                <pre class="max-w-full whitespace-pre-wrap break-words text-[12.5px] leading-relaxed text-ink-soft"><code>docker compose -f docker/compose.release.yaml up -d

# first start applies every migration and creates
# the first admin from Bootstrap__AdminEmail
curl -fsS http://your-host:8080/health/ready</code></pre>
            </div>
            <p class="mt-3 pl-1 text-[12px] text-ink-faint">PostgreSQL 17 · Redis 7 · one application container</p>
        </div>

        <div class="order-1 min-w-0 lg:order-2">
            <p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-brand-ink">Run it yourself</p>
            <h2 class="mt-2 font-display text-[clamp(1.9rem,3.4vw,2.6rem)] font-medium leading-[1.05] tracking-[-0.025em] text-ink">
                Your data stays on your hardware.
            </h2>
            <p class="mt-4 max-w-[460px] text-[15px] leading-relaxed text-ink-soft">
                No vendor workspace holding your rows, no seat count to negotiate. Back up a dump,
                restore it into a fresh volume, and the invited people can still sign in — that
                restore is rehearsed, not assumed.
            </p>
            <div class="mt-6 flex flex-wrap gap-3">
                <a class="ui-btn-ghost !h-10 !px-5 text-[13px]" href="/health/ready">Readiness probe</a>
                <a class="ui-btn-ghost !h-10 !px-5 text-[13px]" href="/openapi/v1.json">OpenAPI document</a>
                <a class="ui-btn-ghost !h-10 !px-5 text-[13px]" href="/.well-known/openid-configuration">OIDC discovery</a>
            </div>
        </div>
    </div>
</section>

<section class="mx-auto mt-28 max-w-[1180px] px-5">
    <div class="reveal relative overflow-hidden rounded-[3rem] border border-line bg-lavender/60 px-6 py-14 text-center sm:px-12">
        <img src="/img/cta-team.png" width="1024" height="768" loading="lazy" decoding="async" alt=""
             style="height:auto;aspect-ratio:4 / 3" class="pointer-events-none mx-auto mb-8 w-[220px] rounded-[2rem] object-cover" aria-hidden="true" />
        <h2 class="mx-auto max-w-[620px] font-display text-[clamp(2rem,4vw,3rem)] font-medium leading-[1.02] tracking-[-0.03em] text-ink">
            Start with one board.<br />
            <span class="font-hand text-[clamp(2.2rem,4.6vw,3.4rem)] text-brand-ink">Grow it when it earns it.</span>
        </h2>
        <p class="mx-auto mt-4 max-w-[480px] text-[14px] leading-relaxed text-ink-soft">
            The whole product is in this repository under the MIT licence. Fork it, audit it, run it
            for a team of four or a department of four hundred.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
            <a class="ui-btn-primary !h-11 !px-6 text-[14px]" href="/workspace">Open your workspace</a>
            <a class="ui-btn-ghost !h-11 !px-6 text-[14px]" href="/login">Sign in</a>
        </div>
    </div>
</section>

<section class="mx-auto mt-16 max-w-[1180px] px-5">
    <details class="reveal group rounded-[2rem] border border-line bg-surface">
        <summary class="flex cursor-pointer list-none items-center gap-2 px-6 py-4 text-[13px] font-medium text-ink-soft marker:hidden">
            <span class="inline-block text-[10px] transition-transform group-open:rotate-90" aria-hidden="true">▸</span>
            System details
            <span class="ml-1 text-ink-faint">— runtime, start time, probe endpoints</span>
        </summary>

        <div class="grid gap-4 border-t border-line px-6 py-4 sm:grid-cols-2">
            <div>
                <h3 class="mb-2 text-[11px] font-semibold uppercase tracking-[0.08em] text-ink-faint">Runtime</h3>
                <dl class="space-y-1 text-[12px]">
                    <div class="flex justify-between gap-3"><dt class="text-ink-soft">Environment</dt><dd class="text-ink">@Environment.EnvironmentName</dd></div>
                    <div class="flex justify-between gap-3"><dt class="text-ink-soft">Runtime</dt><dd class="text-ink">@System.Runtime.InteropServices.RuntimeInformation.FrameworkDescription</dd></div>
                    <div class="flex justify-between gap-3"><dt class="text-ink-soft">Started</dt><dd class="text-ink">@_startedAt.ToString("yyyy-MM-dd HH:mm:ss") UTC</dd></div>
                </dl>
            </div>

            <div>
                <h3 class="mb-2 text-[11px] font-semibold uppercase tracking-[0.08em] text-ink-faint">Probes</h3>
                <div class="flex flex-col gap-2 text-[12px]">
                    <a class="flex items-center justify-between gap-3 rounded-[1rem] border border-line px-3 py-1.5 text-ink no-underline hover:border-line-strong hover:bg-canvas"
                       href="/health/ready"><span>Readiness</span><code class="text-ink-soft">/health/ready</code></a>
                    <a class="flex items-center justify-between gap-3 rounded-[1rem] border border-line px-3 py-1.5 text-ink no-underline hover:border-line-strong hover:bg-canvas"
                       href="/health/live"><span>Liveness</span><code class="text-ink-soft">/health/live</code></a>
                </div>
            </div>
        </div>
    </details>
</section>

@code {
    private HealthReport _report = new(new Dictionary<string, HealthReportEntry>(), TimeSpan.Zero);
    private readonly DateTimeOffset _startedAt = DateTimeOffset.UtcNow;
    private DateTimeOffset _checkedAt = DateTimeOffset.UtcNow;

    protected override async Task OnInitializedAsync()
    {
        _report = await HealthChecks.CheckHealthAsync().ConfigureAwait(false);
        _checkedAt = DateTimeOffset.UtcNow;
    }

    private sealed record Card(string Glyph, string Title, string Body, string Tint);

    private static readonly Card[] Cards =
    [
        new("◎", "Projects & delivery", "Plans, milestones and risks on one board, with a timeline view that travels.", "#E8EFE8"),
        new("✳", "Marketing", "Campaigns and creative requests, reviewed in the same place the work lives.", "#FFB7B2"),
        new("◈", "Operations", "Repeatable processes with automations that fire on status changes.", "#EFEDF4"),
        new("⌘", "IT & support", "Tickets with typed columns, owners and due dates — and an API to feed them.", "#E8EFE8"),
        new("◍", "Hiring", "Roles, candidates and interviews, kept out of a spreadsheet.", "#EFEDF4"),
        new("↗", "Sales pipeline", "Deals as rows, stages as groups, follow-ups as automations.", "#FFB7B2")
    ];
}
