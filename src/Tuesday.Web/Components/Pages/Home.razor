@page "/"
@using Microsoft.Extensions.Diagnostics.HealthChecks
@inject HealthCheckService HealthChecks
@inject IHostEnvironment Environment

<PageTitle>Tuesday.com — a work operating system you can run yourself</PageTitle>

<main class="mx-auto max-w-[1040px] py-6">
    <section class="mb-10 max-w-[640px]">
        <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-brand-ink">Work operating system</p>
        <h1 class="mt-2 font-display text-[42px] font-semibold leading-[1.08] tracking-[-0.03em] text-ink">
            Every board, view and conversation<br />in one place.
        </h1>
        <p class="mt-4 text-[15px] leading-relaxed text-ink-soft">
            Boards with typed columns, five ways to look at the same data, threaded updates,
            automations and a signed API — running on your own infrastructure.
        </p>
        <div class="mt-6 flex flex-wrap items-center gap-2">
            <a class="ui-btn-primary !h-10 !px-5" href="/workspace">Open your workspace</a>
            <a class="ui-btn-ghost !h-10 !px-5" href="/login">Sign in</a>
        </div>
    </section>

    @* A single strip answers "is it up?" at a glance; the ops detail lives behind a disclosure so
       the page reads as one product rather than a marketing page with a debug panel stapled on. *@
    <section class="mb-6 flex flex-wrap items-center gap-x-5 gap-y-2 rounded-card border border-line bg-surface px-4 py-3"
             aria-labelledby="deps">
        <h2 id="deps" class="font-display text-[13px] font-semibold text-ink">Live status</h2>
        <span class="ui-pill @(_report.Status == HealthStatus.Healthy ? "bg-status-done/15 text-[#00663f]" : "bg-status-working/20 text-[#8a4b00]")">
            @_report.Status
        </span>
        @foreach (var entry in _report.Entries)
        {
            <span class="inline-flex items-center gap-1.5 text-[12px] text-ink-soft">
                <span class="h-1.5 w-1.5 rounded-full @(entry.Value.Status == HealthStatus.Healthy ? "bg-status-done" : entry.Value.Status == HealthStatus.Degraded ? "bg-status-working" : "bg-status-stuck")"
                      aria-hidden="true"></span>
                @entry.Key
            </span>
        }
        <span class="ml-auto text-[11px] text-ink-faint">checked @_checkedAt.ToString("HH:mm:ss") UTC</span>
    </section>

    <details class="group rounded-card border border-line bg-surface">
        <summary class="flex cursor-pointer list-none items-center gap-1.5 px-4 py-3 text-[12px] font-medium text-ink-soft marker:hidden">
            <span class="inline-block text-[10px] transition-transform group-open:rotate-90" aria-hidden="true">▸</span>
            System details
            <span class="ml-1 text-ink-faint">— runtime, start time, probe endpoints</span>
        </summary>

        <div class="grid gap-4 border-t border-line px-4 py-3 sm:grid-cols-2">
            <div>
                <h3 class="mb-2 text-[11px] font-semibold uppercase tracking-[0.08em] text-ink-faint">Runtime</h3>
                <dl class="space-y-1 text-[12px]">
                    <div class="flex justify-between gap-3"><dt class="text-ink-soft">Environment</dt><dd class="text-ink">@Environment.EnvironmentName</dd></div>
                    <div class="flex justify-between gap-3"><dt class="text-ink-soft">Runtime</dt><dd class="text-ink">@System.Runtime.InteropServices.RuntimeInformation.FrameworkDescription</dd></div>
                    <div class="flex justify-between gap-3"><dt class="text-ink-soft">Started</dt><dd class="text-ink">@_startedAt.ToString("yyyy-MM-dd HH:mm:ss") UTC</dd></div>
                </dl>
            </div>

            <div>
                <h3 class="mb-2 text-[11px] font-semibold uppercase tracking-[0.08em] text-ink-faint">Probes</h3>
                <div class="flex flex-col gap-2 text-[12px]">
                    <a class="flex items-center justify-between gap-3 rounded-control border border-line px-3 py-1.5 text-ink no-underline hover:border-line-strong hover:bg-canvas"
                       href="/health/ready"><span>Readiness</span><code class="text-ink-soft">/health/ready</code></a>
                    <a class="flex items-center justify-between gap-3 rounded-control border border-line px-3 py-1.5 text-ink no-underline hover:border-line-strong hover:bg-canvas"
                       href="/health/live"><span>Liveness</span><code class="text-ink-soft">/health/live</code></a>
                </div>
            </div>
        </div>
    </details>
</main>

@code {
    private HealthReport _report = new(new Dictionary<string, HealthReportEntry>(), TimeSpan.Zero);
    private readonly DateTimeOffset _startedAt = DateTimeOffset.UtcNow;
    private DateTimeOffset _checkedAt = DateTimeOffset.UtcNow;

    protected override async Task OnInitializedAsync()
    {
        _report = await HealthChecks.CheckHealthAsync().ConfigureAwait(false);
        _checkedAt = DateTimeOffset.UtcNow;
    }

    private static string StatusClass(HealthStatus status) => status switch
    {
        HealthStatus.Healthy => "is-ok",
        HealthStatus.Degraded => "is-warn",
        _ => "is-bad"
    };
}
