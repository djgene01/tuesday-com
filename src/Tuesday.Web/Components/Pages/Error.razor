@page "/Error"
@using System.Diagnostics

<PageTitle>Error</PageTitle>

<main class="mx-auto max-w-[640px] py-10">
    <div class="ui-card px-6 py-12 text-center">
        <span class="ui-pill bg-status-stuck/10 text-status-stuck">Error</span>
        <h1 class="mt-3 font-display text-[24px] font-semibold tracking-tight text-ink">Something went wrong</h1>
        <p class="mx-auto mt-1 max-w-sm text-sm text-ink-soft">An error occurred while processing your request.</p>

        @if (ShowRequestId)
        {
            <p class="mt-4 text-[11px] text-ink-faint">Request ID: <code class="rounded bg-canvas px-1 py-0.5">@RequestId</code></p>
        }

        <a class="ui-btn-primary mt-6" href="/">Back to the start</a>
    </div>
</main>
@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
