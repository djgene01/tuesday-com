@page "/Error"
@using System.Diagnostics

<PageTitle>Error — Tuesday.com</PageTitle>

<div class="mx-auto max-w-[640px] py-10">
    <EmptyState Title="Something went wrong" Code="Error" Heading="true">
        <ChildContent>
            <p class="m-0">An error occurred while processing your request.</p>
            @if (ShowRequestId)
            {
                <p class="m-0 mt-3 text-xs">Request ID: <code class="rounded bg-surface-2 px-1 py-0.5 text-ink">@RequestId</code></p>
            }
        </ChildContent>
        <Actions>
            <Button Href="/">Back to the start</Button>
        </Actions>
    </EmptyState>
</div>
@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
