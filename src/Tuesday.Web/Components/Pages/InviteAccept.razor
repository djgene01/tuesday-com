@page "/invite/{Token}"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using Tuesday.Infrastructure.Identity
@using Microsoft.EntityFrameworkCore
@using Tuesday.Domain.Tenancy
@using Tuesday.Infrastructure.Persistence
@attribute [AllowAnonymous]
@inject TuesdayDbContext Db
@inject UserManager<ApplicationUser> Users

<PageTitle>Accept your invitation — Tuesday.com</PageTitle>

@{
    var state = _done ? "done" : _error is null ? (_invite is null ? "invalid" : "form") : "error";
}

<div class="mx-auto max-w-[440px] py-10">
    <div class="ui-card p-6 shadow-card">
        @if (state == "done")
        {
            <span class="mb-3 grid h-10 w-10 place-items-center rounded-full bg-ok-bg text-ok" aria-hidden="true">
                <Icon Name="IconName.Check" Class="h-5 w-5" />
            </span>
            <h1 class="m-0 font-display text-xl font-semibold tracking-tight text-ink">You're in</h1>
            <p class="m-0 mt-2 text-sm text-ink-soft">
                Your password is set. Sign in with <span class="font-medium text-ink">@_invite?.Email</span>.
            </p>
            <Button Href="/login" Size="ButtonSize.Lg" Class="mt-5">Sign in</Button>
        }
        else if (_invite is null || state == "invalid")
        {
            <span class="mb-3 grid h-10 w-10 place-items-center rounded-full bg-surface-2 text-ink-soft ring-1 ring-inset ring-line" aria-hidden="true">
                <Icon Name="IconName.Clock" Class="h-5 w-5" />
            </span>
            <h1 class="m-0 font-display text-xl font-semibold tracking-tight text-ink">Invitation not valid</h1>
            <p class="m-0 mt-2 text-sm text-ink-soft">
                This link has already been used, has expired, or was never issued. Ask an administrator
                for a new invitation.
            </p>
            <Button Href="/login" Variant="ButtonVariant.Ghost" Size="ButtonSize.Lg" Class="mt-5">Back to sign in</Button>
        }
        else
        {
            <p class="m-0 text-2xs font-semibold uppercase tracking-[0.12em] text-brand-ink">Invitation</p>
            <h1 class="m-0 mt-1 font-display text-xl font-semibold tracking-tight text-ink">Choose a password</h1>
            <p class="m-0 mt-2 text-sm text-ink-soft">
                For <span class="font-medium text-ink">@_invite.Email</span>. The link works once and expires
                @_invite.ExpiresAt.ToLocalTime().ToString("dd MMM yyyy").
            </p>

            <EditForm Model="Input" FormName="accept-invite" OnValidSubmit="AcceptAsync" class="mt-5 space-y-4">
                <DataAnnotationsValidator />

                <Field Label="Password" Hint="At least 8 characters, with an uppercase letter, a lowercase letter, a digit and a symbol.">
                    <InputText type="password" @bind-Value="Input.Password" autocomplete="new-password" required class="ui-input ui-input-lg" />
                    <ValidationMessage For="() => Input.Password" />
                </Field>

                <Field Label="Confirm password">
                    <InputText type="password" @bind-Value="Input.Confirm" autocomplete="new-password" required class="ui-input ui-input-lg" />
                    <ValidationMessage For="() => Input.Confirm" />
                </Field>

                @if (_error is not null)
                {
                    <Alert Kind="AlertKind.Error">@_error</Alert>
                }

                <Button Type="submit" Size="ButtonSize.Lg" Block="true" Busy="_busy">Set password</Button>
            </EditForm>
        }
    </div>
</div>

@code {
    [Parameter]
    public string Token { get; set; } = string.Empty;

    private Invite? _invite;
    private ApplicationUser? _user;
    private string? _error;
    private bool _done;
    private bool _busy;

    public InputModel Input { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        if (!InviteToken.LooksWellFormed(Token))
        {
            return;
        }

        var hash = InviteToken.HashOf(Token);

        // The page runs before a tenant is resolved, so the filter is bypassed deliberately:
        // possession of the token is the authorisation.
        _invite = await Db.Invites.IgnoreQueryFilters().FirstOrDefaultAsync(invite => invite.TokenHash == hash);

        if (_invite is null || !_invite.IsUsable())
        {
            _invite = null;
            return;
        }

        _user = await Users.FindByEmailAsync(_invite.Email);

        if (_user is null)
        {
            _invite = null;
        }
    }

    private async Task AcceptAsync()
    {
        if (_invite is null || _user is null)
        {
            return;
        }

        _error = null;
        _busy = true;

        try
        {
            // The account was created at invite time with a password nobody knows; replace it.
            await Users.RemovePasswordAsync(_user);
            var added = await Users.AddPasswordAsync(_user, Input.Password);

            if (!added.Succeeded)
            {
                await Users.AddPasswordAsync(_user, Guid.NewGuid().ToString("N") + "!Aa1");
                _error = string.Join(" ", added.Errors.Select(error => error.Description));
                return;
            }

            if (!_invite.Accept(_user.Id))
            {
                _error = "This invitation was already used. Ask an administrator for a new one.";
                return;
            }

            await Db.SaveChangesAsync();
            _done = true;
        }
        finally
        {
            _busy = false;
        }
    }

    public sealed class InputModel
    {
        [Required]
        [MinLength(8, ErrorMessage = "Use at least 8 characters.")]
        public string Password { get; set; } = string.Empty;

        [Required]
        [Compare(nameof(Password), ErrorMessage = "The two passwords do not match.")]
        public string Confirm { get; set; } = string.Empty;
    }
}
