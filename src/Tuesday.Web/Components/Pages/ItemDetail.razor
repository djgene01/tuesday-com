@page "/board/{BoardId:guid}/item/{ItemId:guid}"
@using Tuesday.Web.Components.Board
@using Microsoft.AspNetCore.Authorization
@using Tuesday.Application.Boards
@using Tuesday.Application.Tenancy
@using Tuesday.Infrastructure.Queries
@using Tuesday.Web.Components.Collaboration
@attribute [Authorize(Policy = "capability:ViewWorkspace")]
@inject WorkspaceQueries Boards
@inject BoardQueries Queries
@inject ITenantContext Tenant
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>@(_item?.Name ?? "Not found") — Tuesday.com</PageTitle>

@if (_board is null || _item is null)
{
    <main class="mx-auto max-w-[900px]">
        <div class="ui-card px-6 py-14 text-center">
            <p class="font-display text-lg font-semibold text-ink">Item not found</p>
            <p class="mt-1 text-sm text-ink-soft">Either it does not exist, or it is not shared with you.</p>
            <a class="ui-btn-primary mt-5" href="/workspace">Back to your workspace</a>
        </div>
    </main>
}
else
{
    <main class="mx-auto max-w-[900px]">
        <nav class="mb-1 flex items-center gap-1.5 text-xs text-ink-soft" aria-label="Breadcrumb">
            <a class="hover:text-brand" href="/board/@BoardId">@_board.Name</a>
            <span aria-hidden="true">/</span>
            <span class="text-ink-faint">@_group?.Title</span>
        </nav>

        <div class="mb-4 flex flex-wrap items-center gap-3">
            <h1 class="font-display text-[26px] font-semibold leading-tight tracking-tight text-ink">@_item.Name</h1>
            @if (!(_card?.CanEdit ?? false))
            {
                <span class="ui-pill border border-line bg-canvas text-ink-soft">Read-only</span>
            }
            <a class="ui-btn-ghost ml-auto !h-9 !px-4 text-[13px]" href="/board/@BoardId">Back to board</a>
        </div>

        <section class="ui-card mb-4 divide-y divide-line" aria-label="Item values">
            @foreach (var column in _board.Columns)
            {
                <div class="flex items-baseline gap-4 px-4 py-2.5">
                    <span class="w-[180px] shrink-0 text-[11px] font-semibold uppercase tracking-[0.06em] text-ink-soft">@column.Title</span>
                    <span class="text-sm text-ink">@ValueOf(column.Id)</span>
                </div>
            }
        </section>

        <SubItemsPanel BoardId="BoardId" ItemId="ItemId" CanEdit="@(_card?.CanEdit ?? false)" @rendermode="InteractiveServer" />

        <UpdateThread BoardId="BoardId" ItemId="ItemId" CanEdit="_card?.CanEdit ?? false" @rendermode="InteractiveServer" />

        <AttachmentPanel BoardId="BoardId" ItemId="ItemId" CanEdit="_card?.CanEdit ?? false" @rendermode="InteractiveServer" />
    </main>
}

@code {
    [Parameter]
    public Guid BoardId { get; set; }

    [Parameter]
    public Guid ItemId { get; set; }

    private BoardModel? _board;
    private GroupView? _group;
    private ItemView? _item;
    private BoardCard? _card;

    protected override async Task OnInitializedAsync()
    {
        if (Tenant.UserId is not { } userId || Tenant.Role is not { } role)
        {
            return;
        }

        _card = await Boards.FindBoardAsync(BoardId, userId, role);

        if (_card is null)
        {
            MarkNotFound();
            return;
        }

        _board = await Queries.GetAsync(BoardId);

        _group = _board?.Groups.FirstOrDefault(group => group.Items.Any(candidate => candidate.Id == ItemId));
        _item = _group?.Items.FirstOrDefault(candidate => candidate.Id == ItemId);

        if (_item is null)
        {
            MarkNotFound();
        }
    }

    /// <summary>404 without leaking existence. Applied on OnStarting so the body survives.</summary>
    private void MarkNotFound()
    {
        if (HttpContextAccessor.HttpContext is { } context)
        {
            context.Response.OnStarting(() =>
            {
                context.Response.StatusCode = StatusCodes.Status404NotFound;
                return Task.CompletedTask;
            });
        }
    }

    private string ValueOf(Guid columnId) =>
        _item is not null && _item.Cells.TryGetValue(columnId, out var value) && !string.IsNullOrWhiteSpace(value)
            ? value
            : "—";
}
