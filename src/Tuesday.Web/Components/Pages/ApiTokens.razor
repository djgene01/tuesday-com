@page "/account/tokens"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Tuesday.Application.Tenancy
@using Tuesday.Infrastructure.Automations
@using Tuesday.Web.Security
@attribute [Authorize]
@inject ApiTokenService Tokens
@inject ITenantContext Tenant
@inject TenantContextBootstrapper Bootstrapper
@inject ToastService Toasts

<PageTitle>API tokens — Tuesday.com</PageTitle>

<div class="mx-auto max-w-[820px]">
    <PageHeader Title="API tokens" Eyebrow="Your account">
        <Subtitle>
            A token calls <code class="rounded bg-surface-2 px-1 py-0.5 text-xs text-ink">/api/v1</code> as you.
            It is shown once, stored hashed, and can be revoked here at any time.
        </Subtitle>
    </PageHeader>

    <section class="ui-card p-5" aria-labelledby="new-token-title">
        <h2 id="new-token-title" class="ui-card-title">Create a token</h2>
        <form class="mt-3 flex flex-wrap items-start gap-3" @onsubmit="IssueAsync" @onsubmit:preventDefault>
            <Field Label="Token name" For="token-name" Hint="Requests are limited to 120 per minute per token." Class="min-w-[14rem] flex-1">
                <input id="token-name" type="text" @bind="_name" @bind:event="oninput" placeholder="e.g. CI import"
                       aria-describedby="@Field.DescribedBy("token-name")" class="ui-input" maxlength="100" />
            </Field>
            <Button Type="submit" Class="sm:mt-5" IconStart="IconName.Plus" Busy="_issuing"
                    Disabled="@(string.IsNullOrWhiteSpace(_name) || _busy)">Create token</Button>
        </form>
    </section>

    @if (_issued is not null)
    {
        <Alert Kind="AlertKind.Success" Title="Copy it now — it is not shown again." Class="mt-4">
            <code class="mt-1.5 block select-all break-all rounded bg-surface px-2 py-1.5 text-xs text-ink ring-1 ring-inset ring-ok/20">@_issued</code>
        </Alert>
    }

    @if (_error is not null)
    {
        <Alert Kind="AlertKind.Error" Class="mt-4">@_error</Alert>
    }

    <section class="mt-6" aria-labelledby="tokens-title">
        <h2 id="tokens-title" class="ui-section-title mb-2">Your tokens</h2>

        @if (_rows is null)
        {
            <div class="ui-card p-4"><Skeleton Lines="3" /></div>
        }
        else if (_rows.Count == 0)
        {
            <EmptyState Title="No tokens yet" IconName="IconName.Key" Compact="true">
                Create one above to call the API from a script, a CI job or the MCP server.
            </EmptyState>
        }
        else
        {
            <ul class="ui-card m-0 list-none divide-y divide-line overflow-hidden p-0">
                @foreach (var row in _rows)
                {
                    <li class="flex flex-wrap items-center gap-x-3 gap-y-1 px-4 py-3">
                        <Icon Name="IconName.Key" Class="h-4 w-4 shrink-0 text-ink-soft" />
                        <span class="text-sm font-medium text-ink">@row.Name</span>
                        <code class="text-xs text-ink-soft">@row.Prefix…</code>
                        <span class="ui-pill @(row.IsActive ? "ui-pill-ok" : "ui-pill-neutral")">@(row.IsActive ? "Active" : "Revoked")</span>
                        <span class="text-xs text-ink-soft">Created @row.CreatedAt.ToLocalTime().ToString("d MMM yyyy")</span>
                        @if (row.IsActive)
                        {
                            <Button Variant="ButtonVariant.QuietDanger" Size="ButtonSize.Sm" Class="ml-auto"
                                    aria-label="@($"Revoke token {row.Name}")"
                                    Disabled="_busy" @onclick="() => AskRevokeAsync(row)">Revoke</Button>
                        }
                    </li>
                }
            </ul>
        }
    </section>
</div>

<ConfirmDialog @ref="_confirm" Title="Revoke this token?" ConfirmLabel="Revoke token" OnConfirm="RevokeAsync">
    <p class="m-0">
        <span class="font-medium text-ink">@_pending?.Name</span> stops working immediately. Any script or
        integration using it will start getting 401 responses. This cannot be undone.
    </p>
</ConfirmDialog>

@code {
    private IReadOnlyList<ApiTokenRow>? _rows;
    private string _name = string.Empty;
    private string? _issued;
    private string? _error;
    private bool _busy;
    private bool _issuing;
    private ConfirmDialog? _confirm;
    private ApiTokenRow? _pending;

    protected override async Task OnInitializedAsync()
    {
        await Bootstrapper.EnsureResolvedAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _rows = Tenant.UserId is { } userId ? await Tokens.ListAsync(userId) : [];
    }

    private async Task IssueAsync()
    {
        if (string.IsNullOrWhiteSpace(_name) || _busy)
        {
            return;
        }

        if (Tenant.UserId is not { } userId || Tenant.TenantId is not { } tenantId)
        {
            _error = "Your session has no tenant identity.";
            return;
        }

        _busy = true;
        _issuing = true;
        _error = null;

        try
        {
            var name = _name.Trim();
            var (plaintext, _) = await Tokens.IssueAsync(tenantId, userId, name);
            _issued = plaintext;
            _name = string.Empty;
            await LoadAsync();
            Toasts.Success($"Token \"{name}\" created.");
        }
        finally
        {
            _busy = false;
            _issuing = false;
        }
    }

    private async Task AskRevokeAsync(ApiTokenRow row)
    {
        _pending = row;

        if (_confirm is not null)
        {
            await _confirm.OpenAsync();
        }
    }

    private async Task RevokeAsync()
    {
        if (Tenant.UserId is not { } userId || _pending is not { } row)
        {
            return;
        }

        _busy = true;
        try
        {
            await Tokens.RevokeAsync(userId, row.Id);
            await LoadAsync();
            Toasts.Success($"Token \"{row.Name}\" revoked.");
        }
        finally
        {
            _busy = false;
            _pending = null;
        }
    }
}
